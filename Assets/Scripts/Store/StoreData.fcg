import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Convert.fcc" as convert

import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph StoreData {
    
    _ItemIDs List<string> = nil
    _ItemAmounts List<int> = nil
    _NextResetTime float = 0.0

    event OnAwake() {
        _ItemIDs = list.New(0, 10) as List<string>
        _ItemAmounts = list.New(0, 10) as List<int>
        if debugCfg.Store() { LogInfo("[StoreData] Initialized (empty, waiting for StoreManager refresh)") }
    }

    func ClearStore() {
        list.Clear(_ItemIDs)
        list.Clear(_ItemAmounts)
        if debugCfg.Store() { LogInfo("[StoreData] ClearStore: kho da xoa sach") }
    }
}
