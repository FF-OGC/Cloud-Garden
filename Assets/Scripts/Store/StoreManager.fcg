import "StdLibrary.fcc" as std
import "Player.fcc" as playerLib
import "Convert.fcc" as convert
import "List.fcc" as list
import "EditorGenLib.fcc" as gen

import "../Services/StoreService.fcg" as storeService
import "./StoreData.fcg" as storeData
import "../Backpack/BackpackManager.fcg" as backpackManager
import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg
import "../Currency/CurrencyManager.fcg" as currencyManager
import "../Config/StoreConfig.fcg" as storeCfg

[platform_server]
static graph StoreManager {

    _IsRestockStarted bool = false

    func InitRestock() {
        if _IsRestockStarted { return }
        _IsRestockStarted = true
        if debugCfg.Store() { LogInfo("[StoreManager] InitRestock -> starting RestockLoop") }
        start RestockLoop()
    }

    async func RestockLoop() {
        while true {
            storeData.ClearStore()

            var currentTime = gameManager.GetGameTime()
            storeService.RefreshStore(currentTime)

            var cycleSec = storeCfg.GetRestockCycleSeconds()
            storeData._NextResetTime = currentTime + (cycleSec as float)

            if debugCfg.Store() { LogInfo("[StoreManager] Restock DONE | nextReset=" + convert.ToString(storeData._NextResetTime) + " cycle=" + convert.ToString(cycleSec) + "s") }

            BroadcastStoreDataToAllPlayers()

            WaitForMillisecond(cycleSec * 1000)
        }
    }

    func BroadcastStoreDataToAllPlayers() {
        var players = gameManager.GetConnectedPlayers()
        if players == nil { return }
        var count = list.Length(players)
        for i = 0, count, 1 {
            var p = players[i] as entity<Player>
            if p != nil { SyncStoreDataToPlayer(p) }
        }
        if debugCfg.Store() { LogInfo("[StoreManager] BroadcastStoreDataToAllPlayers: synced " + convert.ToString(count) + " players") }
    }

    event OnPlayerEnterStore(player entity<Player>) {
        if debugCfg.Store() { LogInfo("[StoreManager] OnPlayerEnterStore") }
        SyncStoreDataToPlayer(player)
        DispatchEventToEntity(OnPlayerEnterStore, player, PlatformType.Server, List<object>{player})
    }

    event OnPlayerExitStore(player entity<Player>) {
        if debugCfg.Store() { LogInfo("[StoreManager] OnPlayerExitStore") }
        DispatchEventToEntity(OnPlayerExitStore, player, PlatformType.Server, List<object>{player})
    }

    event OnPlayerToggleStore(player entity<Player>) {
        if debugCfg.Store() { LogInfo("[StoreManager] OnPlayerToggleStore") }
        DispatchEventToEntity(OnPlayerToggleStore, player, PlatformType.Server, List<object>{player})
    }

    event OnRequestBuyItem(player entity<Player>, itemId string, amount int, slotIndex int) {
        if debugCfg.Store() { LogInfo("[StoreManager] OnRequestBuyItem | player=" + player<Entity>.Name + " itemId=" + itemId + " amount=" + convert.ToString(amount) + " slot=" + convert.ToString(slotIndex)) }
        if player == nil || amount <= 0 { return }
    
        // 1. Check if the store has enough stock in the slot
        if !storeService.CanBuyFromSlot(slotIndex, itemId, amount) {
            if debugCfg.Store() { LogInfo("[StoreManager] FAILED: Not enough stock in slot " + convert.ToString(slotIndex)) }
            DispatchEventToEntity(OnBuyItemResponse, player, PlatformType.Server, List<object>{player, false, "Not enough stock!", nil, nil})
            return
        }
    
        // 2. Deduct the price immediately to prevent spam!
        // The ProcessItemPurchase function will check and deduct the price immediately. If it fails, it means the player has no money.
        if !currencyManager.ProcessItemPurchase(player, itemId, amount) {
            if debugCfg.Store() { LogInfo("[StoreManager] FAILED: Not enough gold") }
            DispatchEventToEntity(OnBuyItemResponse, player, PlatformType.Server, List<object>{player, false, "Not enough gold!", nil, nil})
            return
        }
    
        // 3. Deduct the stock from the store shelf
        storeService.ExecuteBuyFromSlot(slotIndex, itemId, amount)
    
        // 4. Add the item to the player's inventory
        if !backpackManager.AddItem(player, itemId, amount) {
            if debugCfg.Store() { LogInfo("[StoreManager] FAILED: Backpack full") }
            
            // ROLLBACK: If the inventory is full, we need to refund the money and restore the stock!
            currencyManager.RefundItemPurchase(player, itemId, amount)
            storeService.RestoreStock(slotIndex, itemId, amount)
            
            DispatchEventToEntity(OnBuyItemResponse, player, PlatformType.Server, List<object>{player, false, "Backpack is full!", nil, nil})
            return
        }
    
        // 5. Everything is successful
        if debugCfg.Store() { LogInfo("[StoreManager] SUCCESS: Bought " + convert.ToString(amount) + "x " + itemId) }
        DispatchEventToEntity(OnBuyItemResponse, player, PlatformType.Server, List<object>{player, true, "Purchase successful!", storeData._ItemIDs, storeData._ItemAmounts})
    
        BroadcastStoreDataToAll(player)
    }

    func SyncStoreDataToPlayer(player entity<Player>) {
        if player == nil { return }
        if debugCfg.Store() { LogInfo("[StoreManager] SyncStoreDataToPlayer | items=" + convert.ToString(list.Length(storeData._ItemIDs)) + " nextReset=" + convert.ToString(storeData._NextResetTime)) }
        DispatchEventToEntity(OnSyncStoreData, player, PlatformType.Server, List<object>{player, storeData._ItemIDs, storeData._ItemAmounts, storeData._NextResetTime})
    }

    func BroadcastStoreDataToAll(excludePlayer entity<Player>) {
        var players = gameManager.GetConnectedPlayers()
        if players == nil { return }
        var count = list.Length(players)
        for i = 0, count, 1 {
            var p = players[i] as entity<Player>
            if p != nil && p != excludePlayer {
                SyncStoreDataToPlayer(p)
            }
        }
    }
}
