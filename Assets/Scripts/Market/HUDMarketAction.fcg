import "StdLibrary.fcc" as std
import "Hud.fcc" as hud
import "EditorGenLib.fcc" as gen
import "Convert.fcc" as convert

import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg
import "./MarketRuntimeData.fcg" as marketData

[platform_server]
graph HUDMarketAction {

    _SellBtnUI entity<CustomUI>
    _IsInZone bool = false
    _CurrentMarket entity<Entity> = nil

    event OnAwake() {
        if debugCfg.Market() { LogInfo("[HUDMarketAction] OnAwake START | player=" + convert.ToString(thisEntity<Player> != nil)) }
        CreateCustomUI(out var btnInstance, thisEntity<Player>, EResUI.market_sell_btn)
        if btnInstance != nil {
            _SellBtnUI = btnInstance
            _SellBtnUI<CustomUI>.IsVisible = false
            if debugCfg.Market() { LogInfo("[HUDMarketAction] Sell button UI created OK, hidden") }
        } else {
            if debugCfg.Market() { LogError("[HUDMarketAction] FAILED to create sell button UI!") }
        }
    }

    event OnPlayerEnterMarket(player entity<Player>, market entity<Entity>) {
        if debugCfg.Market() { LogInfo("[HUDMarketAction] OnPlayerEnterMarket FIRED | player=" + convert.ToString(player != nil) + " market=" + convert.ToString(market != nil) + " isMe=" + convert.ToString(player == thisEntity<Player>)) }
        if player != thisEntity<Player> { return }

        if market<marketData> == nil || market<marketData>._Owner == nil || market<marketData>._Owner != player {
            if debugCfg.Market() { LogInfo("[HUDMarketAction] SKIP: player is NOT the owner of this market stall") }
            return
        }

        _IsInZone = true
        _CurrentMarket = market
        if _SellBtnUI != nil {
            _SellBtnUI<CustomUI>.IsVisible = true
            if debugCfg.Market() { LogInfo("[HUDMarketAction] Sell button SHOWN") }
        } else {
            if debugCfg.Market() { LogWarning("[HUDMarketAction] _SellBtnUI is nil, cannot show!") }
        }
    }

    event OnPlayerExitMarket(player entity<Player>, market entity<Entity>) {
        if debugCfg.Market() { LogInfo("[HUDMarketAction] OnPlayerExitMarket FIRED") }
        if player != thisEntity<Player> { return }
        _IsInZone = false
        _CurrentMarket = nil
        if _SellBtnUI != nil {
            _SellBtnUI<CustomUI>.IsVisible = false
        }
    }

    // Market HUD uses Utils/Button.fcg + MyButton.Type: "market_sell" | "market_quicksell" (same pattern as Backpack / Store).
    event OnPlayerTapButton(button entity<UIWidgetButton>, player entity<Player>) {
        if player == nil || button == nil { return }
        if player != thisEntity<Player> { return }
        if !HasComponent(button, typeof(MyButton)) { return }

        var btnType = button<MyButton>.Type
        if btnType != "market_sell" && btnType != "market_quicksell" {
            return
        }

        if debugCfg.Market() { LogInfo("[HUDMarketAction] OnPlayerTapButton | btnType=" + btnType + " zone=" + convert.ToString(_IsInZone)) }

        if !_IsInZone || _CurrentMarket == nil {
            if debugCfg.Market() { LogWarning("[HUDMarketAction] ABORT: not in zone or no market") }
            return
        }
        if _CurrentMarket<marketData> == nil || _CurrentMarket<marketData>._Owner == nil || _CurrentMarket<marketData>._Owner != player {
            if debugCfg.Market() { LogWarning("[HUDMarketAction] ABORT: not stall owner") }
            return
        }

        if btnType == "market_sell" {
            if debugCfg.Market() { LogInfo("[HUDMarketAction] -> OnRequestRestock") }
            DispatchEventToEntity(OnRequestRestock, globalEntity, PlatformType.Server, List<object>{thisEntity<Player>, _CurrentMarket})
        }else {
            if debugCfg.Market() { LogInfo("[HUDMarketAction] -> OnRequestQuicksell") }
            DispatchEventToEntity(OnRequestQuicksell, globalEntity, PlatformType.Server, List<object>{thisEntity<Player>, _CurrentMarket})
        }
    }
}
