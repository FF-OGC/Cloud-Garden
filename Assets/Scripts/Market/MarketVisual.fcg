import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Map.fcc" as map
import "Convert.fcc" as convert
import "Math.fcc" as math

import "../Config/MarketConfig.fcg" as marketCfg
import "../Config/ItemConfig.fcg" as itemCfg
import "../Config/MutationConfig.fcg" as mutCfg
import "./MarketRuntimeData.fcg" as marketData
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph MarketVisual {

    _ProducePool Map<string, List<entity<Entity>>>

    func InitProducePool() {
        _ProducePool = map.New() as Map<string, List<entity<Entity>>>

        var items = marketCfg.GetSellableItems()
        var itemCount = list.Length(items)

        for i = 0, itemCount, 1 {
            var itemId = items[i] as string
            var poolList = list.New(0, 12) as List<entity<Entity>>

            for j = 0, 8, 1 {
                var prefab = marketCfg.GetProducePrefab(itemId)
                CreateFromPrefab(out var model, prefab)
                if model != nil {
                    model<Transform>.Position = Vector3{0, -9999, 0}
                    list.Append(poolList, model as entity<Entity>)
                }
            }

            _ProducePool[itemId] = poolList
            if debugCfg.Market() { LogInfo("[MarketVisual] InitProducePool | " + itemId + " pool size=8") }
        }
    }

    func RotateOffset(offset Vector3, angleDeg float) Vector3 {
        var c = math.Cos(angleDeg)
        var s = math.Sin(angleDeg)
        var rx = offset.X * c + offset.Z * s
        var rz = -offset.X * s + offset.Z * c
        return Vector3{rx, offset.Y, rz}
    }

    func _HasActivePair(market entity<Entity>, itemId string, mutStr string) bool {
        var n = list.Length(market<marketData>._ActiveProduceItemIDs)
        for i = 0, n, 1 {
            if market<marketData>._ActiveProduceItemIDs[i] as string != itemId { continue }
            var m = ""
            if i < list.Length(market<marketData>._ActiveProduceMutStrs) {
                m = market<marketData>._ActiveProduceMutStrs[i] as string
            }
            if m == mutStr { return true }
        }
        return false
    }

    func UpdateTableDisplay(market entity<Entity>) {
        if market == nil { return }
        if market<marketData> == nil { return }
        market<marketData>.EnsureInit()
        if market<marketData>._ActiveProduceMutStrs == nil {
            market<marketData>._ActiveProduceMutStrs = List<string>{}
        }
        var nActIds = list.Length(market<marketData>._ActiveProduceItemIDs)
        var nMutPad = list.Length(market<marketData>._ActiveProduceMutStrs)
        while nMutPad < nActIds {
            list.Append(market<marketData>._ActiveProduceMutStrs, "")
            nMutPad = nMutPad + 1
        }

        var marketPos = market<Transform>.Position
        var rotY = market<Transform>.Rotation.Y

        var desiredItemIds = List<string>{}
        var desiredMutStrs = List<string>{}
        var tCount = list.Length(market<marketData>._TableItemIDs)
        for t = 0, tCount, 1 {
            var amt = market<marketData>._TableItemAmounts[t] as int
            if amt <= 0 { continue }
            var itemId = market<marketData>._TableItemIDs[t] as string
            if !marketCfg.IsSellable(itemId) { continue }
            var mutStr = ""
            if t < list.Length(market<marketData>._TableMutations) {
                mutStr = market<marketData>._TableMutations[t] as string
            }
            list.Append(desiredItemIds, itemId)
            list.Append(desiredMutStrs, mutStr)
        }

        var ac = list.Length(market<marketData>._ActiveProduceItemIDs)
        var ai = ac - 1
        while ai >= 0 {
            var aid = market<marketData>._ActiveProduceItemIDs[ai] as string
            var amut = ""
            if ai < list.Length(market<marketData>._ActiveProduceMutStrs) {
                amut = market<marketData>._ActiveProduceMutStrs[ai] as string
            }
            var stillWant = false
            var diLen = list.Length(desiredItemIds)
            for k = 0, diLen, 1 {
                if desiredItemIds[k] as string == aid && desiredMutStrs[k] as string == amut {
                    stillWant = true
                    break
                }
            }
            if !stillWant {
                var mdl = market<marketData>._ActiveProduceModels[ai] as entity<Entity>
                ReturnModelToPool(aid, mdl)
                list.RemoveAt(market<marketData>._ActiveProduceModels, ai)
                list.RemoveAt(market<marketData>._ActiveProduceItemIDs, ai)
                list.RemoveAt(market<marketData>._ActiveProduceMutStrs, ai)
                if debugCfg.Market() { LogInfo("[MarketVisual] HIDE " + aid + " mut=" + amut) }
            }
            ai = ai - 1
        }

        var wantLen = list.Length(desiredItemIds)
        for d = 0, wantLen, 1 {
            var wItem = desiredItemIds[d] as string
            var wMut = desiredMutStrs[d] as string
            if _HasActivePair(market, wItem, wMut) { continue }

            var model = GetModelFromPool(wItem)
            if model == nil { continue }

            var sellIdx = -1
            var sellItems = marketCfg.GetSellableItems()
            for si = 0, list.Length(sellItems), 1 {
                if sellItems[si] as string == wItem {
                    sellIdx = si
                    break
                }
            }
            if sellIdx < 0 { continue }

            var gSize = 0
            for g = 0, wantLen, 1 {
                if desiredItemIds[g] as string == wItem { gSize = gSize + 1 }
            }
            var slotInGroup = 0
            for g = 0, d, 1 {
                if desiredItemIds[g] as string == wItem { slotInGroup = slotInGroup + 1 }
            }

            var baseOff = marketCfg.GetTableItemOffset(sellIdx)
            var spread = marketCfg.GetMutationSpreadOffset(slotInGroup, gSize)
            var combined = Vector3{baseOff.X + spread.X, baseOff.Y + spread.Y, baseOff.Z + spread.Z}
            var offset = RotateOffset(combined, rotY)
            model<Transform>.Position = Vector3{marketPos.X + offset.X, marketPos.Y + offset.Y, marketPos.Z + offset.Z}

            list.Append(market<marketData>._ActiveProduceItemIDs, wItem)
            list.Append(market<marketData>._ActiveProduceMutStrs, wMut)
            list.Append(market<marketData>._ActiveProduceModels, model)

            _ApplyMutationMaterialToModel(model, wMut)
            if debugCfg.Market() { LogInfo("[MarketVisual] SHOW " + wItem + " mut=" + wMut) }
        }
    }

    func _ApplyMutationMaterialToModel(model entity<Entity>, mutStr string) {
        var prefixId = itemCfg.ParseMutationPrefix(mutStr)
        var matId = mutCfg.GetMutationMaterialId(prefixId)
        var matList = list.New(0, 1) as List<MaterialID>
        list.Append(matList, matId)
        model<CustomRender>.MaterialIDList = matList
        if debugCfg.Mutation() { LogInfo("[MUTATION-MARKET] material | mutStr=" + mutStr + " prefixId=" + convert.ToString(prefixId)) }
    }

    func GetModelFromPool(itemId string) entity<Entity> {
        if !map.ContainKey(_ProducePool, itemId) { return nil }

        var poolList = _ProducePool[itemId] as List<entity<Entity>>
        var count = list.Length(poolList)
        if count > 0 {
            var model = poolList[count - 1] as entity<Entity>
            list.RemoveAt(poolList, count - 1)
            return model
        }

        var prefab = marketCfg.GetProducePrefab(itemId)
        CreateFromPrefab(out var newModel, prefab)
        return newModel
    }

    func ReturnModelToPool(itemId string, model entity<Entity>) {
        if model == nil { return }
        model<Transform>.Position = Vector3{0, -9999, 0}

        if map.ContainKey(_ProducePool, itemId) {
            var poolList = _ProducePool[itemId] as List<entity<Entity>>
            list.Append(poolList, model)
        }
    }
}
