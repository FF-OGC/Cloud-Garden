import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Map.fcc" as map
import "Convert.fcc" as convert
import "Math.fcc" as math

import "../Config/MarketConfig.fcg" as marketCfg
import "../Config/ItemConfig.fcg" as itemCfg
import "../Config/MutationConfig.fcg" as mutCfg
import "./MarketRuntimeData.fcg" as marketData
import "../Services/MarketService.fcg" as marketService
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph MarketVisual {

    _ProducePool Map<string, List<entity<Entity>>>

    func InitProducePool() {
        _ProducePool = map.New() as Map<string, List<entity<Entity>>>

        var items = marketCfg.GetSellableItems()
        var itemCount = list.Length(items)

        for i = 0, itemCount, 1 {
            var itemId = items[i] as string
            var poolList = list.New(0, 12) as List<entity<Entity>>

            for j = 0, 8, 1 {
                var prefab = marketCfg.GetProducePrefab(itemId)
                CreateFromPrefab(out var model, prefab)
                if model != nil {
                    model<Transform>.Position = Vector3{0, -9999, 0}
                    list.Append(poolList, model as entity<Entity>)
                }
            }

            _ProducePool[itemId] = poolList
            if debugCfg.Market() { LogInfo("[MarketVisual] InitProducePool | " + itemId + " pool size=8") }
        }
    }

    func RotateOffset(offset Vector3, angleDeg float) Vector3 {
        var c = math.Cos(angleDeg)
        var s = math.Sin(angleDeg)
        var rx = offset.X * c + offset.Z * s
        var rz = -offset.X * s + offset.Z * c
        return Vector3{rx, offset.Y, rz}
    }

    func AddWorld3(a Vector3, b Vector3) Vector3 {
        return Vector3{a.X + b.X, a.Y + b.Y, a.Z + b.Z}
    }

    // Show only SlotVisualAnchor markers allowed for current stall level; hide the rest.
    func SyncTableAnchorMarkersVisibility(market entity<Entity>) {
        if market == nil || market<marketData> == nil { return }
        market<marketData>.EnsureInit()
        var stallLv = marketService.GetStallLevel(market) as int
        var anchors = market<marketData>._TableVisualAnchors
        if anchors == nil { return }
        var n = list.Length(anchors) as int
        for ai = 0, n, 1 {
            var ent = anchors[ai] as entity<Entity>
            if ent == nil { continue }
            var show = marketCfg.IsSlotVisualAnchorUnlockedForStallLevel(stallLv, ai) as bool
            ent<Entity>.ActiveSelf = show
        }
    }

    // One prefab per fixed table slot (0..4). Empty slots stay empty; no sliding between slots.
    func UpdateTableDisplay(market entity<Entity>) {
        if market == nil { return }
        if market<marketData> == nil { return }
        market<marketData>.EnsureInit()
        SyncTableAnchorMarkersVisibility(market)

        if market<marketData>._TableSlotProduceModels == nil || list.Length(market<marketData>._TableSlotProduceModels) < 5 {
            return
        }
        if market<marketData>._TableSlotProducePoolKeys == nil || list.Length(market<marketData>._TableSlotProducePoolKeys) < 5 {
            return
        }

        var marketPos = market<Transform>.Position
        var rotY = market<Transform>.Rotation.Y
        var stallLv = marketService.GetStallLevel(market) as int
        var cap = marketCfg.GetTableStackCapacityForStallLevel(stallLv) as int

        for slot = 0, 5, 1 {
            var itemId = market<marketData>._TableItemIDs[slot] as string
            var amt = market<marketData>._TableItemAmounts[slot] as int
            var mutStr = ""
            if slot < list.Length(market<marketData>._TableMutations) {
                mutStr = market<marketData>._TableMutations[slot] as string
            }

            var mdl = market<marketData>._TableSlotProduceModels[slot] as entity<Entity>
            var poolKey = market<marketData>._TableSlotProducePoolKeys[slot] as string

            if slot >= cap {
                if mdl != nil {
                    var rk = poolKey
                    if rk == "" { rk = itemId }
                    if rk != "" {
                        ReturnModelToPool(rk, mdl)
                    }
                    market<marketData>._TableSlotProduceModels[slot] = nil
                    market<marketData>._TableSlotProducePoolKeys[slot] = "" as string
                    if debugCfg.Market() { LogInfo("[MarketVisual] CLEAR slot=" + convert.ToString(slot) + " (above stall cap)") }
                }
                continue
            }

            if amt <= 0 || itemId == "" || !marketCfg.IsSellable(itemId) {
                if mdl != nil {
                    var rk = poolKey
                    if rk == "" { rk = itemId }
                    if rk != "" {
                        ReturnModelToPool(rk, mdl)
                    }
                    market<marketData>._TableSlotProduceModels[slot] = nil
                    market<marketData>._TableSlotProducePoolKeys[slot] = "" as string
                    if debugCfg.Market() { LogInfo("[MarketVisual] CLEAR slot=" + convert.ToString(slot)) }
                }
                continue
            }

            if mdl == nil {
                mdl = GetModelFromPool(itemId)
                if mdl == nil { continue }
                market<marketData>._TableSlotProduceModels[slot] = mdl
                market<marketData>._TableSlotProducePoolKeys[slot] = itemId as string
                if debugCfg.Market() { LogInfo("[MarketVisual] SHOW slot=" + convert.ToString(slot) + " " + itemId + " mut=" + mutStr) }
            } else {
                if poolKey != itemId {
                    var oldKey = poolKey
                    if oldKey == "" { oldKey = itemId }
                    ReturnModelToPool(oldKey, mdl)
                    mdl = GetModelFromPool(itemId)
                    if mdl == nil { continue }
                    market<marketData>._TableSlotProduceModels[slot] = mdl
                    market<marketData>._TableSlotProducePoolKeys[slot] = itemId as string
                }
            }

            mdl = market<marketData>._TableSlotProduceModels[slot] as entity<Entity>
            if mdl == nil { continue }

            var anchorIdx = marketCfg.GetTableVisualAnchorIndexForLogicalSlot(stallLv, slot) as int
            if anchorIdx < 0 { anchorIdx = slot }

            var anchors = market<marketData>._TableVisualAnchors
            var placed = false
            if anchors != nil && anchorIdx >= 0 && anchorIdx < list.Length(anchors) {
                var anEnt = anchors[anchorIdx] as entity<Entity>
                if anEnt != nil {
                    var ap = anEnt<Transform>.Position
                    var nudge = marketCfg.GetTableProduceNudgeForAnchor(anchorIdx)
                    var nudgeW = RotateOffset(nudge, rotY)
                    mdl<Transform>.Position = AddWorld3(ap, nudgeW)
                    placed = true
                }
            }
            if !placed {
                var baseOff = marketCfg.GetTableSlotOffset(anchorIdx)
                var offset = RotateOffset(baseOff, rotY)
                mdl<Transform>.Position = Vector3{marketPos.X + offset.X, marketPos.Y + offset.Y, marketPos.Z + offset.Z}
            }

            _ApplyMutationMaterialToModel(mdl, mutStr)
        }
    }

    func _ApplyMutationMaterialToModel(model entity<Entity>, mutStr string) {
        var prefixId = itemCfg.ParseMutationPrefix(mutStr)
        var matId = mutCfg.GetMutationMaterialId(prefixId)
        var matList = list.New(0, 1) as List<MaterialID>
        list.Append(matList, matId)
        model<CustomRender>.MaterialIDList = matList
        if debugCfg.Mutation() { LogInfo("[MUTATION-MARKET] material | mutStr=" + mutStr + " prefixId=" + convert.ToString(prefixId)) }
    }

    func GetModelFromPool(itemId string) entity<Entity> {
        if !map.ContainKey(_ProducePool, itemId) { return nil }

        var poolList = _ProducePool[itemId] as List<entity<Entity>>
        var count = list.Length(poolList)
        if count > 0 {
            var model = poolList[count - 1] as entity<Entity>
            list.RemoveAt(poolList, count - 1)
            return model
        }

        var prefab = marketCfg.GetProducePrefab(itemId)
        CreateFromPrefab(out var newModel, prefab)
        return newModel
    }

    func ReturnModelToPool(itemId string, model entity<Entity>) {
        if model == nil { return }
        model<Transform>.Position = Vector3{0, -9999, 0}

        if map.ContainKey(_ProducePool, itemId) {
            var poolList = _ProducePool[itemId] as List<entity<Entity>>
            list.Append(poolList, model)
        }
    }
}
