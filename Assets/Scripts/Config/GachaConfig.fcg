import "StdLibrary.fcc" as std

static graph GachaConfig {

    func GetBaseRate(gachaId string) int {
        if gachaId == "gacha_lucky_dirt" { return 5 }
        return 1
    }

    func GetSoftPityThreshold(gachaId string) int {
        if gachaId == "gacha_lucky_dirt" { return 30 }
        return 50
    }

    func GetHardPityThreshold(gachaId string) int {
        if gachaId == "gacha_lucky_dirt" { return 60 }
        return 90
    }

    func GetStepRate(gachaId string) int {
        var baseRate = GetBaseRate(gachaId)
        var soft = GetSoftPityThreshold(gachaId)
        var hard = GetHardPityThreshold(gachaId)
        if hard <= soft { return 100 }
        return (100 - baseRate) / (hard - soft)
    }

    func GetKillZoneMaxBonus(gachaId string) int {
        if gachaId == "gacha_lucky_dirt" { return 5 }
        return 8
    }

    func HasGacha(gachaId string) bool {
        if gachaId == "gacha_lucky_dirt" { return true }
        return false
    }

    func GetLuckyDirtMutationBonus() int {
        return 15
    }
}
