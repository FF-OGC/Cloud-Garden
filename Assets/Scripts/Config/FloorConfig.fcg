import "StdLibrary.fcc" as std
import "List.fcc" as list

[platform_server]
static graph FloorConfig {
    
    _BaseX float = 3.0
    _BaseY float = -0.48
    _BaseZ float = -7.0
    _BaseRotY float = 0.0
    _HeightStep float = 5.0
    _AngleStep float = 60.0

    func GetBaseX() float { return _BaseX }
    func GetBaseY() float { return _BaseY }
    func GetBaseZ() float { return _BaseZ }
    func GetBaseRotY() float { return _BaseRotY }
    func GetHeightStep() float { return _HeightStep }
    func GetAngleStep() float { return _AngleStep }
}