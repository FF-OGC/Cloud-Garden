import "StdLibrary.fcc" as std
import "List.fcc" as list
import "EditorGenLib.fcc" as gen
import "Math.fcc" as math

static graph MarketConfig {

    func GetSellableItems() List<string> {
        return List<string>{"crop_apple", "crop_carrot", "crop_tomato", "crop_chili", "crop_onion"}
    }

    func IsSellable(itemId string) bool {
        var items = GetSellableItems()
        var count = list.Length(items)
        for i = 0, count, 1 {
            if items[i] as string == itemId { return true }
        }
        return false
    }

    // One fixed duration per customer visit: same whether they buy 1 unit or max for their stall level.
    // Higher stall level → larger min/max order size elsewhere → faster stock drain without longer waits here.
    func GetTransactionDurationMs() int {
        return 3000
    }

    func GetQueueSize() int { return 5 }

    func GetQueueSlotOffset(slotIndex int) Vector3 {
        if slotIndex == 0 { return Vector3{0, 0, -2} }
        if slotIndex == 1 { return Vector3{0, 0, -4} }
        if slotIndex == 2 { return Vector3{0, 0, -6} }
        if slotIndex == 3 { return Vector3{0, 0, -8} }
        if slotIndex == 4 { return Vector3{0, 0, -10} }
        return Vector3{0, 0, -12}
    }

    func GetGateOffset() Vector3 {
        return Vector3{0, 0, -14}
    }

    // World-space offset per fixed table slot index 0..4 (not per crop type).
    func GetTableSlotOffset(slotIndex int) Vector3 {
        if slotIndex == 0 { return Vector3{-1.0, 1, 0} }
        if slotIndex == 1 { return Vector3{-0.3, 1, 0} }
        if slotIndex == 2 { return Vector3{0.4, 1, 0} }
        if slotIndex == 3 { return Vector3{1.1, 1, 0} }
        return Vector3{1.8, 1, 0}
    }

    func GetTableItemOffset(index int) Vector3 {
        return GetTableSlotOffset(index)
    }

    // Max distinct stack rows on stall table (itemId + mutation) by stall upgrade level.
    func GetTableStackCapacityForStallLevel(level int) int {
        if level <= 1 { return 3 }
        if level == 2 { return 4 }
        return 5
    }

    func GetCustomerMinAmountForStallLevel(level int) int {
        if level <= 1 { return 1 }
        if level == 2 { return 2 }
        return 3
    }

    func GetCustomerMaxAmountForStallLevel(level int) int {
        if level <= 1 { return 1 }
        if level == 2 { return 3 }
        return 5
    }

    // Average crop units per customer visit at this stall level (visit duration is fixed — higher avg = faster throughput).
    func GetStallAvgUnitsPerSaleForLevel(level int) float {
        var mn = GetCustomerMinAmountForStallLevel(level) as float
        var mx = GetCustomerMaxAmountForStallLevel(level) as float
        return (mn + mx) / 2.0
    }

    // UI: % increase in average units sold per visit when upgrading fromLevel → toLevel.
    func GetStallSellingSpeedPercentGainForUpgrade(fromLevel int, toLevel int) int {
        var a = GetStallAvgUnitsPerSaleForLevel(fromLevel)
        var b = GetStallAvgUnitsPerSaleForLevel(toLevel)
        if a <= 0.0 { return 0 }
        var pct = ((b - a) / a) * 100.0
        return math.Floor(pct + 0.5) as int
    }

    func GetMaxTableSlots() int { return 5 }

    // Logical table row index (0..cap-1) -> SlotVisualAnchor index (0..4). Depends on stall level; see market table visual plan.
    func GetTableVisualAnchorIndexForLogicalSlot(stallLevel int, logicalSlot int) int {
        var lv = stallLevel
        if lv < 1 { lv = 1 }
        if lv > 3 { lv = 3 }
        var cap = GetTableStackCapacityForStallLevel(lv) as int
        if logicalSlot < 0 || logicalSlot >= cap { return -1 }
        if lv <= 1 {
            if logicalSlot == 0 { return 0 }
            if logicalSlot == 1 { return 2 }
            if logicalSlot == 2 { return 4 }
            return -1
        }
        if lv == 2 {
            if logicalSlot == 0 { return 0 }
            if logicalSlot == 1 { return 1 }
            if logicalSlot == 2 { return 2 }
            if logicalSlot == 3 { return 4 }
            return -1
        }
        return logicalSlot
    }

    // Which SlotVisualAnchor indices (0..4) are shown for this stall level. Others stay hidden (ActiveSelf false).
    func IsSlotVisualAnchorUnlockedForStallLevel(stallLevel int, anchorIndex int) bool {
        if anchorIndex < 0 || anchorIndex > 4 { return false }
        var lv = stallLevel
        if lv < 1 { lv = 1 }
        if lv > 3 { lv = 3 }
        if lv <= 1 {
            return anchorIndex == 0 || anchorIndex == 2 || anchorIndex == 4
        }
        if lv == 2 {
            return anchorIndex != 3
        }
        return true
    }

    // Local offset (relative to market forward) added on top of anchor position so produce clears the marker disc.
    func GetTableProduceNudgeForAnchor(anchorIndex int) Vector3 {
        var y = 0.14
        var z = 0.06
        var x = 0.0
        if anchorIndex == 1 {
            y = 0.18
            z = 0.1
        }
        return Vector3{x, y, z}
    }

    func GetProducePrefab(itemId string) PrefabID {
        if itemId == "crop_apple" { return EResPrefab.crop_apple }
        if itemId == "crop_carrot" { return EResPrefab.crop_carrot }
        if itemId == "crop_tomato" { return EResPrefab.crop_tomato }
        if itemId == "crop_chili" { return EResPrefab.crop_chili }
        if itemId == "crop_onion" { return EResPrefab.crop_onion }
        return EResPrefab.seed_growed
    }

    func GetNPCPrefab() PrefabID {
        return EResPrefab.npc_customer
    }

    func GetCustomerMinAmount() int { return GetCustomerMinAmountForStallLevel(1) }
    func GetCustomerMaxAmount() int { return GetCustomerMaxAmountForStallLevel(1) }

    func GetNPCTweenTimeMs() int { return 2000 }

    func GetConveyorDelayMs() int { return 1500 }

    func GetAdvanceTweenMs() int { return 1000 }

    func GetNPCYOffset() float { return -0.3 }

    func GetLeaveSideOffset() Vector3 { return Vector3{1.5, 0, 0} }
    func GetLeaveSideStepMs() int { return 600 }

    func GetInfoBoardOffset() Vector3 { return Vector3{3.0, 1.7, 0.0} }

    // ===== MONEY DROP CONFIG =====

    func GetMoneyDropOffset() Vector3 { return Vector3{-3.5, 0.0, 0.0} }
    func GetMoneyLayerPrefab() PrefabID { return EResPrefab.money }
    func GetMoneyTriggerPrefab() PrefabID { return EResPrefab.money_trigger }
    func GetMoneyPerLayer() int { return 50 }
    func GetMoneyLayerHeight() float { return 0.15 }
    func GetMoneyMaxLayers() int { return 999 }
}
