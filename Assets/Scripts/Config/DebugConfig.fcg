import "StdLibrary.fcc" as std

[platform_server]
static graph DebugConfig {
    // Master: enables every category below.
    _DebugAll bool = false

    // Zone register, player join/init, teleport, market poll — needed to verify GameManager + ownership before farming.
    _DebugCore bool = false
    // GardenData wire, triggers, FarmingManager, HUD farm taps, growth tick, visuals — main switch for the new garden flow.
    _DebugFarming bool = true
    _DebugMarket bool = false
    _DebugStore bool = false
    _DebugBackpack bool = false
    _DebugGrid bool = false
    _DebugCurrency bool = false
    _DebugGacha bool = false
    _DebugMutation bool = false
    _DebugMoneyDrop bool = false
    _DebugPrompt bool = false

    func All() bool { return _DebugAll }
    func Core() bool { return _DebugAll || _DebugCore }
    func Farming() bool { return _DebugAll || _DebugFarming }
    func Market() bool { return _DebugAll || _DebugMarket }
    func Store() bool { return _DebugAll || _DebugStore }
    func Backpack() bool { return _DebugAll || _DebugBackpack }
    func Grid() bool { return _DebugAll || _DebugGrid }
    func Currency() bool { return _DebugAll || _DebugCurrency }
    func Gacha() bool { return _DebugAll || _DebugGacha }
    func Mutation() bool { return _DebugAll || _DebugMutation }
    func MoneyDrop() bool { return _DebugAll || _DebugMoneyDrop }
    func Prompt() bool { return _DebugAll || _DebugPrompt }
}
