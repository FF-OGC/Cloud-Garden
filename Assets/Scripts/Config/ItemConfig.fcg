import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen
import "Convert.fcc" as convert
import "Math.fcc" as math

import "./MutationConfig.fcg" as mutCfg

// [platform_client]
[platform_server]
static graph ItemConfig {
    
    // Returns Item Category: 1 = Seed, 2 = Crop, 3 = Tool, 4 = Special Item
    func GetType(itemId string) int {
        if itemId == "seed_apple" || itemId == "seed_tomato" || itemId == "seed_carrot" { return 1 }
        if itemId == "crop_apple" || itemId == "crop_tomato" || itemId == "crop_carrot" { return 2 }
        if itemId == "potion" { return 4 }
        return 3
    }

    func IsSellable(itemId string) bool {
        return GetType(itemId) == 2
    }

    // Returns Maximum Stack Size for a specific item
    func GetMaxStack(itemId string) int {
        if GetType(itemId) == 1 { return 99 }
        if GetType(itemId) == 2 { return 50 }
        if GetType(itemId) == 4 { return 99 }
        return 1
    }

    // Returns Growth Time (in seconds) for seeds
    func GetGrowthTime(itemId string) float {
        if itemId == "seed_apple" { return 30.0 }
        if itemId == "seed_carrot" { return 45.0 }
        if itemId == "seed_tomato" { return 90.0 }
        return 60.0
    }

    // World Y lift from VisualAnchor (single source: FarmVisualManager pot/plant + potion VFX world Y on pot).
    func GetFarmLiftPotY() float { return 0.05 }
    func GetFarmLiftPlantY() float { return 0.5 }

    // Maps the Seed ID to its corresponding Crop ID yield
    func GetHarvestYield(seedId string) string {
        if seedId == "seed_apple" { return "crop_apple" }
        if seedId == "seed_carrot" { return "crop_carrot" }
        if seedId == "seed_tomato" { return "crop_tomato" }
        return "crop_default"
    }

    func GetItemName(itemId string) string {
        if itemId == "seed_apple" { return "Apple Seed" }
        if itemId == "seed_carrot" { return "Carrot Seed" }
        if itemId == "seed_tomato" { return "Tomato Seed" }
        if itemId == "crop_apple" { return "Apple" }
        if itemId == "crop_carrot" { return "Carrot" }
        if itemId == "crop_tomato" { return "Tomato" }
        if itemId == "watering_can" { return "Watering Can" }
        if itemId == "potion" { return "Growth Potion" }
        return itemId
    }

    func GetBuyPrice(itemId string) int {
        if itemId == "pot_purchase" { return 100 }
        if itemId == "seed_apple" { return 20 }
        if itemId == "seed_carrot" { return 25 }
        if itemId == "seed_tomato" { return 35 }
        if itemId == "potion" { return 50 }
        return 10
    }

    func GetSellPrice(itemId string) int {
        if itemId == "crop_apple" { return 50 }
        if itemId == "crop_carrot" { return 55 }
        if itemId == "crop_tomato" { return 60 }
        return 10
    }

    // ==========================================
    // 1. UI DICTIONARY (For Backpack 2D Icons)
    // ==========================================
    func GetIconKey(itemId string) SpriteID {
        if itemId == "seed_apple" { return EResSprite.seed_apple }
        if itemId == "seed_carrot" { return EResSprite.seed_carrot }
        if itemId == "seed_tomato" { return EResSprite.seed_tomato }
        if itemId == "crop_apple" { return EResSprite.crop_apple }
        if itemId == "crop_carrot" { return EResSprite.crop_carrot }
        if itemId == "crop_tomato" { return EResSprite.crop_tomato }
        if itemId == "potion" { return EResSprite.item_buff_dirt }
        return EResSprite.seed_apple 
    }

    // ==========================================
    // 2. 3D DICTIONARY (For Farming Visuals)
    // Returns the correct 3D prefab based on Seed ID and Growth State
    // ==========================================
    func GetPlantPrefab(seedId string, state int) PrefabID {
        
        if state == EFarmSlotState.CropGrowing {
            if seedId == "seed_apple" { return EResPrefab.seed_apple }
            if seedId == "seed_carrot" { return EResPrefab.seed_carrot }
            if seedId == "seed_tomato" { return EResPrefab.seed_tomato }
            return EResPrefab.seed_model
        }
        
        if state == EFarmSlotState.CropReady {
            if seedId == "seed_apple" { return EResPrefab.crop_apple }
            if seedId == "seed_carrot" { return EResPrefab.crop_carrot }
            if seedId == "seed_tomato" { return EResPrefab.crop_tomato }
            return EResPrefab.seed_growed
        }

        return EResPrefab.seed_model
    }

    func GetPotPrefabForSkinTier(skinTier int) PrefabID {
        if skinTier == 2 { return EResPrefab.pot_tier2 }
        return EResPrefab.pot_tier1
    }

    // Pool key mirrors for CropVisualPool lookups
    func GetPlantPrefabKey(seedId string, state int) string {
        if state == EFarmSlotState.CropGrowing {
            if seedId == "seed_apple" { return "seed_apple" }
            if seedId == "seed_carrot" { return "seed_carrot" }
            if seedId == "seed_tomato" { return "seed_tomato" }
            return "seed_model"
        }
        if state == EFarmSlotState.CropReady {
            if seedId == "seed_apple" { return "crop_apple" }
            if seedId == "seed_carrot" { return "crop_carrot" }
            if seedId == "seed_tomato" { return "crop_tomato" }
            return "seed_growed"
        }
        return "seed_model"
    }

    // ==========================================
    // 3. POTION / SPECIAL ITEM CONFIG
    // ==========================================
    func GetPotionLuckBonus() int { return 90 }
    func GetPotionGrowthReduction() float { return 0.3 }

    // Extra roll weight on Golden vs base Golden weight when soil is fertilized (matches GachaManager weight math at full potion luck).
    func GetPotionGoldWeightBonusPercent() int {
        var baseW = mutCfg.GetPrefixBaseWeight(2)
        var add = mutCfg.GetEnhancementWeightBonus(2)
        if baseW < 1 { return 0 }
        return ((add * 100) / baseW) as int
    }

    func GetItemDescription(itemId string) string {
        if itemId == "seed_apple" { return "Plant to grow Apples" }
        if itemId == "seed_carrot" { return "Plant to grow Carrots" }
        if itemId == "seed_tomato" { return "Plant to grow Tomatoes" }
        if itemId == "potion" {
            var gPct = GetPotionGoldWeightBonusPercent()
            return "Use while growing: +90% prefix | -30% remaining time | Golden +" + convert.ToString(gPct) + "%"
        }
        return ""
    }

    // ==========================================
    // 4. MUTATION HELPERS
    // ==========================================

    func BuildMutationStr(prefixId int, suffixTier int) string {
        return "p" + convert.ToString(prefixId) + "s" + convert.ToString(suffixTier)
    }

    func ParseMutationPrefix(mutStr string) int {
        if mutStr == "" { return 0 }
        // Format: "p{X}s{Y}" - extract X (single digit after 'p')
        if mutStr == "p0s1" || mutStr == "p0s2" || mutStr == "p0s3" { return 0 }
        if mutStr == "p1s1" || mutStr == "p1s2" || mutStr == "p1s3" { return 1 }
        if mutStr == "p2s1" || mutStr == "p2s2" || mutStr == "p2s3" { return 2 }
        if mutStr == "p3s1" || mutStr == "p3s2" || mutStr == "p3s3" { return 3 }
        return 0
    }

    func ParseMutationSuffix(mutStr string) int {
        if mutStr == "" { return 0 }
        if mutStr == "p0s1" || mutStr == "p1s1" || mutStr == "p2s1" || mutStr == "p3s1" { return 1 }
        if mutStr == "p0s2" || mutStr == "p1s2" || mutStr == "p2s2" || mutStr == "p3s2" { return 2 }
        if mutStr == "p0s3" || mutStr == "p1s3" || mutStr == "p2s3" || mutStr == "p3s3" { return 3 }
        return 0
    }

    func GetMutationDisplayName(itemId string, mutStr string) string {
        var baseName = GetItemName(itemId)
        if mutStr == "" { return baseName }

        var prefixId = ParseMutationPrefix(mutStr)
        var suffixTier = ParseMutationSuffix(mutStr)

        var result = ""
        if prefixId > 0 {
            result = mutCfg.GetPrefixName(prefixId) + " "
        }
        result = result + baseName
        if suffixTier > 0 {
            result = result + " " + mutCfg.GetSuffixName(suffixTier)
        }
        return result
    }

    func GetPrefixText(mutStr string) string {
        var id = ParseMutationPrefix(mutStr)
        return mutCfg.GetPrefixName(id)
    }

    func GetSuffixText(mutStr string) string {
        var tier = ParseMutationSuffix(mutStr)
        if tier == 0 { return "" }
        return mutCfg.GetSuffixName(tier)
    }

    func GetMutationTagText(mutStr string) string {
        if mutStr == "" { return "" }
        var prefixId = ParseMutationPrefix(mutStr)
        var suffixTier = ParseMutationSuffix(mutStr)

        var tag = ""
        if prefixId > 0 {
            tag = mutCfg.GetPrefixName(prefixId)
        }
        if suffixTier > 0 {
            if tag != "" { tag = tag + " " }
            tag = tag + mutCfg.GetSuffixName(suffixTier)
        }
        return tag
    }

    func GetMutationSellPrice(itemId string, mutStr string) int {
        var basePrice = GetSellPrice(itemId)
        if mutStr == "" { return basePrice }

        var prefixId = ParseMutationPrefix(mutStr)
        var suffixTier = ParseMutationSuffix(mutStr)

        var prefixMult = mutCfg.GetPrefixSellMultiplier(prefixId)
        var suffixMult = mutCfg.GetSuffixSellMultiplier(suffixTier)

        var result = math.Floor(basePrice * prefixMult * suffixMult)
        if result < 50.0 { return 50 }
        return result as int
    }

    // Single source for market payouts + backpack "sell" line (mutation-aware). 0 = not sold at market.
    func GetMarketUnitSellPrice(itemId string, mutStr string) int {
        if !IsSellable(itemId) { return 0 }
        return GetMutationSellPrice(itemId, mutStr)
    }

    // Backpack inspector introduce: flavor text + same market value as price row (GetMarketUnitSellPrice).
    func GetBackpackInspectorIntroText(itemId string, mutStr string) string {
        var base = GetItemDescription(itemId)
        if IsSellable(itemId) {
            var p = GetMarketUnitSellPrice(itemId, mutStr)
            var line = "Market value: " + convert.ToString(p) + " gold per unit when sold."
            if base == "" { return line }
            return base + "\n" + line
        }
        return base
    }

    func GetPotPurchaseItemId() string { return "pot_purchase" }

    func IsConsumableItem(itemId string) bool { return GetType(itemId) == 4 }
}
