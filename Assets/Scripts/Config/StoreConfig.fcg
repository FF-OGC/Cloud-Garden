import "StdLibrary.fcc" as std
import "List.fcc" as list

static graph StoreConfig {
    // --- Restock cycle (seconds) ---
    func GetRestockCycleSeconds() int { return 10 }

    // --- Event Schedule (Dev Override) ---
    func GetEventCount() int { return 0 }
    func GetEventTriggerTime(index int) float { return -1.0 }
    func GetEventItemId(index int) string { return "" }
    func GetEventItemQty(index int) int { return 0 }

    // --- Guaranteed items (always appear after refresh) ---
    func GetGuaranteedItems() List<string> {
        return List<string>{"seed_apple", "seed_carrot", "seed_tomato", "potion"}
    }
    func GetGuaranteedStock(itemId string) int {
        if itemId == "seed_apple" { return 10 }
        if itemId == "seed_carrot" { return 8 }
        if itemId == "seed_tomato" { return 5 }
        if itemId == "potion" { return 5 }
        return 0
    }

    // --- Random pool (gacha roll each refresh) ---
    func GetPoolItemIDs() List<string> {
        return List<string>{"seed_apple", "seed_carrot", "seed_tomato"}
    }
    func GetPoolItemRates() List<int> {
        return List<int>{50, 30, 20}
    }
    func GetPoolItemMinQty() List<int> { return List<int>{1, 1, 1} }
    func GetPoolItemMaxQty() List<int> { return List<int>{10, 8, 5} }

    // --- Global pool limit (0 = unlimited) ---
    func GetGlobalPoolLimit(itemId string) int {
        return 0
    }

    func GetSlotCount() int { return 40 }
}
