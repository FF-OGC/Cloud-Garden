import "StdLibrary.fcc" as std
import "List.fcc" as list

static graph StoreConfig {

    // --- Join fallback (when farm zone / market transforms are missing or invalid) ---
    // Tune to match your level: beside the global store / hub (StoreTrigger area).
    func GetJoinFallbackBesideStorePosition() Vector3 {
        return Vector3{2.0, 201.0, 0.0}
    }
    func GetJoinFallbackBesideStoreFacing() Vector3 {
        return Vector3{0.0, 0.0, 0.0}
    }
    // --- Restock cycle (seconds) ---
    func GetRestockCycleSeconds() int { return 60 }

    // --- Event Schedule (Dev Override) ---
    func GetEventCount() int { return 0 }
    func GetEventTriggerTime(index int) float { return -1.0 }
    func GetEventItemId(index int) string { return "" }
    func GetEventItemQty(index int) int { return 0 }

    // --- Guaranteed items (always appear after refresh) ---
    func GetGuaranteedItems() List<string> {
        return List<string>{"seed_apple", "seed_carrot", "seed_tomato", "seed_chili", "seed_onion", "potion_luck", "potion_grow"}
    }
    func GetGuaranteedStock(itemId string) int {
        if itemId == "seed_apple" { return 10 }
        if itemId == "seed_carrot" { return 8 }
        if itemId == "seed_tomato" { return 5 }
        if itemId == "seed_chili" { return 6 }
        if itemId == "seed_onion" { return 6 }
        if itemId == "potion_luck" { return 4 }
        if itemId == "potion_grow" { return 4 }
        return 0
    }

    // --- Random pool (gacha roll each refresh) ---
    func GetPoolItemIDs() List<string> {
        return List<string>{"seed_apple", "seed_carrot", "seed_tomato", "seed_chili", "seed_onion"}
    }
    func GetPoolItemRates() List<int> {
        return List<int>{35, 25, 20, 12, 8}
    }
    func GetPoolItemMinQty() List<int> { return List<int>{1, 1, 1, 1, 1} }
    func GetPoolItemMaxQty() List<int> { return List<int>{10, 8, 5, 6, 6} }

    // --- Global pool limit (0 = unlimited) ---
    func GetGlobalPoolLimit(itemId string) int {
        return 0
    }

    func GetSlotCount() int { return 40 }
}
