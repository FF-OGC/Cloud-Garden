import "StdLibrary.fcc" as std
import "Map.fcc" as map
import "Convert.fcc" as convert

import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph GachaData {

    _PityCounters Map<string, int> = nil
    _FirstRollUsed Map<string, bool> = nil
    _PotPurchaseActionCount Map<string, int> = nil
    _NextPotSkinGuaranteed Map<string, bool> = nil

    event OnAwake() {
        _PityCounters = map.New() as Map<string, int>
        _FirstRollUsed = map.New() as Map<string, bool>
        _PotPurchaseActionCount = map.New() as Map<string, int>
        _NextPotSkinGuaranteed = map.New() as Map<string, bool>
    }

    func _MakeKey(player entity<Entity>, gachaId string) string {
        var pid = convert.ToString(player<Player>.UserUID)
        return pid + "_" + gachaId
    }

    func _MakePlayerKey(player entity<Entity>) string {
        return convert.ToString(player<Player>.UserUID)
    }

    func IsFirstEverRoll(player entity<Entity>) bool {
        var key = _MakePlayerKey(player)
        return !map.ContainKey(_FirstRollUsed, key)
    }

    func MarkFirstRollUsed(player entity<Entity>) {
        var key = _MakePlayerKey(player)
        _FirstRollUsed[key] = true
        if debugCfg.Gacha() { LogInfo("[GachaData] First roll used for player key=" + key) }
    }

    func IncrementPotPurchaseAction(player entity<Entity>) int {
        var key = _MakePlayerKey(player)
        var cur = 0
        if map.ContainKey(_PotPurchaseActionCount, key) {
            cur = _PotPurchaseActionCount[key] as int
        }
        cur = cur + 1
        _PotPurchaseActionCount[key] = cur
        if debugCfg.Gacha() { LogInfo("[GachaData] PotPurchaseAction count=" + convert.ToString(cur) + " key=" + key) }
        return cur
    }

    func ShouldForceTutorialPotSkinOnce(countAfterThisAction int) bool {
        return countAfterThisAction == 2
    }

    func MarkNextPotSkinGuaranteed(player entity<Entity>) {
        var key = _MakePlayerKey(player)
        _NextPotSkinGuaranteed[key] = true
    }

    func ConsumeNextPotSkinGuaranteed(player entity<Entity>) bool {
        var key = _MakePlayerKey(player)
        if map.ContainKey(_NextPotSkinGuaranteed, key) {
            var v = _NextPotSkinGuaranteed[key] as bool
            if v {
                map.Remove(_NextPotSkinGuaranteed, key)
                return true
            }
        }
        return false
    }

    func GetPityCounter(player entity<Entity>, gachaId string) int {
        var key = _MakeKey(player, gachaId)
        if map.ContainKey(_PityCounters, key) {
            return _PityCounters[key] as int
        }
        return 0
    }

    func SetPityCounter(player entity<Entity>, gachaId string, value int) {
        var key = _MakeKey(player, gachaId)
        _PityCounters[key] = value
        if debugCfg.Gacha() { LogInfo("[GachaData] SetPity | key=" + key + " value=" + convert.ToString(value)) }
    }

    func IncrementPity(player entity<Entity>, gachaId string) {
        var current = GetPityCounter(player, gachaId)
        SetPityCounter(player, gachaId, current + 1)
    }

    func ResetPity(player entity<Entity>, gachaId string) {
        SetPityCounter(player, gachaId, 0)
    }
}
