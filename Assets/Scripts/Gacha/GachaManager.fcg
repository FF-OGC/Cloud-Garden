import "StdLibrary.fcc" as std
import "Convert.fcc" as convert
import "Math.fcc" as math

import "../Config/GachaConfig.fcg" as gachaCfg
import "../Config/MutationConfig.fcg" as mutCfg
import "../Config/ItemConfig.fcg" as itemCfg
import "../Gacha/GachaData.fcg" as gachaData
import "../Services/GachaService.fcg" as gachaService
import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph GachaManager {

    func RollSuffixTier() int {
        var totalWeight = mutCfg.GetSuffixTotalWeight()
        var roll = math.RandomInt(1, totalWeight)
        var cumulative = 0
        var tierCount = mutCfg.GetSuffixTierCount()

        for t = 1, tierCount + 1, 1 {
            cumulative = cumulative + mutCfg.GetSuffixWeight(t)
            if roll <= cumulative {
                if debugCfg.Mutation() { LogInfo("[MUTATION] SUFFIX ROLL -> tier=" + convert.ToString(t) + " (" + mutCfg.GetSuffixName(t) + ") roll=" + convert.ToString(roll)) }
                return t
            }
        }
        return 1
    }

    func RollMutationPrefix(owner entity<Entity>, seedId string, potTier int, fertilizerLuckPercent int, isLuckyPot bool) int {
        if gachaData.IsFirstEverRoll(owner) {
            gachaData.MarkFirstRollUsed(owner)
            if debugCfg.Mutation() { LogInfo("[MUTATION] " + owner<Player>.NickName + " | FIRST EVER ROLL -> GUARANTEED Rainbow prefix") }
            return 3
        }

        var baseChance = mutCfg.GetBasePrefixChance(seedId)
        var soilBonus = mutCfg.GetSoilChanceBonus(potTier)
        var enhanceBonus = fertilizerLuckPercent

        var pityId = "prefix_" + seedId
        var pityCount = gachaData.GetPityCounter(owner, pityId)
        var pityBonus = mutCfg.GetPityBonus(pityCount)

        var totalChance = baseChance + soilBonus + enhanceBonus + pityBonus
        var cap = mutCfg.GetPrefixChanceCap()
        if totalChance > cap { totalChance = cap }

        var chanceRoll = math.RandomInt(1, 100)

        if debugCfg.Mutation() { LogInfo("[MUTATION] " + owner<Player>.NickName + " | PREFIX ROLL | seed=" + seedId + " base=" + convert.ToString(baseChance) + " pot=+" + convert.ToString(soilBonus) + " fertLuck=+" + convert.ToString(enhanceBonus) + " pity=+" + convert.ToString(pityBonus) + " total=" + convert.ToString(totalChance) + "% roll=" + convert.ToString(chanceRoll)) }

        if chanceRoll <= totalChance {
            gachaData.ResetPity(owner, pityId)

            var prefixCount = mutCfg.GetPrefixCount()
            var potionRef = itemCfg.GetPotionLuckBonus()
            if potionRef < 1 { potionRef = 1 }

            var totalWeight = 0
            for p = 1, prefixCount + 1, 1 {
                var w = mutCfg.GetPrefixBaseWeight(p)
                if isLuckyPot { w = w + mutCfg.GetLuckyDirtWeightBonus(p) }
                if fertilizerLuckPercent > 0 {
                    var goldBase = mutCfg.GetEnhancementWeightBonus(p)
                    if goldBase > 0 {
                        w = w + (goldBase * fertilizerLuckPercent) / potionRef
                    }
                }
                totalWeight = totalWeight + w
            }

            var prefixRoll = math.RandomInt(1, totalWeight)
            var cumulative = 0

            for p = 1, prefixCount + 1, 1 {
                var w = mutCfg.GetPrefixBaseWeight(p)
                if isLuckyPot { w = w + mutCfg.GetLuckyDirtWeightBonus(p) }
                if fertilizerLuckPercent > 0 {
                    var goldBase = mutCfg.GetEnhancementWeightBonus(p)
                    if goldBase > 0 {
                        w = w + (goldBase * fertilizerLuckPercent) / potionRef
                    }
                }
                cumulative = cumulative + w
                if prefixRoll <= cumulative {
                    if debugCfg.Mutation() { LogInfo("[MUTATION] PREFIX HIT -> " + mutCfg.GetPrefixName(p) + " (id=" + convert.ToString(p) + ") | finalWeight=" + convert.ToString(w) + "/" + convert.ToString(totalWeight) + " luckyPot=" + convert.ToString(isLuckyPot) + " fertLuck%=" + convert.ToString(fertilizerLuckPercent)) }
                    return p
                }
            }
            return 1
        }

        gachaData.IncrementPity(owner, pityId)
        if debugCfg.Mutation() { LogInfo("[MUTATION] PREFIX MISS | pity now=" + convert.ToString(pityCount + 1)) }
        return 0
    }

    // Returns pot skin tier 1..3 (1=basic, 2=bonus roll hit, 3=tutorial or top pity)
    func RollPotSkinTier(owner entity<Entity>) int {
        var gachaId = "gacha_lucky_dirt"

        if gachaData.ConsumeNextPotSkinGuaranteed(owner) {
            gachaData.ResetPity(owner, gachaId)
            if debugCfg.Gacha() { LogInfo("[GACHA] " + owner<Player>.NickName + " | POT SKIN | GUARANTEED tier 3 (tutorial)") }
            return 2
        }

        if !gachaCfg.HasGacha(gachaId) {
            return math.RandomInt(1, 2)
        }

        var baseRate = gachaCfg.GetBaseRate(gachaId)
        var soft = gachaCfg.GetSoftPityThreshold(gachaId)
        var hard = gachaCfg.GetHardPityThreshold(gachaId)
        var step = gachaCfg.GetStepRate(gachaId)
        var kzBonus = gachaCfg.GetKillZoneMaxBonus(gachaId)
        var pityCount = gachaData.GetPityCounter(owner, gachaId)

        var isHit = gachaService.Roll(baseRate, soft, hard, step, kzBonus, pityCount)

        var playerName = owner<Player>.NickName

        if isHit {
            gachaData.ResetPity(owner, gachaId)
            if debugCfg.Gacha() { LogInfo("[GACHA] " + playerName + " | POT SKIN | tier=2 lucky roll pity=" + convert.ToString(pityCount)) }
            return 2
        } else {
            gachaData.IncrementPity(owner, gachaId)
            if debugCfg.Gacha() { LogInfo("[GACHA] " + playerName + " | POT SKIN | tier=1 pity now=" + convert.ToString(pityCount + 1)) }
            return 1
        }
    }
}
