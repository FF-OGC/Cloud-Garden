import "StdLibrary.fcc" as std
import "Player.fcc" as Player
import "List.fcc" as list
import "EditorGenLib.fcc" as gen
import "Math.fcc" as math
import "Convert.fcc" as convert

import "../Farming/GardenZoneManager.fcg" as zoneManager
import "../Farming/GardenData.fcg" as gardenData
import "../Farming/CropSlot.fcg" as cropSlot
import "../Farming/CropGrowthManager.fcg" as cropManager
import "../Farming/CropVisualPool.fcg" as cropPool
import "../Backpack/BackpackManager.fcg" as backpackManager
import "../Market/MarketManager.fcg" as marketManager
import "../Currency/CurrencyManager.fcg" as currencyManager
import "../Store/StoreManager.fcg" as storeManager
import "../Config/DebugConfig.fcg" as debugCfg
import "../Config/StoreConfig.fcg" as storeCfg
import "LevelObject.fcc" as LevelObject
[platform_server]
static graph GameManager {
    
    _GameTime float = 0.0
    _IsTickStarted bool = false
    
    // Dynamically populated at runtime by FarmZoneRegister. No Editor setup needed!
    _FarmZones List<entity<Entity>> = nil
    // Unclaimed zones available to assign (RegisterZone appends; claim pops front; quit appends back).
    _AvailableFarmZonePool List<entity<Entity>> = nil
    _AllFloorsInWorld List<entity<Entity>> = nil
    _ConnectedPlayers List<entity<Player>> = nil
    // Prevents duplicate OnPlayerJoin from running WaitAndInitPlayer twice (2nd run sees empty pool → shop teleport).
    _JoinInitStartedForPlayer List<entity<Player>> = nil
    // After join spawn Teleport runs once (farm or shop), skip further teleport — avoids double teleports from duplicate inits.
    _FarmJoinTeleportDonePlayers List<entity<Player>> = nil
    _FarmJoinTeleportDoneNicks List<string> = nil
    // After farm zones register: wait this many ms before assign + join Teleport (GlobalBase reference ~10s; 0 = skip).
    _JoinSpawnSettleDelayMs int = 10000

    func GetGameTime() float { return _GameTime }

    event OnAwake() {
        _GameTime = 0.0
        
        // Initialize empty lists to receive data dynamically
        _FarmZones = list.New(0, 10) as List<entity<Entity>>
        _AvailableFarmZonePool = list.New(0, 10) as List<entity<Entity>>
        _AllFloorsInWorld = list.New(0, 10) as List<entity<Entity>>
        _ConnectedPlayers = list.New(0, 10) as List<entity<Player>>
        _JoinInitStartedForPlayer = list.New(0, 10) as List<entity<Player>>
        _FarmJoinTeleportDonePlayers = list.New(0, 10) as List<entity<Player>>
        _FarmJoinTeleportDoneNicks = list.New(0, 10) as List<string>
        
        start cropPool.InitPool()
        start StartGlobalClock()
        start DelayedStoreInit()
        // start DebugSpawnAtHub()
    }
    
    async func StartGlobalClock() {
        while true {
            WaitForMillisecond(1000) 
            _GameTime = _GameTime + 1.0
        }

        
    }

    async func DelayedStoreInit() {
        WaitForMillisecond(1000)                                                                                                                                
        storeManager.InitRestock()
    }

    func RegisterZone(zoneObj entity<Entity>) {
        
        if zoneObj == nil { return }
        
        list.Append(_FarmZones, zoneObj)
        list.Append(_AvailableFarmZonePool, zoneObj)
        zoneManager.InitializeZone(zoneObj)
        
        // Collect floors
        if zoneObj<FarmZoneData> != nil {
            if zoneObj<FarmZoneData>.Floors != nil {
                var fCount = list.Length(zoneObj<FarmZoneData>.Floors)
                for j = 0, fCount, 1 { list.Append(_AllFloorsInWorld, zoneObj<FarmZoneData>.Floors[j]) }
            }
        }

        // Register linked market stall (delayed to ensure MarketRuntimeData.OnAwake has fired)
        if zoneObj<FarmZoneData> != nil && zoneObj<FarmZoneData>.Market != nil {
            start DelayedMarketRegister(zoneObj<FarmZoneData>.Market, zoneObj)
        }
        
        // Start the background growth tick only once when the first zone registers
        if !_IsTickStarted {
            start cropManager.StartBackgroundTick(_AllFloorsInWorld)
            _IsTickStarted = true
        }
        
        if debugCfg.Core() { LogInfo("[GameManager] Successfully registered new Farm Zone dynamically.") }
    }

    async func DelayedMarketRegister(marketEntity entity<Entity>, farmZone entity<Entity>) {
        WaitForMillisecond(500)
        marketManager.RegisterMarket(marketEntity, farmZone)
    }

    func GetConnectedPlayers() List<entity<Player>> { return _ConnectedPlayers }

    func HasFarmJoinTeleportCompleted(player entity<Player>) bool {
        if player == nil { return false }
        if list.IndexOf(_FarmJoinTeleportDonePlayers, player) != -1 { return true }
        var nick = player<Player>.NickName
        if nick != "" && list.IndexOf(_FarmJoinTeleportDoneNicks, nick) != -1 { return true }
        return false
    }

    func MarkFarmJoinTeleportCompleted(player entity<Player>) {
        if player == nil { return }
        if list.IndexOf(_FarmJoinTeleportDonePlayers, player) == -1 {
            list.Append(_FarmJoinTeleportDonePlayers, player)
        }
        var nick = player<Player>.NickName
        if nick != "" && list.IndexOf(_FarmJoinTeleportDoneNicks, nick) == -1 {
            list.Append(_FarmJoinTeleportDoneNicks, nick)
        }
    }

    func ClearFarmJoinTeleportCompletedForPlayer(player entity<Player>) {
        if player == nil { return }
        var pi = list.IndexOf(_FarmJoinTeleportDonePlayers, player)
        if pi != -1 { list.Remove(_FarmJoinTeleportDonePlayers, pi) }
        var nick = player<Player>.NickName
        if nick != "" {
            var ni = list.IndexOf(_FarmJoinTeleportDoneNicks, nick)
            if ni != -1 { list.Remove(_FarmJoinTeleportDoneNicks, ni) }
        }
    }

    // Re-append any registered zone that has no owner but is missing from the pool (fixes desync / leaked pops).
    func RepairAvailableFarmZonePool() {
        var zCount = list.Length(_FarmZones)
        var added = 0
        for i = 0, zCount, 1 {
            var zone = _FarmZones[i]
            if zone == nil || zone<gen.FarmZoneData> == nil { continue }
            if zone<gen.FarmZoneData>.Owner != nil { continue }
            if list.IndexOf(_AvailableFarmZonePool, zone) == -1 {
                list.Append(_AvailableFarmZonePool, zone)
                added = added + 1
            }
        }
        if debugCfg.Core() && added > 0 { LogInfo("[GameManager] RepairAvailableFarmZonePool | re-queued " + added + " unowned zone(s).") }
    }

    event OnUserQuitOrUserMatchEnd(player entity<Player>) {
        if player == nil { return }
        ReleaseFarmZoneForPlayer(player)
        var idx = list.IndexOf(_ConnectedPlayers, player)
        if idx != -1 { list.Remove(_ConnectedPlayers, idx) }
        var jIdx = list.IndexOf(_JoinInitStartedForPlayer, player)
        if jIdx != -1 { list.Remove(_JoinInitStartedForPlayer, jIdx) }
        ClearFarmJoinTeleportCompletedForPlayer(player)
        if debugCfg.Core() { LogInfo("[GameManager] Player left. Connected: " + list.Length(_ConnectedPlayers)) }
    }

    func RebindFarmZoneOwnershipToPlayerEntity(zone entity<Entity>, player entity<Player>) {
        if zone == nil || player == nil || zone<gen.FarmZoneData> == nil { return }
        zone<gen.FarmZoneData>.Owner = player
        var floors = zone<FarmZoneData>.Floors
        if floors != nil {
            var fCount = list.Length(floors)
            for j = 0, fCount, 1 {
                if floors[j]<gen.GardenData> != nil { floors[j]<gen.GardenData>.Owner = player }
            }
        }
        marketManager.AssignMarketOwner(zone, player)
    }

    // Same human, new Player entity (respawn / slow load): Owner still points at old entity — reclaim by NickName so we do not fall through to empty pool + shop teleport.
    func TryResolveAssignedZoneForPlayerIdentity(player entity<Player>) entity<Entity> {
        if player == nil { return nil }
        var pn = player<Player>.NickName
        var zCount = list.Length(_FarmZones)
        for i = 0, zCount, 1 {
            var zone = _FarmZones[i]
            if zone == nil || zone<gen.FarmZoneData> == nil { continue }
            var ow = zone<gen.FarmZoneData>.Owner
            if ow == nil { continue }
            if ow == player {
                return zone
            }
            var owPlayer = ow as entity<Player>
            if pn != "" && owPlayer != nil && owPlayer<Player>.NickName == pn {
                RebindFarmZoneOwnershipToPlayerEntity(zone, player)
                if debugCfg.Core() { LogInfo("[GameManager] Resolved farm zone by NickName (rebound to current Player entity).") }
                return zone
            }
        }
        return nil
    }

    func ReleaseFarmZoneForPlayer(player entity<Player>) {
        if player == nil { return }
        var zCount = list.Length(_FarmZones)
        for i = 0, zCount, 1 {
            var zone = _FarmZones[i]
            if zone == nil || zone<gen.FarmZoneData> == nil { continue }
            if zone<gen.FarmZoneData>.Owner != player { continue }

            zone<gen.FarmZoneData>.Owner = nil
            var floors = zone<FarmZoneData>.Floors
            if floors != nil {
                var fCount = list.Length(floors)
                for j = 0, fCount, 1 {
                    if floors[j]<gen.GardenData> != nil { floors[j]<gen.GardenData>.Owner = nil }
                }
            }
            marketManager.ClearMarketOwner(zone)
            if list.IndexOf(_AvailableFarmZonePool, zone) == -1 {
                list.Append(_AvailableFarmZonePool, zone)
            }
            if debugCfg.Core() { LogInfo("[GameManager] Released farm zone to pool | zone='" + zone<Entity>.Name + "' pool=" + list.Length(_AvailableFarmZonePool)) }
            return
        }
    }

    event OnPlayerJoin(player entity<Player>) {
        if player == nil { return }
        if list.IndexOf(_ConnectedPlayers, player) != -1 {
            if debugCfg.Core() { LogWarning("[GameManager] Duplicate OnPlayerJoin ignored (same player already connected).") }
            return
        }
        list.Append(_ConnectedPlayers, player)
        if debugCfg.Core() { LogInfo("[GameManager] Player joined. Connected: " + list.Length(_ConnectedPlayers)) }

        start WaitAndInitPlayer(player)
    }

    async func WaitAndInitPlayer(player entity<Player>) {
        if player == nil { return }
        if list.IndexOf(_JoinInitStartedForPlayer, player) != -1 {
            if debugCfg.Core() { LogWarning("[GameManager] Duplicate OnPlayerJoin — skipping extra WaitAndInitPlayer (avoids empty-pool shop teleport).") }
            return
        }
        list.Append(_JoinInitStartedForPlayer, player)

        // Wait until at least one farm zone has registered (longer window for 4-player / slow clients)
        var maxWait = 90
        var waited = 0
        while list.Length(_FarmZones) == 0 && waited < maxWait {
            WaitForMillisecond(500)
            waited = waited + 1
        }

        if list.Length(_FarmZones) == 0 {
            if debugCfg.Core() { LogWarning("[GameManager] Timeout: No farm zones registered — skipping zone claim & teleport; still granting starter items.") }
        } else {
            if debugCfg.Core() { LogInfo("[GameManager] Zones registered after " + (waited * 500) + "ms. FarmZones: " + list.Length(_FarmZones)) }
        }

        if _JoinSpawnSettleDelayMs > 0 {
            WaitForMillisecond(_JoinSpawnSettleDelayMs)
            if debugCfg.Core() { LogInfo("[GameManager] Join spawn settle delay done (" + _JoinSpawnSettleDelayMs + "ms).") }
        }

        var zCount = list.Length(_FarmZones)
        var assignedZone entity<Entity> = nil
        var isFreshZoneClaim bool = false
        
        // 1. Zone already for this user: same Player ref, or same NickName with a new Player entity (avoids 2nd init → empty pool → shop).
        assignedZone = TryResolveAssignedZoneForPlayerIdentity(player)
        
        // 2. Claim from pool (FIFO) after repair; then direct scan if pool was out of sync
        if assignedZone == nil {
            RepairAvailableFarmZonePool()
            var poolLen = list.Length(_AvailableFarmZonePool)
            if poolLen > 0 {
                var zone = _AvailableFarmZonePool[0]
                if zone != nil && zone<gen.FarmZoneData> != nil {
                    list.RemoveAt(_AvailableFarmZonePool, 0)
                    zone<gen.FarmZoneData>.Owner = player
                    var floors = zone<FarmZoneData>.Floors
                    if floors != nil {
                        var fCount = list.Length(floors)
                        for j = 0, fCount, 1 { 
                            if floors[j]<gen.GardenData> != nil { floors[j]<gen.GardenData>.Owner = player }
                        }
                    }
                    assignedZone = zone
                    isFreshZoneClaim = true
                    marketManager.AssignMarketOwner(zone, player)
                    if debugCfg.Core() { LogInfo("[GameManager] Assigned Farm Zone from pool + Market | pool remaining=" + list.Length(_AvailableFarmZonePool)) }
                }
            }
        }

        if assignedZone == nil {
            RepairAvailableFarmZonePool()
            for i = 0, zCount, 1 {
                var zone = _FarmZones[i]
                if zone == nil || zone<gen.FarmZoneData> == nil { continue }
                if zone<gen.FarmZoneData>.Owner != nil { continue }
                zone<gen.FarmZoneData>.Owner = player
                var floors = zone<FarmZoneData>.Floors
                if floors != nil {
                    var fCount = list.Length(floors)
                    for j = 0, fCount, 1 {
                        if floors[j]<gen.GardenData> != nil { floors[j]<gen.GardenData>.Owner = player }
                    }
                }
                var pIdx = list.IndexOf(_AvailableFarmZonePool, zone)
                if pIdx != -1 { list.RemoveAt(_AvailableFarmZonePool, pIdx) }
                assignedZone = zone
                isFreshZoneClaim = true
                marketManager.AssignMarketOwner(zone, player)
                if debugCfg.Core() { LogInfo("[GameManager] Assigned first unowned registered zone (pool repair path) | zone='" + zone<Entity>.Name + "'") }
                break
            }
        }

        // Last-chance identity resolve after pool/direct (handles ordering with another coroutine or late Owner replication).
        if assignedZone == nil {
            assignedZone = TryResolveAssignedZoneForPlayerIdentity(player)
        }

        if assignedZone == nil && debugCfg.Core() {
            LogWarning("[GameManager] No farm zone could be assigned (all owned or none registered) — shop fallback.")
        }

        if assignedZone != nil {
            if isFreshZoneClaim {
                zoneManager.InitGardenFarmRuntimeInZone(assignedZone)
                zoneManager.ApplyFirstFloorStarterPots(assignedZone, player)
                if debugCfg.Farming() {
                    LogInfo("[POT_SHOP] [GameManager] Fresh zone claim | InitGardenFarmRuntimeInZone + starter pots floor0 slots 0-2 | zone='" + assignedZone<Entity>.Name + "'")
                }
            } else {
                if debugCfg.Farming() {
                    LogInfo("[POT_SHOP] [GameManager] Rejoin / existing ownership | skip InitGardenFarmRuntimeInZone (preserve farm state) | zone='" + assignedZone<Entity>.Name + "'")
                }
            }
        }

        // 3. Join spawn: exactly one Teleport per session (farm OR shop), after setup — same idea as PlayerBaseSetUp → TeleportToHome once (no second resolve / no double Perform).
        if !HasFarmJoinTeleportCompleted(player) {
            if assignedZone != nil {
                PerformFarmJoinTeleport(player, assignedZone)
                MarkFarmJoinTeleportCompleted(player)
                if debugCfg.Core() { LogInfo("[GameManager] Join spawn: single farm Teleport done.") }
            } else {
                TeleportFallbackBesideStore(player)
                MarkFarmJoinTeleportCompleted(player)
                if debugCfg.Core() { LogWarning("[GameManager] Join spawn: no farm zone — single shop Teleport fallback.") }
            }
        } else if debugCfg.Core() {
            LogInfo("[GameManager] Join spawn teleport already completed — skipping (no second Teleport).")
        }

        // 4. Add Seeds to Backpack
        backpackManager.AddItem(player, "seed_apple", 1)
        backpackManager.AddItem(player, "seed_carrot", 1)
        backpackManager.AddItem(player, "seed_tomato", 1)
        backpackManager.AddItem(player, "seed_chili", 1)
        backpackManager.AddItem(player, "seed_onion", 1)
        backpackManager.AddItem(player, "potion_luck", 1)
        backpackManager.AddItem(player, "potion_grow", 1)
        if debugCfg.Core() { LogInfo("[GameManager] Added starting seeds to backpack.") }

        currencyManager.InitPlayerCurrency(player, 500)

        if debugCfg.Core() { LogInfo("[GameManager] Player fully initialized.") }
    }

    func GetPlayerOrientation(spawnPoint Vector3, centerPoint Vector3) Vector3 {
        var orientation Vector3 = math.Normalize(Vector3{centerPoint.X - spawnPoint.X, 0, centerPoint.Z - spawnPoint.Z})
        return orientation
    }

    func PerformFarmJoinTeleport(player entity<Player>, zone entity<Entity>) bool {
        if player == nil || zone == nil { return false }
        var market = zone<FarmZoneData>.Market
        if market != nil {
            var mPos = market<Transform>.Position
            var rotY = market<Transform>.Rotation.Y
            var c = math.Cos(rotY)
            var s = math.Sin(rotY)
            var localOff = Vector3{-3.0, 0.0, -4.0}
            var ox = localOff.X * c + localOff.Z * s
            var oz = -localOff.X * s + localOff.Z * c
            var spawnPos = Vector3{mPos.X + ox, mPos.Y, mPos.Z + oz}
            var facing = GetPlayerOrientation(spawnPos, mPos)
            Teleport(player, spawnPos, facing)
            if debugCfg.Core() { LogInfo("[GameManager] Teleported player beside market '" + market<Entity>.Name + "'.") }
            return true
        }
        var zonePos = zone<Transform>.Position
        Teleport(player, Vector3{zonePos.X + 5.0, zonePos.Y, zonePos.Z}, Vector3{0.0, 0.0, 0.0})
        if debugCfg.Core() { LogInfo("[GameManager] No Market on zone — teleported beside zone pivot.") }
        return true
    }

    func TeleportFallbackBesideStore(player entity<Player>) {
        if player == nil { return }
        var p = storeCfg.GetJoinFallbackBesideStorePosition()
        var f = storeCfg.GetJoinFallbackBesideStoreFacing()
        Teleport(player, p, f)
    }

    async func DebugSpawnAtHub() {
        if debugCfg.Core() { LogInfo("[DEBUG-SPAWN] Waiting 5s for pool init...") }
        WaitForMillisecond(5000)
        if debugCfg.Core() { LogInfo("[DEBUG-SPAWN] Starting spawn test at Central Hub") }

        var hubY = 201.0

        CreateFromPrefab(out var directSeedCarrot, gen.EResPrefab.seed_carrot)
        if directSeedCarrot != nil {
            directSeedCarrot<Transform>.Position = Vector3{0.0, hubY, 0.0}
            if debugCfg.Core() { LogInfo("[DEBUG-SPAWN] A1 seed_carrot => pos=" + directSeedCarrot<Transform>.Position + " scale=" + directSeedCarrot<Transform>.Scale + " active=" + directSeedCarrot<Entity>.ActiveSelf + " name=" + directSeedCarrot<Entity>.Name) }
        } else {
            if debugCfg.Core() { LogError("[DEBUG-SPAWN] A1 seed_carrot => FAILED (nil)") }
        }

        CreateFromPrefab(out var directCropCarrot, gen.EResPrefab.crop_carrot)
        if directCropCarrot != nil {
            directCropCarrot<Transform>.Position = Vector3{3.0, hubY, 0.0}
            if debugCfg.Core() { LogInfo("[DEBUG-SPAWN] A2 crop_carrot => pos=" + directCropCarrot<Transform>.Position + " scale=" + directCropCarrot<Transform>.Scale + " active=" + directCropCarrot<Entity>.ActiveSelf + " name=" + directCropCarrot<Entity>.Name) }
        } else {
            if debugCfg.Core() { LogError("[DEBUG-SPAWN] A2 crop_carrot => FAILED (nil)") }
        }

        CreateFromPrefab(out var directCropTomato, gen.EResPrefab.crop_tomato)
        if directCropTomato != nil {
            directCropTomato<Transform>.Position = Vector3{6.0, hubY, 0.0}
            if debugCfg.Core() { LogInfo("[DEBUG-SPAWN] A3 crop_tomato => pos=" + directCropTomato<Transform>.Position + " scale=" + directCropTomato<Transform>.Scale + " active=" + directCropTomato<Entity>.ActiveSelf + " name=" + directCropTomato<Entity>.Name) }
        } else {
            if debugCfg.Core() { LogError("[DEBUG-SPAWN] A3 crop_tomato => FAILED (nil)") }
        }

        var poolSeedCarrot = cropPool.Get("seed_carrot")
        if poolSeedCarrot != nil {
            poolSeedCarrot<Transform>.Position = Vector3{0.0, hubY, 5.0}
            if debugCfg.Core() { LogInfo("[DEBUG-SPAWN] B1 seed_carrot POOL => pos=" + poolSeedCarrot<Transform>.Position + " scale=" + poolSeedCarrot<Transform>.Scale + " active=" + poolSeedCarrot<Entity>.ActiveSelf) }
        } else {
            if debugCfg.Core() { LogError("[DEBUG-SPAWN] B1 seed_carrot POOL => FAILED (nil)") }
        }

        var poolCropCarrot = cropPool.Get("crop_carrot")
        if poolCropCarrot != nil {
            poolCropCarrot<Transform>.Position = Vector3{3.0, hubY, 5.0}
            if debugCfg.Core() { LogInfo("[DEBUG-SPAWN] B2 crop_carrot POOL => pos=" + poolCropCarrot<Transform>.Position + " scale=" + poolCropCarrot<Transform>.Scale + " active=" + poolCropCarrot<Entity>.ActiveSelf) }
        } else {
            if debugCfg.Core() { LogError("[DEBUG-SPAWN] B2 crop_carrot POOL => FAILED (nil)") }
        }

        var poolCropTomato = cropPool.Get("crop_tomato")
        if poolCropTomato != nil {
            poolCropTomato<Transform>.Position = Vector3{6.0, hubY, 5.0}
            if debugCfg.Core() { LogInfo("[DEBUG-SPAWN] B3 crop_tomato POOL => pos=" + poolCropTomato<Transform>.Position + " scale=" + poolCropTomato<Transform>.Scale + " active=" + poolCropTomato<Entity>.ActiveSelf) }
        } else {
            if debugCfg.Core() { LogError("[DEBUG-SPAWN] B3 crop_tomato POOL => FAILED (nil)") }
        }

        if debugCfg.Core() {
            if directSeedCarrot != nil {
                var child = GetChildByName(directSeedCarrot, directSeedCarrot<Entity>.Name)
                if child != nil {
                    LogInfo("[DEBUG-SPAWN] C1 seed_carrot child: name=" + child<Entity>.Name + " pos=" + child<Transform>.Position + " active=" + child<Entity>.ActiveSelf + " scale=" + child<Transform>.Scale)
                } else {
                    LogInfo("[DEBUG-SPAWN] C1 seed_carrot: NO child found")
                }
            }

            if directCropCarrot != nil {
                var child2 = GetChildByName(directCropCarrot, directCropCarrot<Entity>.Name)
                if child2 != nil {
                    LogInfo("[DEBUG-SPAWN] C2 crop_carrot child: name=" + child2<Entity>.Name + " pos=" + child2<Transform>.Position + " active=" + child2<Entity>.ActiveSelf + " scale=" + child2<Transform>.Scale)
                } else {
                    LogInfo("[DEBUG-SPAWN] C2 crop_carrot: NO child found")
                }
            }

            if directCropTomato != nil {
                var child3 = GetChildByName(directCropTomato, directCropTomato<Entity>.Name)
                if child3 != nil {
                    LogInfo("[DEBUG-SPAWN] C3 crop_tomato child: name=" + child3<Entity>.Name + " pos=" + child3<Transform>.Position + " active=" + child3<Entity>.ActiveSelf + " scale=" + child3<Transform>.Scale)
                } else {
                    LogInfo("[DEBUG-SPAWN] C3 crop_tomato: NO child found")
                }
            }

            LogInfo("[DEBUG-SPAWN] === TEST COMPLETE ===")
        }
    }

    async func TestPerformance() {
        if debugCfg.Core() { LogInfo("[GameManager] === PERFORMANCE TEST START ===") }

        var floorCount = list.Length(_AllFloorsInWorld)
        var totalCells = 0
        var batchCount = 0

        for i = 0, floorCount, 1 {
            var floor = _AllFloorsInWorld[i]
            if floor == nil || floor<gardenData> == nil { continue }

            for s = 0, 6, 1 {
                var key = floor<gardenData>.SlotKeyFromIndex(s)
                var cs = floor<gardenData>.GetCropSlotByKey(key)
                if cs == nil { continue }

                cs<cropSlot>.PlantedSeed = "seed_apple"
                cs<cropSlot>.PotTier = 1
                cs<cropSlot>.CellState = gen.EFarmSlotState.CropReady

                DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floor, key, gen.EFarmSlotState.PotReady})
                DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floor, key, gen.EFarmSlotState.CropReady})

                totalCells = totalCells + 1
                batchCount = batchCount + 1

                if batchCount >= 10 {
                    WaitForMillisecond(100)
                    batchCount = 0
                }
            }

            if debugCfg.Core() { LogInfo("[GameManager] Floor " + i + " filled. Running total: " + totalCells) }
            WaitForMillisecond(50)
        }

        if debugCfg.Core() { LogInfo("[GameManager] === PERFORMANCE TEST DONE === Floors=" + floorCount + " TotalCells=" + totalCells) }
    }
}