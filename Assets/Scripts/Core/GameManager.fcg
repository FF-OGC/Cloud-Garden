import "StdLibrary.fcc" as std
import "Player.fcc" as Player
import "List.fcc" as list
import "EditorGenLib.fcc" as gen
import "Math.fcc" as math
import "Convert.fcc" as convert

import "../Farming/FarmZoneManager.fcg" as zoneManager
import "../Grid/FloorGridData.fcg" as floorData
import "../Farming/PlayerFarmingData.fcg" as playerFarmingData
import "../Grid/TrackerPoolManager.fcg" as trackerPool
import "../Farming/CropGrowthManager.fcg" as cropManager
import "../Farming/CropVisualPool.fcg" as cropPool
import "../Backpack/BackpackManager.fcg" as backpackManager
import "../Market/MarketManager.fcg" as marketManager
import "../Currency/CurrencyManager.fcg" as currencyManager
import "../Store/StoreManager.fcg" as storeManager
import "../Config/FarmGridConfig.fcg" as gridCfg
import "../Services/Utils/GridUtil.fcg" as gridUtil
import "LevelObject.fcc" as LevelObject
[platform_server]
static graph GameManager {
    
    _IsDebug bool = false
    _GameTime float = 0.0
    _IsTickStarted bool = false
    
    // Dynamically populated at runtime by FarmZoneRegister. No Editor setup needed!
    _FarmZones List<entity<Entity>> = nil
    _AllFloorsInWorld List<entity<Entity>> = nil
    _ConnectedPlayers List<entity<Player>> = nil

    func IsDebug() bool { return _IsDebug }
    func GetGameTime() float { return _GameTime }

    event OnAwake() {
        _GameTime = 0.0
        
        // Initialize empty lists to receive data dynamically
        _FarmZones = list.New(0, 10) as List<entity<Entity>>
        _AllFloorsInWorld = list.New(0, 10) as List<entity<Entity>>
        _ConnectedPlayers = list.New(0, 10) as List<entity<Player>>
        
        trackerPool.InitPool()
        cropPool.InitPool()
        start StartGlobalClock()
        start DelayedStoreInit()
    }
    
    async func StartGlobalClock() {
        while true {
            WaitForMillisecond(1000) 
            _GameTime = _GameTime + 1.0
        }

        
    }

    async func DelayedStoreInit() {
        WaitForMillisecond(1000)
        storeManager.InitRestock()
    }

    func RegisterZone(zoneObj entity<Entity>) {
        
        if zoneObj == nil { return }
        
        list.Append(_FarmZones, zoneObj)
        zoneManager.InitializeZone(zoneObj)
        
        // Collect floors
        if zoneObj<FarmZoneData> != nil {
            if zoneObj<FarmZoneData>.Floors != nil {
                var fCount = list.Length(zoneObj<FarmZoneData>.Floors)
                for j = 0, fCount, 1 { list.Append(_AllFloorsInWorld, zoneObj<FarmZoneData>.Floors[j]) }
            }
        }

        // Register linked market stall (delayed to ensure MarketRuntimeData.OnAwake has fired)
        if zoneObj<FarmZoneData> != nil && zoneObj<FarmZoneData>.Market != nil {
            start DelayedMarketRegister(zoneObj<FarmZoneData>.Market, zoneObj)
        }
        
        // Start the background growth tick only once when the first zone registers
        if !_IsTickStarted {
            start cropManager.StartBackgroundTick(_AllFloorsInWorld)
            _IsTickStarted = true
        }
        
        if _IsDebug { LogInfo("[GameManager] Successfully registered new Farm Zone dynamically.") }
    }

    async func DelayedMarketRegister(marketEntity entity<Entity>, farmZone entity<Entity>) {
        WaitForMillisecond(500)
        marketManager.RegisterMarket(marketEntity, farmZone)
    }

    func GetConnectedPlayers() List<entity<Player>> { return _ConnectedPlayers }

    event OnUserQuitOrUserMatchEnd(player entity<Player>) {
        if player == nil { return }
        var idx = list.IndexOf(_ConnectedPlayers, player)
        if idx != -1 { list.Remove(_ConnectedPlayers, idx) }
        if _IsDebug { LogInfo("[GameManager] Player left. Connected: " + list.Length(_ConnectedPlayers)) }
    }

    event OnPlayerJoin(player entity<Player>) {
        list.Append(_ConnectedPlayers, player)
        if _IsDebug { LogInfo("[GameManager] Player joined. Connected: " + list.Length(_ConnectedPlayers)) }

        // Freeze player immediately to prevent falling before teleport
        player<Player>.RunSpeedScale = 0.0
        player<Player>.DisableFallDamage = true

        start WaitAndInitPlayer(player)
    }

    async func WaitAndInitPlayer(player entity<Player>) {
        // Wait until at least one farm zone has registered
        var maxWait = 30
        var waited = 0
        while list.Length(_FarmZones) == 0 && waited < maxWait {
            WaitForMillisecond(500)
            waited = waited + 1
        }

        if list.Length(_FarmZones) == 0 {
            LogWarning("[GameManager] Timeout: No farm zones registered!")
            player<Player>.RunSpeedScale = 1.0
            return
        }

        LogInfo("[GameManager] Zones registered after " + (waited * 500) + "ms. FarmZones: " + list.Length(_FarmZones))

        var zCount = list.Length(_FarmZones)
        var assignedZone entity<Entity> = nil
        
        // 1. Check session ownership
        for i = 0, zCount, 1 {
            var zone = _FarmZones[i]
            if zone != nil && zone<gen.FarmZoneData> != nil && zone<gen.FarmZoneData>.Owner == player {
                assignedZone = zone
                break
            }
        }
        
        // 2. Assign unclaimed land
        if assignedZone == nil {
            for i = 0, zCount, 1 {
                var zone = _FarmZones[i]
                if zone != nil && zone<gen.FarmZoneData> != nil && zone<gen.FarmZoneData>.Owner == nil {
                    
                    zone<gen.FarmZoneData>.Owner = player
                    var floors = zone<FarmZoneData>.Floors
                    
                    if floors != nil {
                        var fCount = list.Length(floors)
                        for j = 0, fCount, 1 { 
                            if floors[j]<floorData> != nil { floors[j]<floorData>.Owner = player }
                        }
                    }
                    assignedZone = zone
                    marketManager.AssignMarketOwner(zone, player)
                    if _IsDebug { LogInfo("[GameManager] Assigned new Farm Zone + Market to player.") }
                    break
                }
            }
        }
        
        // 3. Teleport to the left of customer queue, facing market
        if assignedZone != nil {
            var market = assignedZone<FarmZoneData>.Market
            if market != nil {
                // Poll until market Transform is actually loaded (position != 0,0,0)
                var posWait = 0
                var mPos = market<Transform>.Position
                while mPos.X == 0.0 && mPos.Y == 0.0 && mPos.Z == 0.0 && posWait < 20 {
                    WaitForMillisecond(500)
                    posWait = posWait + 1
                    mPos = market<Transform>.Position
                }

                if mPos.X == 0.0 && mPos.Y == 0.0 && mPos.Z == 0.0 {
                    LogWarning("[GameManager] Market position still (0,0,0) after polling, using zone fallback")
                    var spawnPos = assignedZone<Transform>.Position
                    Teleport(player, Vector3{spawnPos.X + 5.0, spawnPos.Y, spawnPos.Z}, Vector3{0.0, 0.0, 0.0})
                } else {
                    var rotY = market<Transform>.Rotation.Y
                    var c = math.Cos(rotY)
                    var s = math.Sin(rotY)
                    // Local offset: left of queue (-X), in front of market (-Z)
                    var localOff = Vector3{-3.0, 0.0, -4.0}
                    var ox = localOff.X * c + localOff.Z * s
                    var oz = -localOff.X * s + localOff.Z * c
                    var spawnPos = Vector3{mPos.X + ox, mPos.Y, mPos.Z + oz}
                    var facing = GetPlayerOrientation(spawnPos, mPos)
                    Teleport(player, spawnPos, facing)
                    if _IsDebug { LogInfo("[GameManager] Teleported player (market loaded after " + (posWait * 500) + "ms extra)") }
                }
            } else {
                var spawnPos = assignedZone<Transform>.Position
                Teleport(player, Vector3{spawnPos.X + 5.0, spawnPos.Y, spawnPos.Z}, Vector3{0.0, 0.0, 0.0})
            }
        }

        // 4. Add Seed to Backpack
        var seedId = "seed_apple"
        var amount = 50
        if(backpackManager.AddItem(player, seedId, amount)) {
            if _IsDebug { LogInfo("[GameManager] Added seed to backpack.") }
        }
        backpackManager.AddItem(player, "crop_apple_gold", 1)

        currencyManager.InitPlayerCurrency(player, 500)

        // Unfreeze player after everything is ready
        player<Player>.RunSpeedScale = 1.0
        if _IsDebug { LogInfo("[GameManager] Player fully initialized and unfrozen.") }
    }

    func GetPlayerOrientation(spawnPoint Vector3, centerPoint Vector3) Vector3 {
        var orientation Vector3 = math.Normalize(Vector3{centerPoint.X - spawnPoint.X, 0, centerPoint.Z - spawnPoint.Z})
        return orientation
    }

    async func TestPerformance() {
        LogInfo("[GameManager] === PERFORMANCE TEST START ===")

        var floorCount = list.Length(_AllFloorsInWorld)
        var tileSize = gridCfg.GetTileSize()
        var totalCells = 0
        var batchCount = 0

        for i = 0, floorCount, 1 {
            var floor = _AllFloorsInWorld[i]
            if floor == nil || floor<floorData> == nil { continue }

            var scale = floor<Transform>.Scale.X
            var halfGridCount = math.Floor((scale / tileSize) / 2.0)

            for x = -halfGridCount, halfGridCount + 1, 1 {
                for z = -halfGridCount, halfGridCount + 1, 1 {
                    var worldX = convert.IntToFloat(x) * tileSize
                    var worldZ = convert.IntToFloat(z) * tileSize
                    var pos = Vector3{worldX, 0.0, worldZ}
                    var key = gridUtil.GetKeyFromPos(pos)

                    floor<floorData>.CellStates[key] = gen.EFarmSlotState.ReadyToHarvest
                    floor<floorData>.PlantedSeeds[key] = "seed_apple"
                    floor<floorData>.SoilTiers[key] = 1

                    DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floor, pos, gen.EFarmSlotState.Tilled})
                    DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floor, pos, gen.EFarmSlotState.ReadyToHarvest})

                    totalCells = totalCells + 1
                    batchCount = batchCount + 1

                    if batchCount >= 10 {
                        WaitForMillisecond(100)
                        batchCount = 0
                    }
                }
            }

            LogInfo("[GameManager] Floor " + i + " filled. Running total: " + totalCells)
            WaitForMillisecond(50)
        }

        LogInfo("[GameManager] === PERFORMANCE TEST DONE === Floors=" + floorCount + " TotalCells=" + totalCells)
    }
}