import "StdLibrary.fcc" as std
import "Physics.fcc" as physics
import "EditorGenLib.fcc" as gen

import "../Core/GameManager.fcg" as gameMgr
import "../Config/DebugConfig.fcg" as debugCfg
import "./TrackerPoolManager.fcg" as poolManager
import "../Farming/PlayerFarmingData.fcg" as playerFarmingData
import "../Config/FarmGridConfig.fcg" as gridCfg
import "../Services/Utils/GridUtil.fcg" as gridUtil

[platform_server]
graph GridTrigger {
    _Floor entity<Entity> = nil

    event OnAwake() { 
        _Floor = thisEntity<Transform>.Parent
        if debugCfg.Grid() { LogInfo("[GridTrigger] Initialized. Parent floor: " + _Floor<Entity>.Name) }
    }

    event OnTriggerEnter(target entity<Entity>) {
        var player = target as entity<Player>
        
        if player == nil || _Floor == nil { return }
        
        if player<playerFarmingData> == nil {
            if debugCfg.Grid() { LogInfo("[GridTrigger] Player is not have component PlayerFarmingData.") }
            return
        }

        player<playerFarmingData>.CurrentFloor = _Floor
        if debugCfg.Grid() { LogInfo("[GridTrigger] Player entered floor: " + _Floor<Entity>.Name) }

        if player<playerFarmingData>.ActiveTracker == nil {
            player<playerFarmingData>.ActiveTracker = poolManager.GetTracker(player)
            if debugCfg.Grid() { LogInfo("[GridTrigger] Tracker assigned from pool.") }
        }

        var floorPos = _Floor<Transform>.Position
        var playerPos = player<Player>.Position
        var tileSize = gridCfg.GetTileSize()
        var snapped = gridUtil.SnapToGrid(playerPos, floorPos, tileSize)
        var localPos = Vector3{snapped.X - floorPos.X, 0.0, snapped.Z - floorPos.Z}
        var floorScale = _Floor<Transform>.Scale.X
        localPos = gridUtil.ClampToGridBounds(localPos, floorScale, tileSize)
        player<playerFarmingData>.CurrentGridPos = localPos
        if debugCfg.Grid() { LogInfo("[GridTrigger] Initial grid pos set to: " + localPos) }

        DispatchEventToEntity(OnPlayerEnterFloor, player, PlatformType.Server, List<object>{player, _Floor})
    }

    event OnTriggerLeave(target entity<Entity>) {
        var player = target as entity<Player>
        if player == nil || _Floor == nil { return }
        
        if player<playerFarmingData>.CurrentFloor != _Floor { return }

        if player<playerFarmingData>.ActiveTracker != nil {
            poolManager.ReturnTracker(player<playerFarmingData>.ActiveTracker)
            player<playerFarmingData>.ActiveTracker = nil
            if debugCfg.Grid() { LogInfo("[GridTrigger] Tracker returned to pool.") }
        }
        player<playerFarmingData>.CurrentFloor = nil
        if debugCfg.Grid() { LogInfo("[GridTrigger] Player left floor: " + _Floor<Entity>.Name) }

        DispatchEventToEntity(OnPlayerLeaveFloor, player, PlatformType.Server, List<object>{player})
    }
}