import "StdLibrary.fcc" as std
import "Map.fcc" as map
import "List.fcc" as list

[platform_server]
graph FloorGridData {
    // --- OWNERSHIP DATA ---
    Owner entity<Entity>
    
    CellStates Map<string, int> 
    SoilTiers Map<string, int>   
    PlantedSeeds Map<string, string>

    HarvestTimes Map<string, float>   
    CropPositions Map<string, Vector3> 

    SoilVisuals Map<string, entity<Entity>>  
    PlantVisuals Map<string, entity<Entity>>
    PlantPrefabKeys Map<string, string>

    GachaResults Map<string, string>  
    LuckyDirtCells Map<string, bool>

    FertilizedCells Map<string, bool>
    FertilizerLuckBonus Map<string, int>
    FertilizerGrowthReduction Map<string, float>

    GrowingKeys List<string>

    func InitMaps() {
        Owner = nil
        
        CellStates = map.New() as Map<string, int>
        SoilTiers = map.New() as Map<string, int>
        PlantedSeeds = map.New() as Map<string, string>

        HarvestTimes = map.New() as Map<string, float>
        CropPositions = map.New() as Map<string, Vector3>
        
        SoilVisuals = map.New() as Map<string, entity<Entity>>
        PlantVisuals = map.New() as Map<string, entity<Entity>>
        PlantPrefabKeys = map.New() as Map<string, string>

        GachaResults = map.New() as Map<string, string>
        LuckyDirtCells = map.New() as Map<string, bool>

        FertilizedCells = map.New() as Map<string, bool>
        FertilizerLuckBonus = map.New() as Map<string, int>
        FertilizerGrowthReduction = map.New() as Map<string, float>

        GrowingKeys = list.New(0, 100) as List<string>
    }

    // --- DATA-LEVEL OWNERSHIP VALIDATION ---
    func IsOwner(player entity<Entity>) bool {
        if Owner == nil { return false }
        return Owner == player
    }

    func TryModifyCell(key string, newState int, player entity<Entity>) bool {
        if !IsOwner(player) { return false }
        CellStates[key] = newState
        return true
    }

    func TrySetSoilTier(key string, tier int, player entity<Entity>) bool {
        if !IsOwner(player) { return false }
        SoilTiers[key] = tier
        return true
    }

    func TryPlantCrop(key string, seedId string, harvestTime float, cropPos Vector3, player entity<Entity>) bool {
        if !IsOwner(player) { return false }
        PlantedSeeds[key] = seedId
        HarvestTimes[key] = harvestTime
        CropPositions[key] = cropPos
        list.Append(GrowingKeys, key)
        return true
    }

    func TryUpdateHarvestTime(key string, newTime float, player entity<Entity>) bool {
        if !IsOwner(player) { return false }
        HarvestTimes[key] = newTime
        return true
    }

    func TrySetGachaResult(key string, cropId string) {
        GachaResults[key] = cropId
    }

    func TrySetLuckyDirt(key string, isLucky bool) {
        LuckyDirtCells[key] = isLucky
    }

    func IsLuckyDirt(key string) bool {
        if map.ContainKey(LuckyDirtCells, key) {
            return LuckyDirtCells[key] as bool
        }
        return false
    }

    func TryClearSoilVisual(key string) {
        if map.ContainKey(SoilVisuals, key) {
            var oldSoil = SoilVisuals[key] as entity
            if oldSoil != nil { Destroy(oldSoil) }
            map.Remove(SoilVisuals, key)
        }
        if map.ContainKey(LuckyDirtCells, key) { map.Remove(LuckyDirtCells, key) }
    }

    func TryClearCrop(key string, player entity<Entity>) bool {
        if !IsOwner(player) { return false }
        if map.ContainKey(HarvestTimes, key) { map.Remove(HarvestTimes, key) }
        if map.ContainKey(CropPositions, key) { map.Remove(CropPositions, key) }
        if map.ContainKey(PlantedSeeds, key) { map.Remove(PlantedSeeds, key) }
        if map.ContainKey(GachaResults, key) { map.Remove(GachaResults, key) }
        if map.ContainKey(LuckyDirtCells, key) { map.Remove(LuckyDirtCells, key) }
        if map.ContainKey(PlantPrefabKeys, key) { map.Remove(PlantPrefabKeys, key) }
        ClearFertilizer(key)
        var gkIdx = list.IndexOf(GrowingKeys, key)
        if gkIdx != -1 { list.RemoveAt(GrowingKeys, gkIdx) }
        return true
    }

    func IsFertilized(key string) bool {
        if map.ContainKey(FertilizedCells, key) {
            return FertilizedCells[key] as bool
        }
        return false
    }

    func TrySetFertilized(key string, luckBonus int, growthReduction float, player entity<Entity>) bool {
        if !IsOwner(player) { return false }
        FertilizedCells[key] = true
        FertilizerLuckBonus[key] = luckBonus
        FertilizerGrowthReduction[key] = growthReduction
        return true
    }

    func ClearFertilizer(key string) {
        if map.ContainKey(FertilizedCells, key) { map.Remove(FertilizedCells, key) }
        if map.ContainKey(FertilizerLuckBonus, key) { map.Remove(FertilizerLuckBonus, key) }
        if map.ContainKey(FertilizerGrowthReduction, key) { map.Remove(FertilizerGrowthReduction, key) }
    }
}