import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Convert.fcc" as convert

import "../Market/MarketRuntimeData.fcg" as marketData
import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg
import "../Config/ItemConfig.fcg" as itemCfg
import "../Config/MarketConfig.fcg" as marketCfg

[platform_server]
static graph MarketService {

    func GetStallLevel(market entity<Entity>) int {
        if market == nil || market<marketData> == nil { return 1 }
        market<marketData>.EnsureInit()
        var lv = market<marketData>._StallLevel as int
        if lv < 1 { return 1 }
        if lv > 3 { return 3 }
        return lv
    }

    func AddToTable(market entity<Entity>, itemId string, amount int) bool {
        return AddToTableWithMutation(market, itemId, amount, "")
    }

    // True if this item+mutation can be placed: merges into an existing stack, or a new row is allowed by stall level capacity.
    func _GetTableSlotCap(market entity<Entity>) int {
        var level = GetStallLevel(market) as int
        return marketCfg.GetTableStackCapacityForStallLevel(level) as int
    }

    func _IsTableSlotEmpty(market entity<Entity>, slot int) bool {
        if slot < 0 || slot >= 5 { return true }
        var iid = market<marketData>._TableItemIDs[slot] as string
        var amt = market<marketData>._TableItemAmounts[slot] as int
        if iid == "" { return true }
        if amt <= 0 { return true }
        return false
    }

    func CanAddToTableWithMutation(market entity<Entity>, itemId string, mutStr string) bool {
        if market == nil || market<marketData> == nil { return false }
        market<marketData>.EnsureInit()

        var cap = _GetTableSlotCap(market) as int
        // Merge into existing same stack (one slot only holds that pair).
        for s = 0, cap, 1 {
            if _IsTableSlotEmpty(market, s) { continue }
            if market<marketData>._TableItemIDs[s] as string != itemId { continue }
            var m = ""
            if s < list.Length(market<marketData>._TableMutations) {
                m = market<marketData>._TableMutations[s] as string
            }
            if m == mutStr { return true }
        }

        var used = 0
        for s = 0, cap, 1 {
            if !_IsTableSlotEmpty(market, s) { used = used + 1 }
        }
        if used >= cap {
            if debugCfg.Market() { LogInfo("[MarketService] CanAddToTable | FULL used=" + convert.ToString(used) + " cap=" + convert.ToString(cap)) }
            return false
        }
        return true
    }

    func AddToTableWithMutation(market entity<Entity>, itemId string, amount int, mutStr string) bool {
        if market == nil || amount <= 0 { return false }
        if market<marketData> == nil { return false }
        market<marketData>.EnsureInit()

        var cap = _GetTableSlotCap(market) as int

        for s = 0, cap, 1 {
            if _IsTableSlotEmpty(market, s) { continue }
            if market<marketData>._TableItemIDs[s] as string != itemId { continue }
            var m = ""
            if s < list.Length(market<marketData>._TableMutations) {
                m = market<marketData>._TableMutations[s] as string
            }
            if m != mutStr { continue }
            var current = market<marketData>._TableItemAmounts[s] as int
            market<marketData>._TableItemAmounts[s] = (current + amount) as int
            if debugCfg.Market() { LogInfo("[MarketService] AddToTable MERGE slot=" + convert.ToString(s) + " " + itemId + " mut=" + mutStr) }
            return true
        }

        if !CanAddToTableWithMutation(market, itemId, mutStr) {
            return false
        }

        for s = 0, cap, 1 {
            if !_IsTableSlotEmpty(market, s) { continue }
            market<marketData>._TableItemIDs[s] = itemId as string
            market<marketData>._TableItemAmounts[s] = amount as int
            if s < list.Length(market<marketData>._TableMutations) {
                market<marketData>._TableMutations[s] = mutStr as string
            }
            if debugCfg.Market() { LogInfo("[MarketService] AddToTable NEW slot=" + convert.ToString(s) + " " + itemId + " mut=" + mutStr) }
            return true
        }
        return false
    }

    // Gold for removing `amount` of itemId across fixed slots (slot order 0..4).
    func ComputeGoldForRemoval(market entity<Entity>, itemId string, amount int) int {
        if market == nil || amount <= 0 { return 0 }
        if market<marketData> == nil { return 0 }
        market<marketData>.EnsureInit()

        var remaining = amount
        var totalGold = 0
        for s = 0, 5, 1 {
            if remaining <= 0 { break }
            if market<marketData>._TableItemIDs[s] as string != itemId { continue }
            var current = market<marketData>._TableItemAmounts[s] as int
            var mut = ""
            if s < list.Length(market<marketData>._TableMutations) {
                mut = market<marketData>._TableMutations[s] as string
            }
            var unit = itemCfg.GetMarketUnitSellPrice(itemId, mut)
            if current <= remaining {
                totalGold = totalGold + (unit * current)
                remaining = remaining - current
            } else {
                totalGold = totalGold + (unit * remaining)
                remaining = 0
            }
        }
        return totalGold
    }

    // Amount on the single table slot that holds this itemId + mutation (fixed-slot table).
    func GetTableAmountForMutation(market entity<Entity>, itemId string, mutStr string) int {
        if market == nil || market<marketData> == nil { return 0 }
        market<marketData>.EnsureInit()
        for s = 0, 5, 1 {
            if market<marketData>._TableItemIDs[s] as string != itemId { continue }
            var m = ""
            if s < list.Length(market<marketData>._TableMutations) {
                m = market<marketData>._TableMutations[s] as string
            }
            if m == mutStr {
                return market<marketData>._TableItemAmounts[s] as int
            }
        }
        return 0
    }

    func ComputeGoldForRemovalForMutation(market entity<Entity>, itemId string, mutStr string, amount int) int {
        if market == nil || amount <= 0 { return 0 }
        if market<marketData> == nil { return 0 }
        market<marketData>.EnsureInit()
        var rowAmt = GetTableAmountForMutation(market, itemId, mutStr) as int
        if rowAmt <= 0 { return 0 }
        var take = amount
        if take > rowAmt { take = rowAmt as int }
        var unit = itemCfg.GetMarketUnitSellPrice(itemId, mutStr)
        return (unit * take) as int
    }

    func RemoveFromTableWithMutation(market entity<Entity>, itemId string, mutStr string, amount int) bool {
        if market == nil || amount <= 0 { return false }
        if market<marketData> == nil { return false }
        market<marketData>.EnsureInit()
        for s = 0, 5, 1 {
            if market<marketData>._TableItemIDs[s] as string != itemId { continue }
            var m = ""
            if s < list.Length(market<marketData>._TableMutations) {
                m = market<marketData>._TableMutations[s] as string
            }
            if m != mutStr { continue }
            var current = market<marketData>._TableItemAmounts[s] as int
            var take = amount
            if take > current { take = current as int }
            if take <= 0 { return false }
            if take >= current {
                market<marketData>._TableItemIDs[s] = "" as string
                market<marketData>._TableItemAmounts[s] = 0 as int
                if s < list.Length(market<marketData>._TableMutations) {
                    market<marketData>._TableMutations[s] = "" as string
                }
            } else {
                market<marketData>._TableItemAmounts[s] = current - take
            }
            if debugCfg.Market() { LogInfo("[MarketService] RemoveFromTableWithMutation slot=" + convert.ToString(s) + " " + itemId + " mut=" + mutStr + " -" + convert.ToString(take)) }
            return true
        }
        return false
    }

    func GetSellableTableRowCount(market entity<Entity>) int {
        if market == nil || market<marketData> == nil { return 0 }
        market<marketData>.EnsureInit()
        var cap = _GetTableSlotCap(market) as int
        var nRows = 0
        for s = 0, cap, 1 {
            if _IsTableSlotEmpty(market, s) { continue }
            var iid = market<marketData>._TableItemIDs[s] as string
            if !marketCfg.IsSellable(iid) { continue }
            nRows = nRows + 1
        }
        return nRows
    }

    // Returns physical table slot index 0..4 (only scans slots unlocked by stall level).
    func GetNthSellableTableRowIndex(market entity<Entity>, ordinal int) int {
        if market == nil || market<marketData> == nil { return -1 }
        if ordinal < 0 { return -1 }
        market<marketData>.EnsureInit()
        var cap = _GetTableSlotCap(market) as int
        var seen = 0
        for s = 0, cap, 1 {
            if _IsTableSlotEmpty(market, s) { continue }
            var iid = market<marketData>._TableItemIDs[s] as string
            if !marketCfg.IsSellable(iid) { continue }
            if seen == ordinal { return s }
            seen = seen + 1
        }
        return -1
    }

    func RemoveFromTable(market entity<Entity>, itemId string, amount int) bool {
        return RemoveFromTableAny(market, itemId, amount)
    }

    func RemoveFromTableAny(market entity<Entity>, itemId string, amount int) bool {
        if market == nil || amount <= 0 { return false }
        if market<marketData> == nil { return false }
        market<marketData>.EnsureInit()

        var remaining = amount
        for s = 0, 5, 1 {
            if remaining <= 0 { break }
            if market<marketData>._TableItemIDs[s] as string != itemId { continue }
            var current = market<marketData>._TableItemAmounts[s] as int
            if current <= remaining {
                remaining = remaining - current
                market<marketData>._TableItemIDs[s] = "" as string
                market<marketData>._TableItemAmounts[s] = 0 as int
                if s < list.Length(market<marketData>._TableMutations) {
                    market<marketData>._TableMutations[s] = "" as string
                }
            } else {
                market<marketData>._TableItemAmounts[s] = current - remaining
                remaining = 0
            }
        }
        if debugCfg.Market() { LogInfo("[MarketService] RemoveFromTableAny | " + itemId + " rem=" + convert.ToString(remaining)) }
        return remaining < amount
    }

    func GetTableAmount(market entity<Entity>, itemId string) int {
        if market == nil { return 0 }
        if market<marketData> == nil { return 0 }
        market<marketData>.EnsureInit()

        var total = 0
        for s = 0, 5, 1 {
            if market<marketData>._TableItemIDs[s] as string == itemId {
                total = total + (market<marketData>._TableItemAmounts[s] as int)
            }
        }
        return total
    }

    func GetTableMutationAtIndex(market entity<Entity>, slotIndex int) string {
        if market == nil { return "" }
        if market<marketData> == nil { return "" }
        if slotIndex < 0 || slotIndex >= 5 { return "" }
        if slotIndex >= list.Length(market<marketData>._TableMutations) { return "" }
        return market<marketData>._TableMutations[slotIndex] as string
    }

    func SetCustomer(market entity<Entity>, slot int, id int, itemId string, amount int, mutStr string) {
        if market == nil { return }
        if market<marketData> == nil || slot < 0 || slot >= 5 { return }
        market<marketData>.EnsureInit()

        market<marketData>._QueueCustomerIDs[slot] = id as int
        market<marketData>._QueueItemIDs[slot] = itemId as string
        market<marketData>._QueueItemAmounts[slot] = amount as int
        if market<marketData>._QueueItemMutations != nil && slot < list.Length(market<marketData>._QueueItemMutations) {
            market<marketData>._QueueItemMutations[slot] = mutStr as string
        }
        if debugCfg.Market() { LogInfo("[MarketService] SetCustomer | slot=" + convert.ToString(slot) + " id=" + convert.ToString(id) + " wants " + convert.ToString(amount) + "x " + itemId + " mut=" + mutStr) }
    }

    func ClearCustomer(market entity<Entity>, slot int) {
        if market == nil { return }
        if market<marketData> == nil || slot < 0 || slot >= 5 { return }

        market<marketData>._QueueCustomerIDs[slot] = -1 as int
        market<marketData>._QueueItemIDs[slot] = "" as string
        market<marketData>._QueueItemAmounts[slot] = 0 as int
        if market<marketData>._QueueItemMutations != nil && slot < list.Length(market<marketData>._QueueItemMutations) {
            market<marketData>._QueueItemMutations[slot] = "" as string
        }
    }

    func ShiftQueueForward(market entity<Entity>) {
        if market == nil { return }
        if market<marketData> == nil { return }
        market<marketData>.EnsureInit()

        for i = 1, 5, 1 {
            var cid = market<marketData>._QueueCustomerIDs[i] as int
            var citem = market<marketData>._QueueItemIDs[i] as string
            var camt = market<marketData>._QueueItemAmounts[i] as int
            var cmut = ""
            if market<marketData>._QueueItemMutations != nil && i < list.Length(market<marketData>._QueueItemMutations) {
                cmut = market<marketData>._QueueItemMutations[i] as string
            }
            var cnpc = market<marketData>._SlotNPCs[i] as entity<Entity>

            var prevSlot = (i - 1) as int
            market<marketData>._QueueCustomerIDs[prevSlot] = cid as int
            market<marketData>._QueueItemIDs[prevSlot] = citem as string
            market<marketData>._QueueItemAmounts[prevSlot] = camt as int
            if market<marketData>._QueueItemMutations != nil && prevSlot < list.Length(market<marketData>._QueueItemMutations) {
                market<marketData>._QueueItemMutations[prevSlot] = cmut as string
            }
            market<marketData>._SlotNPCs[prevSlot] = cnpc
        }
        ClearCustomer(market, 4)
        market<marketData>._SlotNPCs[4] = nil
        if debugCfg.Market() { LogInfo("[MarketService] ShiftQueueForward | Queue shifted") }
    }

    func IsSlotEmpty(market entity<Entity>, slot int) bool {
        if market == nil { return true }
        if market<marketData> == nil { return true }
        if slot < 0 || slot >= 5 { return true }
        var slotId = market<marketData>._QueueCustomerIDs[slot] as int
        return slotId == -1
    }

    func GetOccupiedSlotCount(market entity<Entity>) int {
        if market == nil { return 0 }
        if market<marketData> == nil { return 0 }

        var count = 0
        for i = 0, 5, 1 {
            var slotId = market<marketData>._QueueCustomerIDs[i] as int
            if slotId != -1 {
                count = (count + 1) as int
            }
        }
        return count
    }
}
