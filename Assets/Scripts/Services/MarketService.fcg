import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Convert.fcc" as convert

import "../Market/MarketRuntimeData.fcg" as marketData
import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph MarketService {

    func AddToTable(market entity<Entity>, itemId string, amount int) {
        AddToTableWithMutation(market, itemId, amount, "")
    }

    func AddToTableWithMutation(market entity<Entity>, itemId string, amount int, mutStr string) {
        if market == nil || amount <= 0 { return }
        if market<marketData> == nil { return }
        market<marketData>.EnsureInit()

        // Find existing entry matching both itemId and mutStr
        var count = list.Length(market<marketData>._TableItemIDs)
        var foundIndex = -1
        for i = 0, count, 1 {
            if market<marketData>._TableItemIDs[i] as string == itemId {
                var existingMut = ""
                if i < list.Length(market<marketData>._TableMutations) {
                    existingMut = market<marketData>._TableMutations[i] as string
                }
                if existingMut == mutStr {
                    foundIndex = i
                    break
                }
            }
        }

        if foundIndex != -1 {
            var current = market<marketData>._TableItemAmounts[foundIndex] as int
            var newTotal = (current + amount) as int
            market<marketData>._TableItemAmounts[foundIndex] = newTotal
            if debugCfg.Market() { LogInfo("[MarketService] AddToTable | " + itemId + " mut=" + mutStr + " +" + convert.ToString(amount) + " total=" + convert.ToString(newTotal)) }
        } else {
            list.Append(market<marketData>._TableItemIDs, itemId)
            list.Append(market<marketData>._TableItemAmounts, amount)
            list.Append(market<marketData>._TableMutations, mutStr)
            if debugCfg.Market() { LogInfo("[MarketService] AddToTable | NEW " + itemId + " mut=" + mutStr + " amount=" + convert.ToString(amount)) }
        }
    }

    func RemoveFromTable(market entity<Entity>, itemId string, amount int) bool {
        return RemoveFromTableAny(market, itemId, amount)
    }

    func RemoveFromTableAny(market entity<Entity>, itemId string, amount int) bool {
        if market == nil || amount <= 0 { return false }
        if market<marketData> == nil { return false }
        market<marketData>.EnsureInit()

        var remaining = amount
        var count = list.Length(market<marketData>._TableItemIDs)
        var i = 0
        while i < count && remaining > 0 {
            if market<marketData>._TableItemIDs[i] as string == itemId {
                var current = market<marketData>._TableItemAmounts[i] as int
                if current <= remaining {
                    remaining = remaining - current
                    list.RemoveAt(market<marketData>._TableItemIDs, i)
                    list.RemoveAt(market<marketData>._TableItemAmounts, i)
                    list.RemoveAt(market<marketData>._TableMutations, i)
                    count = count - 1
                } else {
                    market<marketData>._TableItemAmounts[i] = current - remaining
                    remaining = 0
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        }
        if debugCfg.Market() { LogInfo("[MarketService] RemoveFromTable | " + itemId + " -" + convert.ToString(amount) + " rem=" + convert.ToString(remaining)) }
        return remaining < amount
    }

    func GetTableAmount(market entity<Entity>, itemId string) int {
        if market == nil { return 0 }
        if market<marketData> == nil { return 0 }
        market<marketData>.EnsureInit()

        var total = 0
        var count = list.Length(market<marketData>._TableItemIDs)
        for i = 0, count, 1 {
            if market<marketData>._TableItemIDs[i] as string == itemId {
                total = total + (market<marketData>._TableItemAmounts[i] as int)
            }
        }
        return total
    }

    func GetTableMutationAtIndex(market entity<Entity>, index int) string {
        if market == nil { return "" }
        if market<marketData> == nil { return "" }
        if index < 0 || index >= list.Length(market<marketData>._TableMutations) { return "" }
        return market<marketData>._TableMutations[index] as string
    }

    func SetCustomer(market entity<Entity>, slot int, id int, itemId string, amount int) {
        if market == nil { return }
        if market<marketData> == nil || slot < 0 || slot >= 5 { return }
        market<marketData>.EnsureInit()

        market<marketData>._QueueCustomerIDs[slot] = id as int
        market<marketData>._QueueItemIDs[slot] = itemId as string
        market<marketData>._QueueItemAmounts[slot] = amount as int
        if debugCfg.Market() { LogInfo("[MarketService] SetCustomer | slot=" + convert.ToString(slot) + " id=" + convert.ToString(id) + " wants " + convert.ToString(amount) + "x " + itemId) }
    }

    func ClearCustomer(market entity<Entity>, slot int) {
        if market == nil { return }
        if market<marketData> == nil || slot < 0 || slot >= 5 { return }

        market<marketData>._QueueCustomerIDs[slot] = -1 as int
        market<marketData>._QueueItemIDs[slot] = "" as string
        market<marketData>._QueueItemAmounts[slot] = 0 as int
    }

    func ShiftQueueForward(market entity<Entity>) {
        if market == nil { return }
        if market<marketData> == nil { return }
        market<marketData>.EnsureInit()

        for i = 1, 5, 1 {
            var cid = market<marketData>._QueueCustomerIDs[i] as int
            var citem = market<marketData>._QueueItemIDs[i] as string
            var camt = market<marketData>._QueueItemAmounts[i] as int
            var cnpc = market<marketData>._SlotNPCs[i] as entity<Entity>

            var prevSlot = (i - 1) as int
            market<marketData>._QueueCustomerIDs[prevSlot] = cid as int
            market<marketData>._QueueItemIDs[prevSlot] = citem as string
            market<marketData>._QueueItemAmounts[prevSlot] = camt as int
            market<marketData>._SlotNPCs[prevSlot] = cnpc
        }
        ClearCustomer(market, 4)
        market<marketData>._SlotNPCs[4] = nil
        if debugCfg.Market() { LogInfo("[MarketService] ShiftQueueForward | Queue shifted") }
    }

    func IsSlotEmpty(market entity<Entity>, slot int) bool {
        if market == nil { return true }
        if market<marketData> == nil { return true }
        if slot < 0 || slot >= 5 { return true }
        var slotId = market<marketData>._QueueCustomerIDs[slot] as int
        return slotId == -1
    }

    func GetOccupiedSlotCount(market entity<Entity>) int {
        if market == nil { return 0 }
        if market<marketData> == nil { return 0 }

        var count = 0
        for i = 0, 5, 1 {
            var slotId = market<marketData>._QueueCustomerIDs[i] as int
            if slotId != -1 {
                count = (count + 1) as int
            }
        }
        return count
    }

    func GetItemsWithStock(market entity<Entity>) List<string> {
        var result = list.New(0, 5) as List<string>
        if market == nil { return result }
        if market<marketData> == nil { return result }
        market<marketData>.EnsureInit()

        var count = list.Length(market<marketData>._TableItemIDs) as int
        for i = 0, count, 1 {
            var amount = market<marketData>._TableItemAmounts[i] as int
            if amount > 0 {
                var itemId = market<marketData>._TableItemIDs[i] as string
                list.Append(result, itemId)
            }
        }
        return result
    }
}
