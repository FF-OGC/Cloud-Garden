import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Math.fcc" as math
import "Convert.fcc" as convert

import "../Config/FloorConfig.fcg" as floorCfg

[platform_server]
static graph FloorManager {
    
    func SnapFloorsToConfig(zoneObj entity<Entity>, floors List<entity<Entity>>) {
        if floors == nil { return }

        var floorCount = list.Length(floors)
        if floorCount <= 1 { return }

        var baseX = floorCfg.GetBaseX()
        var baseY = floorCfg.GetBaseY()
        var baseZ = floorCfg.GetBaseZ()
        var baseRotY = floorCfg.GetBaseRotY()
        var heightStep = floorCfg.GetHeightStep()
        var angleStep = floorCfg.GetAngleStep()

        for i = 1, floorCount, 1 {
            var floorObj = floors[i]

            var angle = angleStep * convert.IntToFloat(i)
            var cosA = math.Cos(angle)
            var sinA = math.Sin(angle)

            var newX = baseX * cosA - baseZ * sinA
            var newZ = baseX * sinA + baseZ * cosA
            var newY = baseY + heightStep * convert.IntToFloat(i)

            floorObj<Transform>.LocalPosition = Vector3{newX, newY, newZ}
            floorObj<Transform>.LocalRotation = Vector3{0.0, baseRotY - angle, 0.0}
        }
    }
}