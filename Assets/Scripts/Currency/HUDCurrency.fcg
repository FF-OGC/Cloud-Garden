import "StdLibrary.fcc" as std
import "Hud.fcc" as hud
import "Convert.fcc" as convert
import "EditorGenLib.fcc" as gen
import "Math.fcc" as math

import "./PlayerCurrencyVisual.fcg" as playerCurrencyVisual
import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
graph HUDCurrency {

    _MenuUI entity<CustomUI> = nil
    _CoinIcon entity<UIWidget> = nil
    _CoinNum entity<UIWidget> = nil

    _DisplayedBalance int = 0
    _TargetBalance int = 0
    _IsAnimating bool = false

    event OnAwake() {
        CreateCustomUI(out var uiInstance, thisEntity<Player>, EResUI.menu)
        if uiInstance != nil {
            _MenuUI = uiInstance
            _CoinIcon = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/coin/icon")
            _CoinNum = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/coin/num")

            if _CoinNum != nil {
                _CoinNum<UIWidgetLabel>.Content = "0"
            }
            if debugCfg.Currency() { LogInfo("[HUDCurrency] OnAwake | UI created, icon=" + convert.ToString(_CoinIcon != nil) + " num=" + convert.ToString(_CoinNum != nil)) }
        } else {
            if debugCfg.Currency() { LogWarning("[HUDCurrency] OnAwake | FAILED to create Menu UI") }
        }
    }

    event OnCurrencySync(player entity<Player>, balance int) {
        if player != thisEntity<Player> { return }
        if debugCfg.Currency() { LogInfo("[HUDCurrency] OnCurrencySync | newBalance=" + convert.ToString(balance) + " displayed=" + convert.ToString(_DisplayedBalance)) }

        _TargetBalance = balance
        if !_IsAnimating {
            start AnimateToTarget()
        }
    }

    async func AnimateToTarget() {
        if _CoinNum == nil { return }
        _IsAnimating = true

        while _DisplayedBalance != _TargetBalance {
            var target = _TargetBalance
            var diff = target - _DisplayedBalance
            if diff < 0 { diff = -diff }

            var stepSize = diff / 10
            if stepSize <= 0 { stepSize = 1 }

            if target > _DisplayedBalance {
                _DisplayedBalance = _DisplayedBalance + stepSize
                if _DisplayedBalance > target { _DisplayedBalance = target }
            } else {
                _DisplayedBalance = _DisplayedBalance - stepSize
                if _DisplayedBalance < target { _DisplayedBalance = target }
            }

            _CoinNum<UIWidgetLabel>.Content = FormatNumber(_DisplayedBalance)
            WaitForMillisecond(50)
        }

        _CoinNum<UIWidgetLabel>.Content = FormatNumber(_TargetBalance)
        _DisplayedBalance = _TargetBalance
        _IsAnimating = false
    }

    func FormatNumber(value int) string {
        return convert.ToString(value)
    }
}
