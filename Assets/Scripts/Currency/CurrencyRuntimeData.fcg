import "StdLibrary.fcc" as std
import "Map.fcc" as map
import "Convert.fcc" as convert

import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph CurrencyRuntimeData {

    _Balances Map<entity<Player>, int> = nil

    event OnAwake() {
        _Balances = map.New() as Map<entity<Player>, int>
        if debugCfg.Currency() { LogInfo("[CurrencyRuntimeData] Initialized.") }
    }
}
