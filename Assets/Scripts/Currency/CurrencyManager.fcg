import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Convert.fcc" as convert
import "EditorGenLib.fcc" as gen

import "./CurrencyService.fcg" as currencyService
import "../Config/ItemConfig.fcg" as itemCfg
import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph CurrencyManager {

    func InitPlayerCurrency(player entity<Player>, initialAmount int) {
        if player == nil { return }
        currencyService.SetBalance(player, initialAmount)
        SyncCurrencyToPlayer(player)
        if debugCfg.Currency() { LogInfo("[CurrencyManager] InitPlayerCurrency | player=" + player<Player>.NickName + " initial=" + convert.ToString(initialAmount)) }
    }

    func CanAffordItem(player entity<Player>, itemId string, quantity int) bool {
        if player == nil || quantity <= 0 { return false }
        var unitPrice = itemCfg.GetBuyPrice(itemId)
        var totalCost = (unitPrice * quantity) as int
        var result = currencyService.HasEnough(player, totalCost)
        if debugCfg.Currency() { LogInfo("[CurrencyManager] CanAffordItem | item=" + itemId + " qty=" + convert.ToString(quantity) + " unitPrice=" + convert.ToString(unitPrice) + " total=" + convert.ToString(totalCost) + " result=" + convert.ToString(result)) }
        return result
    }

    func ProcessItemPurchase(player entity<Player>, itemId string, quantity int) bool {
        if player == nil || quantity <= 0 { return false }
        var unitPrice = itemCfg.GetBuyPrice(itemId)
        var totalCost = (unitPrice * quantity) as int

        if !currencyService.SubtractBalance(player, totalCost) {
            if debugCfg.Currency() { LogInfo("[CurrencyManager] ProcessItemPurchase FAILED | insufficient funds") }
            return false
        }

        SyncCurrencyToPlayer(player)
        if debugCfg.Currency() { LogInfo("[CurrencyManager] ProcessItemPurchase OK | player=" + player<Player>.NickName + " spent " + convert.ToString(totalCost) + " on " + convert.ToString(quantity) + "x " + itemId) }
        return true
    }

    func ProcessItemSale(player entity<Player>, itemId string, quantity int) {
        if player == nil || quantity <= 0 { return }
        var unitPrice = itemCfg.GetSellPrice(itemId)
        var totalEarnings = (unitPrice * quantity) as int

        currencyService.AddBalance(player, totalEarnings)
        SyncCurrencyToPlayer(player)
        if debugCfg.Currency() { LogInfo("[CurrencyManager] ProcessItemSale OK | player=" + player<Player>.NickName + " earned " + convert.ToString(totalEarnings) + " from " + convert.ToString(quantity) + "x " + itemId) }
    }

    func GetBalance(player entity<Player>) int {
        return currencyService.GetBalance(player)
    }

    func SyncCurrencyToPlayer(player entity<Player>) {
        if player == nil { return }
        var balance = currencyService.GetBalance(player)
        DispatchEventToEntity(OnCurrencySync, player, PlatformType.Server, List<object>{player, balance})
        if debugCfg.Currency() { LogInfo("[CurrencyManager] SyncCurrencyToPlayer | balance=" + convert.ToString(balance)) }
    }

    func RemovePlayer(player entity<Player>) {
        currencyService.RemovePlayer(player)
    }
}
