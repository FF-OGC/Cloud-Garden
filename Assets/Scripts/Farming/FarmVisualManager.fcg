import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Convert.fcc" as convert
import "EditorGenLib.fcc" as gen
import "Player.fcc" as Player

import "./GardenData.fcg" as gardenData
import "./CropSlot.fcg" as cropSlot
import "./PlayerCropData.fcg" as playerCropData
import "../Core/GameManager.fcg" as gameMgr
import "../Config/DebugConfig.fcg" as debugCfg
import "../Config/ItemConfig.fcg" as itemCfg
import "../Config/MutationConfig.fcg" as mutCfg
import "./CropVisualPool.fcg" as cropPool

[platform_server]
static graph FarmVisualManager {

    event OnFarmCellStateChanged(floor entity<Entity>, slotKey string, newState int) {
        if floor == nil || floor<gardenData> == nil { return }

        var key = slotKey
        // Base = VisualAnchor world pos; Y lifts from ItemConfig (same as potion VFX on pot).
        var spawnPos = floor<gardenData>.GetSpawnWorldPositionForSlotKey(key)
        var liftPotY = itemCfg.GetFarmLiftPotY()
        var liftPlantY = itemCfg.GetFarmLiftPlantY()
        var potPos = Vector3{spawnPos.X, spawnPos.Y + liftPotY, spawnPos.Z}
        var plantPos = Vector3{spawnPos.X, spawnPos.Y + liftPlantY, spawnPos.Z}

        if debugCfg.Farming() { LogInfo("[FarmVisualMgr] >>> OnFarmCellStateChanged key=" + key + " newState=" + newState) }

        var cs = floor<gardenData>.GetCropSlotByKey(key)
        if cs == nil {
            if debugCfg.Farming() {
                LogWarning("[FarmVisualMgr] CropSlot NIL for key=" + key + " — skip pot/plant (check GardenData.CropSlot refs order 0..5)")
            }
            return
        }

        if (newState == EFarmSlotState.PotReady) {
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] CASE1: PotReady") }

            ReturnPlantToPool(floor, key)

            if cs<cropSlot>.PotShopDeferPotVisual {
                if debugCfg.Farming() { LogInfo("[FarmVisualMgr] pot shop: keep existing pot prefab until soil reveal | key=" + key) }
                return
            }

            SpawnPotVisualIfMissing(floor, key, potPos)
            return
        }

        if debugCfg.Farming() { LogInfo("[FarmVisualMgr] CASE2: crop visual") }

        ReturnPlantToPool(floor, key)

        var plantedSeedId = cs<cropSlot>.PlantedSeed
        if plantedSeedId == "" {
            if debugCfg.Farming() { LogWarning("[VISUAL-DBG] No seed at key=" + key + ", skipping") }
            return
        }

        var prefabKey = ""
        if newState == EFarmSlotState.CropGrowing {
            var now = gameMgr.GetGameTime()
            var t0 = cs<cropSlot>.GrowthStartTime
            var t1 = cs<cropSlot>.HarvestTime
            prefabKey = itemCfg.GetGrowingPlantPrefabKey(plantedSeedId, now, t0, t1)
        } else {
            prefabKey = itemCfg.GetPlantPrefabKey(plantedSeedId, newState)
        }

        if debugCfg.Farming() { LogInfo("[VISUAL-DBG] seed=" + plantedSeedId + " state=" + newState + " prefabKey=" + prefabKey) }

        var plantObj = cropPool.Get(prefabKey)

        if plantObj != nil {
            var targetPos = plantPos
            plantObj<Transform>.Position = targetPos

            var child = GetChildByName(plantObj, plantObj<Entity>.Name)
            if child != nil {
                child<Transform>.Position = targetPos
                if debugCfg.Farming() { LogInfo("[VISUAL-DBG] CHILD found pos=" + targetPos) }
            }

            cs<cropSlot>.PlantVisual = plantObj
            cs<cropSlot>.PlantPrefabKey = prefabKey

            if newState == EFarmSlotState.CropReady && cs<cropSlot>.MutationResult != "" {
                var mutStr = cs<cropSlot>.MutationResult
                var prefixId = itemCfg.ParseMutationPrefix(mutStr)
                var matId = mutCfg.GetMutationMaterialId(prefixId)
                var matList = list.New(0, 1) as List<MaterialID>
                list.Append(matList, matId)
                plantObj<CustomRender>.MaterialIDList = matList
                if debugCfg.Mutation() { LogInfo("[MUTATION-VISUAL] key=" + key + " mutStr=" + mutStr) }
            }

            if debugCfg.Farming() { LogInfo("[VISUAL-DBG] seed=" + plantedSeedId + " key=" + key + " pos=" + targetPos) }
        } else {
            if debugCfg.Farming() { LogError("[VISUAL-DBG] FAIL: plantObj is NIL for prefabKey=" + prefabKey) }
        }
    }

    func SpawnPotVisualIfMissing(floor entity<Entity>, key string, potPos Vector3) {
        if floor == nil || floor<gardenData> == nil { return }
        var cs = floor<gardenData>.GetCropSlotByKey(key)
        if cs == nil { return }
        if cs<cropSlot>.PotVisual != nil {
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] Pot visual already exists for key=" + key) }
            return
        }
        var skinTier = floor<gardenData>.GetPotSkinTier(key)
        var potPrefab = itemCfg.GetPotPrefabForSkinTier(skinTier)
        CreateFromPrefab(out var potObj, potPrefab)
        if potObj != nil {
            potObj<Transform>.Position = potPos
            cs<cropSlot>.PotVisual = potObj
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] Spawned pot visual tier=" + convert.ToString(skinTier) + " key=" + key) }
        } else {
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] ERROR: Failed to spawn pot prefab") }
        }
    }

    func ClearPotShopFlowBusyForFloorOwner(floor entity<Entity>) {
        if floor == nil || floor<gardenData> == nil { return }
        var ow = floor<gardenData>.Owner
        if ow == nil { return }
        var pl = ow as entity<Player>
        if pl != nil && pl<playerCropData> != nil {
            pl<playerCropData>._PotShopFlowBusy = false
        }
    }

    // After soil gacha UI shows the final tier: destroy old pot (if any) and spawn prefab for rolled GetPotSkinTier.
    event OnPotShopVisualReveal(floor entity<Entity>, slotKey string) {
        if floor == nil || floor<gardenData> == nil { return }
        var cs = floor<gardenData>.GetCropSlotByKey(slotKey)
        if cs == nil { return }
        if !cs<cropSlot>.PotShopDeferPotVisual {
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] OnPotShopVisualReveal ignored (not deferred) key=" + slotKey) }
            ClearPotShopFlowBusyForFloorOwner(floor)
            return
        }
        if floor<gardenData>.GetCellState(slotKey) != EFarmSlotState.PotReady {
            cs<cropSlot>.PotShopDeferPotVisual = false
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] OnPotShopVisualReveal skip: not PotReady key=" + slotKey) }
            ClearPotShopFlowBusyForFloorOwner(floor)
            return
        }
        cs<cropSlot>.PotShopDeferPotVisual = false

        var spawnPos = floor<gardenData>.GetSpawnWorldPositionForSlotKey(slotKey)
        var liftPotY = itemCfg.GetFarmLiftPotY()
        var potPos = Vector3{spawnPos.X, spawnPos.Y + liftPotY, spawnPos.Z}

        if cs<cropSlot>.PotVisual != nil {
            var oldPot = cs<cropSlot>.PotVisual as entity
            if oldPot != nil { Destroy(oldPot) }
            cs<cropSlot>.PotVisual = nil
        }

        var skinTier = floor<gardenData>.GetPotSkinTier(slotKey)
        var potPrefab = itemCfg.GetPotPrefabForSkinTier(skinTier)
        CreateFromPrefab(out var potObj, potPrefab)
        if potObj != nil {
            potObj<Transform>.Position = potPos
            cs<cropSlot>.PotVisual = potObj
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] Pot shop visual reveal tier=" + convert.ToString(skinTier) + " key=" + slotKey) }
        } else {
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] OnPotShopVisualReveal FAILED spawn prefab key=" + slotKey) }
        }
        ClearPotShopFlowBusyForFloorOwner(floor)
    }

    func ReturnPlantToPool(floor entity<Entity>, cellKey string) {
        if floor == nil || floor<gardenData> == nil { return }
        var cs = floor<gardenData>.GetCropSlotByKey(cellKey)
        if cs == nil { return }
        if cs<cropSlot>.PlantVisual == nil { return }

        var oldPlant = cs<cropSlot>.PlantVisual as entity
        if oldPlant != nil {
            var oldPrefabKey = cs<cropSlot>.PlantPrefabKey
            if oldPrefabKey == "" { oldPrefabKey = "seed_model" }
            cropPool.Return(oldPrefabKey, oldPlant)
            if debugCfg.Farming() { LogInfo("[FarmVisualMgr] Returned plant to pool '" + oldPrefabKey + "' for key=" + cellKey) }
        }
        cs<cropSlot>.PlantPrefabKey = ""
        cs<cropSlot>.PlantVisual = nil
    }
}
