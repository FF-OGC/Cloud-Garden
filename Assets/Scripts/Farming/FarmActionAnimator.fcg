import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen
import "Player.fcc" as Player
import "Map.fcc" as map

import "./PlayerCropData.fcg" as playerCropData
import "../Services/AnimService.fcg" as animSvc
import "../Config/DebugConfig.fcg" as debugCfg
import "./GardenData.fcg" as gardenData
import "../Backpack/BackpackData.fcg" as backpackData
import "../Config/ItemConfig.fcg" as itemCfg
import "../Currency/CurrencyManager.fcg" as currencyMgr

[platform_server]
static graph FarmActionAnimator {

    _ACTION_DELAY int = 1500

    event OnPlayerPotShopAction (player entity<Player>) {
        if player == nil { return }
        if player<playerCropData>._IsPerformingAction {
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: already performing action") }
            return
        }
        start PerformAction(player)
    }

    async func PerformAction(player entity<Entity>) {
        player<playerCropData>._IsPerformingAction = true

        var fromConsumableBtn = player<playerCropData>._PotShopFromConsumableBtn
        player<playerCropData>._PotShopFromConsumableBtn = false

        var gardenEnt = player<playerCropData>.CurrentGarden
        if gardenEnt == nil || gardenEnt<gardenData> == nil {
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: no valid garden") }
            player<playerCropData>._IsPerformingAction = false
            return
        }

        if !player<playerCropData>.InFarmPotTrigger || player<playerCropData>.CurrentFarmSlotIndex < 0 {
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: not in farm slot") }
            player<playerCropData>._IsPerformingAction = false
            return
        }

        if !gardenEnt<gardenData>.IsOwner(player) {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_OTHER_PLAYER_GARDEN"})
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: not garden owner") }
            player<playerCropData>._IsPerformingAction = false
            return
        }

        var key = gardenEnt<gardenData>.SlotKeyFromIndex(player<playerCropData>.CurrentFarmSlotIndex)
        var state = gardenEnt<gardenData>.GetCellState(key)

        if state == EFarmSlotState.CropReady {
            DispatchEventToEntity(OnExecuteFarmAction, globalEntity, PlatformType.Server, List<object>{player})
            player<playerCropData>._IsPerformingAction = false
            return
        }

        // Pot button = Buy (Cloud) or Change (PotReady). Check gold before anim so we don't play dig on failure.
        if state == EFarmSlotState.Cloud || state == EFarmSlotState.PotReady {
            var potItemId = itemCfg.GetPotPurchaseItemId()
            if !currencyMgr.CanAffordItem(player<Player>, potItemId, 1) {
                DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NO_GOLD_POT"})
                player<playerCropData>._IsPerformingAction = false
                return
            }
            if debugCfg.Farming() { LogInfo("[POT_SHOP] [FarmActionAnimator] pot shop anim | Cloud or PotReady (ignore hand item)") }
            DisableActions(player)
            animSvc.PlayAnimOnce(player, "Farming")
            DispatchEventToEntity(OnExecuteFarmAction, globalEntity, PlatformType.Server, List<object>{player})
            WaitForMillisecond(_ACTION_DELAY)
            EnableActions(player)
            player<playerCropData>._IsPerformingAction = false
            return
        }

        var hasConsumable = false
        var heldId = ""
        if player<backpackData> != nil {
            var activeSlot = player<backpackData>._ActiveQuickbarSlot
            var handle = player<backpackData>._QuickSlotRefs[activeSlot]
            if handle != -1 && map.ContainKey(player<backpackData>._ItemIDs, handle) {
                heldId = player<backpackData>._ItemIDs[handle] as string
                if itemCfg.IsFarmGrowConsumable(heldId) { hasConsumable = true }
            }
        }

        // Fertilize only from consumable_btn, never from pot_btn (even if hand holds a consumable).
        if state == EFarmSlotState.CropGrowing {
            if !fromConsumableBtn {
                DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_POT_CANT_CHANGE_WHILE_GROWING"})
                if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: CropGrowing on pot_btn (use consumable_btn to apply item)") }
                player<playerCropData>._IsPerformingAction = false
                return
            }
            if hasConsumable {
                if itemCfg.IsPotionLuckItem(heldId) && gardenEnt<gardenData>.HasLuckFertilizer(key) {
                    if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: luck potion already used") }
                    DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_ALREADY_LUCK_POTION"})
                    player<playerCropData>._IsPerformingAction = false
                    return
                }
                if itemCfg.IsPotionGrowItem(heldId) && gardenEnt<gardenData>.HasGrowthFertilizer(key) {
                    if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: growth potion already used") }
                    DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_ALREADY_GROWTH_POTION"})
                    player<playerCropData>._IsPerformingAction = false
                    return
                }
                DisableActions(player)
                animSvc.PlayAnimOnce(player, "Farming")
                DispatchEventToEntity(OnExecuteFarmAction, globalEntity, PlatformType.Server, List<object>{player})
                WaitForMillisecond(_ACTION_DELAY)
                EnableActions(player)
                player<playerCropData>._IsPerformingAction = false
                return
            }
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_CONSUMABLE_NEED_EQUIP"})
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: consumable_btn but no consumable in hand") }
            player<playerCropData>._IsPerformingAction = false
            return
        }

        DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_POT_ACTION_UNAVAILABLE"})
        if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED: pot_btn no action for state=" + state) }
        player<playerCropData>._IsPerformingAction = false
    }

    event OnPlayerPlantAction(player entity<Player>) {
        if player == nil { return }
        if player<playerCropData>._IsPerformingAction {
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED plant: already performing action") }
            return
        }
        start PerformPlantAction(player)
    }

    async func PerformPlantAction(player entity<Entity>) {
        player<playerCropData>._IsPerformingAction = true

        var gardenEnt = player<playerCropData>.CurrentGarden
        if gardenEnt == nil || gardenEnt<gardenData> == nil {
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED plant: no valid garden") }
            player<playerCropData>._IsPerformingAction = false
            return
        }

        if !player<playerCropData>.InFarmPotTrigger || player<playerCropData>.CurrentFarmSlotIndex < 0 {
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED plant: not in slot") }
            player<playerCropData>._IsPerformingAction = false
            return
        }

        if !gardenEnt<gardenData>.IsOwner(player) {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_OTHER_PLAYER_GARDEN"})
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED plant: not garden owner") }
            player<playerCropData>._IsPerformingAction = false
            return
        }

        var key = gardenEnt<gardenData>.SlotKeyFromIndex(player<playerCropData>.CurrentFarmSlotIndex)
        var state = gardenEnt<gardenData>.GetCellState(key)
        if state != EFarmSlotState.PotReady {
            if debugCfg.Farming() { LogInfo("[FarmActionAnimator] REJECTED plant: not PotReady, state=" + state) }
            player<playerCropData>._IsPerformingAction = false
            return
        }

        DisableActions(player)

        animSvc.PlayAnimOnce(player, "Farming")

        DispatchEventToEntity(OnExecutePlantAction, globalEntity, PlatformType.Server, List<object>{player})

        WaitForMillisecond(_ACTION_DELAY)

        EnableActions(player)

        player<playerCropData>._IsPerformingAction = false
    }

    func DisableActions(player entity<Entity>) {
        SetBehaviorStatus(player<Player>, PlayerBehaviorType.Move, PlayerBehaviorStatusType.Disable)
        SetBehaviorStatus(player<Player>, PlayerBehaviorType.Sprint, PlayerBehaviorStatusType.Disable)
        SetBehaviorStatus(player<Player>, PlayerBehaviorType.Attack, PlayerBehaviorStatusType.Disable)
        SetBehaviorStatus(player<Player>, PlayerBehaviorType.Jump, PlayerBehaviorStatusType.Disable)
        SetDefaultUIStatus(player<Player>, DefaultUIType.Crouch, ThreeStatusSwitch.Close)
        SetDefaultUIStatus(player<Player>, DefaultUIType.Prone, ThreeStatusSwitch.Close)
    }

    func EnableActions(player entity<Entity>) {
        SetBehaviorStatus(player<Player>, PlayerBehaviorType.Move, PlayerBehaviorStatusType.Enable)
        SetBehaviorStatus(player<Player>, PlayerBehaviorType.Sprint, PlayerBehaviorStatusType.Enable)
        SetBehaviorStatus(player<Player>, PlayerBehaviorType.Attack, PlayerBehaviorStatusType.Enable)
        SetBehaviorStatus(player<Player>, PlayerBehaviorType.Jump, PlayerBehaviorStatusType.Enable)
        SetDefaultUIStatus(player<Player>, DefaultUIType.Crouch, ThreeStatusSwitch.Show)
        SetDefaultUIStatus(player<Player>, DefaultUIType.Prone, ThreeStatusSwitch.Show)
    }
}
