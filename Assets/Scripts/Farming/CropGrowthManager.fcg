import "StdLibrary.fcc" as std
import "Map.fcc" as map
import "List.fcc" as list
import "EditorGenLib.fcc" as gen

import "../Core/GameManager.fcg" as gameMgr
import "../Grid/FloorGridData.fcg" as floorData
import "../Config/ItemConfig.fcg" as itemCfg
import "../Config/GachaConfig.fcg" as gachaCfg
import "../Gacha/GachaManager.fcg" as gachaManager

[platform_server]
static graph CropGrowthManager {
    
    async func StartBackgroundTick(floors List<entity<Entity>>) {
        if gameMgr.IsDebug() { LogInfo("[CropGrowthManager] Background Tick Started...") }
        
        while true {
            WaitForMillisecond(3000)
            var currentTime = gameMgr.GetGameTime()

            var floorCount = list.Length(floors)
            for i = 0, floorCount, 1 {
                var floor = floors[i]
                if floor == nil || floor<floorData> == nil { continue }
                
                var cellStates = floor<floorData>.CellStates
                var harvestTimes = floor<floorData>.HarvestTimes
                var cropPositions = floor<floorData>.CropPositions
                
                var k = 0
                var keyCount = list.Length(floor<floorData>.GrowingKeys)
                while k < keyCount {
                    var key = floor<floorData>.GrowingKeys[k] as string
                    var shouldRemove = false
                    
                    if map.ContainKey(cellStates, key) {
                        var state = cellStates[key] as int
                        
                        if state == gen.EFarmSlotState.NeedWatering || state == gen.EFarmSlotState.Growing {
                            var targetTime = harvestTimes[key] as float
                            
                            if currentTime >= targetTime {
                                if map.ContainKey(floor<floorData>.PlantedSeeds, key) {
                                    var seedId = floor<floorData>.PlantedSeeds[key] as string
                                    var owner = floor<floorData>.Owner
                                    if owner != nil {
                                        var bonusRate = 0
                                        if floor<floorData>.IsLuckyDirt(key) {
                                            bonusRate = gachaCfg.GetLuckyDirtMutationBonus()
                                            if gameMgr.IsDebug() { LogInfo("[CropGrowthManager] Lucky dirt bonus +" + bonusRate + "% at key=" + key) }
                                        }
                                        if floor<floorData>.IsFertilized(key) {
                                            var fertBonus = floor<floorData>.FertilizerLuckBonus[key] as int
                                            bonusRate = bonusRate + fertBonus
                                            if gameMgr.IsDebug() { LogInfo("[CropGrowthManager] Fertilizer bonus +" + fertBonus + "% at key=" + key + " total=" + bonusRate) }
                                        }
                                        var resultCropId = gachaManager.RollForHarvest(owner, seedId, bonusRate)
                                        var normalCropId = itemCfg.GetHarvestYield(seedId)
                                        if resultCropId != normalCropId {
                                            floor<floorData>.TrySetGachaResult(key, resultCropId)
                                            if gameMgr.IsDebug() { LogInfo("[CropGrowthManager] Gacha HIT at key=" + key + " reward=" + resultCropId) }
                                        }
                                    }
                                }

                                cellStates[key] = gen.EFarmSlotState.ReadyToHarvest
                                
                                if map.ContainKey(cropPositions, key) {
                                    var gridPos = cropPositions[key] as Vector3
                                    DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floor, gridPos, gen.EFarmSlotState.ReadyToHarvest})
                                }
                                
                                map.Remove(harvestTimes, key)
                                map.Remove(cropPositions, key)
                                shouldRemove = true
                                
                                if gameMgr.IsDebug() { LogInfo("[CropGrowthManager] Crop is Ready To Harvest at grid key: " + key) }
                            }
                        } else {
                            shouldRemove = true
                        }
                    } else {
                        shouldRemove = true
                    }

                    if shouldRemove {
                        list.RemoveAt(floor<floorData>.GrowingKeys, k)
                        keyCount = keyCount - 1
                    } else {
                        k = k + 1
                    }
                }
            }
        }
    }
}
