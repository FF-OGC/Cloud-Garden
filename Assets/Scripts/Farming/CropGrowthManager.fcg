import "StdLibrary.fcc" as std
import "List.fcc" as list
import "EditorGenLib.fcc" as gen
import "Convert.fcc" as convert

import "../Core/GameManager.fcg" as gameMgr
import "../Config/DebugConfig.fcg" as debugCfg
import "./GardenData.fcg" as gardenData
import "./CropSlot.fcg" as cropSlot
import "../Config/ItemConfig.fcg" as itemCfg
import "../Gacha/GachaManager.fcg" as gachaManager

[platform_server]
static graph CropGrowthManager {

    async func StartBackgroundTick(floors List<entity<Entity>>) {
        if debugCfg.Farming() { LogInfo("[CropGrowthManager] Background Tick Started...") }

        while true {
            WaitForMillisecond(3000)
            var currentTime = gameMgr.GetGameTime()

            var floorCount = list.Length(floors)
            for i = 0, floorCount, 1 {
                var gardenEnt = floors[i]
                if gardenEnt == nil || gardenEnt<gardenData> == nil { continue }

                var k = 0
                var keyCount = list.Length(gardenEnt<gardenData>.GrowingKeys)
                while k < keyCount {
                    var key = gardenEnt<gardenData>.GrowingKeys[k] as string
                    var shouldRemove = false

                    var cs = gardenEnt<gardenData>.GetCropSlotByKey(key)
                    if cs != nil {
                        var state = cs<cropSlot>.CellState

                        if state == EFarmSlotState.CropGrowing {
                            var targetTime = cs<cropSlot>.HarvestTime
                            var plantedId = cs<cropSlot>.PlantedSeed
                            if plantedId != "" && currentTime < targetTime {
                                var t0 = cs<cropSlot>.GrowthStartTime
                                var wantKey = itemCfg.GetGrowingPlantPrefabKey(plantedId, currentTime, t0, targetTime)
                                var seedKey = itemCfg.GetGrowingSeedPrefabKey(plantedId)
                                if wantKey != seedKey && cs<cropSlot>.PlantPrefabKey == seedKey {
                                    DispatchEventToEntity(OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.CropGrowing})
                                    if debugCfg.Farming() { LogInfo("[CropGrowthManager] Growing → stem visual key=" + key + " want=" + wantKey) }
                                }
                            }

                            if currentTime >= targetTime {
                                if cs<cropSlot>.PlantedSeed != "" {
                                    var seedId = cs<cropSlot>.PlantedSeed
                                    var owner = gardenEnt<gardenData>.Owner
                                    if owner != nil {
                                        var potTier = cs<cropSlot>.PotTier
                                        var fertLuckPct = gardenEnt<gardenData>.GetFertilizerLuckBonus(key)
                                        var isLucky = gardenEnt<gardenData>.IsLuckyPot(key)

                                        var suffixTier = gachaManager.RollSuffixTier()
                                        var prefixId = gachaManager.RollMutationPrefix(owner, seedId, potTier, fertLuckPct, isLucky)
                                        var mutStr = itemCfg.BuildMutationStr(prefixId, suffixTier)
                                        gardenEnt<gardenData>.TrySetMutationResult(key, mutStr)
                                        if debugCfg.Mutation() { LogInfo("[MUTATION] key=" + key + " seed=" + seedId + " potTier=" + convert.ToString(potTier) + " fertLuck%=" + convert.ToString(fertLuckPct) + " luckyPot=" + convert.ToString(isLucky) + " -> mutStr=" + mutStr) }
                                    }
                                }

                                cs<cropSlot>.CellState = EFarmSlotState.CropReady

                                DispatchEventToEntity(OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.CropReady})

                                cs<cropSlot>.HarvestTime = 0.0
                                cs<cropSlot>.CropPosition = Vector3{0.0, 0.0, 0.0}
                                shouldRemove = true

                                if debugCfg.Farming() { LogInfo("[CropGrowthManager] Crop is Ready To Harvest at key: " + key) }
                            }
                        } else {
                            shouldRemove = true
                        }
                    } else {
                        shouldRemove = true
                    }

                    if shouldRemove {
                        list.RemoveAt(gardenEnt<gardenData>.GrowingKeys, k)
                        keyCount = keyCount - 1
                    } else {
                        k = k + 1
                    }
                }
            }
        }
    }
}
