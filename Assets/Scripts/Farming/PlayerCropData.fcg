import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen

[platform_server]
graph PlayerCropData {
    CurrentGarden entity<GardenData>
    CurrentFarmSlotIndex int = -1
    InFarmPotTrigger bool = false
    _IsPerformingAction bool = false
    // True only when HUD consumable_btn dispatched OnPlayerPotShopAction (fertilize). pot_btn clears this before dispatch.
    _PotShopFromConsumableBtn bool = false
    // Set by FarmingManager.ProcessPaidPotGacha only; FarmSlotHintsHUD consumes on OnFarmCellStateChanged (bubble soil roll).
    PendingPotSoilGacha bool = false
    PendingPotSoilGachaKey string = ""
    PendingPotSoilGachaSkinTier int = 0

    event OnAwake() {
        CurrentGarden = nil
        CurrentFarmSlotIndex = -1
        InFarmPotTrigger = false
        _IsPerformingAction = false
        _PotShopFromConsumableBtn = false
        PendingPotSoilGacha = false
        PendingPotSoilGachaKey = ""
        PendingPotSoilGachaSkinTier = 0
    }
}
