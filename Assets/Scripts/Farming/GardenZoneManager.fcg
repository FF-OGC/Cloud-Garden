import "StdLibrary.fcc" as std
import "List.fcc" as list
import "EditorGenLib.fcc" as gen
import "Player.fcc" as Player
import "../Config/DebugConfig.fcg" as debugCfg
import "../Floors/FloorManager.fcg" as floorManager
import "./GardenData.fcg" as gardenData
[platform_server]
static graph GardenZoneManager {

    func InitializeZone(zoneObj entity<Entity>) {
        if zoneObj == nil || zoneObj<FarmZoneData> == nil { return }

        var floors = zoneObj<FarmZoneData>.Floors

        if floors != nil && list.Length(floors) > 0 {
            floorManager.SnapFloorsToConfig(zoneObj, floors)
        }

        // GardenData.InitFarmRuntimeDefaults runs from GameManager.WaitAndInitPlayer (OnPlayerJoin) via InitGardenFarmRuntimeInZone.

        if debugCfg.Farming() { LogInfo("[GardenZoneManager] Zone layout snap done (garden init deferred to player join).") }
    }

    // Call for one zone: every floor entity with GardenData gets InitFarmRuntimeDefaults (slot defaults; triggers are editor-assigned).
    func InitGardenFarmRuntimeInZone(zoneObj entity<Entity>) {
        if zoneObj == nil || zoneObj<FarmZoneData> == nil { return }
        var floors = zoneObj<FarmZoneData>.Floors
        if floors == nil { return }
        var fCount = list.Length(floors)
        for i = 0, fCount, 1 {
            var floor = floors[i]
            if floor != nil && floor<gardenData> != nil {
                floor<gardenData>.InitFarmRuntimeDefaults()
            }
        }
    }

    func InitGardenFarmRuntimeInAllZones(farmZones List<entity<Entity>>) {
        if farmZones == nil { return }
        var zCount = list.Length(farmZones)
        for i = 0, zCount, 1 {
            InitGardenFarmRuntimeInZone(farmZones[i])
        }
    }

    // First-time zone claim only (after InitGardenFarmRuntimeInZone): floor index 0, slots 0–2 = free tier-1 pots, PotReady.
    func ApplyFirstFloorStarterPots(zoneObj entity<Entity>, owner entity<Player>) {
        if zoneObj == nil || zoneObj<FarmZoneData> == nil || owner == nil { return }
        var floors = zoneObj<FarmZoneData>.Floors
        if floors == nil || list.Length(floors) < 1 { return }
        var floorEnt = floors[0]
        if floorEnt == nil || floorEnt<gardenData> == nil { return }

        if !floorEnt<gardenData>.IsOwner(owner as entity<Entity>) { return }

        var idx = 0
        while idx < 3 {
            var key = floorEnt<gardenData>.SlotKeyFromIndex(idx)
            floorEnt<gardenData>.TrySetPotTier(key, 1, owner as entity<Entity>)
            floorEnt<gardenData>.TrySetPotSkinTier(key, 1, owner as entity<Entity>)
            floorEnt<gardenData>.TrySetLuckyPot(key, false)
            if floorEnt<gardenData>.TryModifyCell(key, EFarmSlotState.PotReady, owner as entity<Entity>) {
                DispatchEventToEntity(OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floorEnt, key, EFarmSlotState.PotReady})
                DispatchEventToEntity(OnFarmCellStateChanged, owner, PlatformType.Server, List<object>{floorEnt, key, EFarmSlotState.PotReady})
                if debugCfg.Farming() {
                    LogInfo("[POT_SHOP] [StarterPots] floor='" + floorEnt<Entity>.Name + "' key=" + key + " PotReady skinTier=1 potTier=1")
                }
            }
            idx = idx + 1
        }
    }
}
