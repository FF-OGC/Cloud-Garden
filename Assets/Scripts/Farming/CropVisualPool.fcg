import "StdLibrary.fcc" as std
import "List.fcc" as list
import "Map.fcc" as map
import "EditorGenLib.fcc" as gen

import "../Core/GameManager.fcg" as gameMgr
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
static graph CropVisualPool {

    _Pool Map<string, List<entity<Entity>>>
    _IsPoolReady bool = false

    async func InitPool() {
        _Pool = map.New() as Map<string, List<entity<Entity>>>
        _IsPoolReady = false

        // seed_needwatering: 25 = 5+5+5+5+5
        _Batch("seed_needwatering", EResPrefab.seed_needwatering, 5)
        WaitForMillisecond(100)
        _Batch("seed_needwatering", EResPrefab.seed_needwatering, 5)
        WaitForMillisecond(100)
        _Batch("seed_needwatering", EResPrefab.seed_needwatering, 5)
        WaitForMillisecond(100)
        _Batch("seed_needwatering", EResPrefab.seed_needwatering, 5)
        WaitForMillisecond(100)
        _Batch("seed_needwatering", EResPrefab.seed_needwatering, 5)
        WaitForMillisecond(100)

        // seed_model: 25 = 5+5+5+5+5
        _Batch("seed_model", EResPrefab.seed_model, 5)
        WaitForMillisecond(100)
        _Batch("seed_model", EResPrefab.seed_model, 5)
        WaitForMillisecond(100)
        _Batch("seed_model", EResPrefab.seed_model, 5)
        WaitForMillisecond(100)
        _Batch("seed_model", EResPrefab.seed_model, 5)
        WaitForMillisecond(100)
        _Batch("seed_model", EResPrefab.seed_model, 5)
        WaitForMillisecond(100)

        // seed_growed: 25 = 5+5+5+5+5
        _Batch("seed_growed", EResPrefab.seed_growed, 5)
        WaitForMillisecond(100)
        _Batch("seed_growed", EResPrefab.seed_growed, 5)
        WaitForMillisecond(100)
        _Batch("seed_growed", EResPrefab.seed_growed, 5)
        WaitForMillisecond(100)
        _Batch("seed_growed", EResPrefab.seed_growed, 5)
        WaitForMillisecond(100)
        _Batch("seed_growed", EResPrefab.seed_growed, 5)
        WaitForMillisecond(100)

        // seed_apple: 15 = 5+5+5
        _Batch("seed_apple", EResPrefab.seed_apple, 5)
        WaitForMillisecond(100)
        _Batch("seed_apple", EResPrefab.seed_apple, 5)
        WaitForMillisecond(100)
        _Batch("seed_apple", EResPrefab.seed_apple, 5)
        WaitForMillisecond(100)

        // seed_carrot: 15 = 5+5+5
        _Batch("seed_carrot", EResPrefab.seed_carrot, 5)
        WaitForMillisecond(100)
        _Batch("seed_carrot", EResPrefab.seed_carrot, 5)
        WaitForMillisecond(100)
        _Batch("seed_carrot", EResPrefab.seed_carrot, 5)
        WaitForMillisecond(100)

        // seed_tomato: 15 = 5+5+5
        _Batch("seed_tomato", EResPrefab.seed_tomato, 5)
        WaitForMillisecond(100)
        _Batch("seed_tomato", EResPrefab.seed_tomato, 5)
        WaitForMillisecond(100)
        _Batch("seed_tomato", EResPrefab.seed_tomato, 5)
        WaitForMillisecond(100)

        // stem (second half of CropGrowing): 15 each
        _Batch("apple_stem", EResPrefab.apple_stem, 5)
        WaitForMillisecond(100)
        _Batch("apple_stem", EResPrefab.apple_stem, 5)
        WaitForMillisecond(100)
        _Batch("apple_stem", EResPrefab.apple_stem, 5)
        WaitForMillisecond(100)

        _Batch("carrot_stem", EResPrefab.carrot_stem, 5)
        WaitForMillisecond(100)
        _Batch("carrot_stem", EResPrefab.carrot_stem, 5)
        WaitForMillisecond(100)
        _Batch("carrot_stem", EResPrefab.carrot_stem, 5)
        WaitForMillisecond(100)

        // crop_apple: 25 = 5+5+5+5+5
        _Batch("crop_apple", EResPrefab.crop_apple, 5)
        WaitForMillisecond(100)
        _Batch("crop_apple", EResPrefab.crop_apple, 5)
        WaitForMillisecond(100)
        _Batch("crop_apple", EResPrefab.crop_apple, 5)
        WaitForMillisecond(100)
        _Batch("crop_apple", EResPrefab.crop_apple, 5)
        WaitForMillisecond(100)
        _Batch("crop_apple", EResPrefab.crop_apple, 5)
        WaitForMillisecond(100)

        // crop_carrot: 20 = 5+5+5+5
        _Batch("crop_carrot", EResPrefab.crop_carrot, 5)
        WaitForMillisecond(100)
        _Batch("crop_carrot", EResPrefab.crop_carrot, 5)
        WaitForMillisecond(100)
        _Batch("crop_carrot", EResPrefab.crop_carrot, 5)
        WaitForMillisecond(100)
        _Batch("crop_carrot", EResPrefab.crop_carrot, 5)
        WaitForMillisecond(100)

        // crop_tomato: 20 = 5+5+5+5
        _Batch("crop_tomato", EResPrefab.crop_tomato, 5)
        WaitForMillisecond(100)
        _Batch("crop_tomato", EResPrefab.crop_tomato, 5)
        WaitForMillisecond(100)
        _Batch("crop_tomato", EResPrefab.crop_tomato, 5)
        WaitForMillisecond(100)
        _Batch("crop_tomato", EResPrefab.crop_tomato, 5)
        WaitForMillisecond(100)

        // mutation_seed_growed: 10 = 5+5
        _Batch("mutation_seed_growed", EResPrefab.mutation_seed_growed, 5)
        WaitForMillisecond(100)
        _Batch("mutation_seed_growed", EResPrefab.mutation_seed_growed, 5)
        WaitForMillisecond(100)

        // crop_mutation_apple: 10 = 5+5
        _Batch("crop_mutation_apple", EResPrefab.crop_mutation_apple, 5)
        WaitForMillisecond(100)
        _Batch("crop_mutation_apple", EResPrefab.crop_mutation_apple, 5)

        _IsPoolReady = true
        if debugCfg.Farming() { LogInfo("[CropVisualPool] All pools ready.") }
    }

    func _Batch(key string, prefabId PrefabID, count int) {
        var poolList List<entity<Entity>> = nil
        if map.ContainKey(_Pool, key) {
            poolList = _Pool[key] as List<entity<Entity>>
        } else {
            poolList = list.New(0, 30) as List<entity<Entity>>
            _Pool[key] = poolList
        }
        var created = 0
        for i = 0, count, 1 {
            CreateFromPrefab(out var obj, prefabId)
            if obj != nil {
                obj<Transform>.Position = Vector3{0, -9999, 0}
                list.Append(poolList, obj)
                created = created + 1
            }
        }
        if debugCfg.Farming() { LogInfo("[CropVisualPool] '" + key + "' +=" + created + " total=" + list.Length(poolList)) }
    }

    func Get(prefabKey string) entity<Entity> {
        if map.ContainKey(_Pool, prefabKey) {
            var poolList = _Pool[prefabKey] as List<entity<Entity>>
            var count = list.Length(poolList)
            if count > 0 {
                var obj = poolList[count - 1] as entity<Entity>
                list.RemoveAt(poolList, count - 1)
                return obj
            }
        }

        var prefabId = _ResolvePrefabId(prefabKey)
        CreateFromPrefab(out var newObj, prefabId)
        return newObj
    }

    func Return(prefabKey string, obj entity<Entity>) {
        if obj == nil { return }
        obj<Transform>.Position = Vector3{0, -9999, 0}

        if map.ContainKey(_Pool, prefabKey) {
            var poolList = _Pool[prefabKey] as List<entity<Entity>>
            list.Append(poolList, obj)
        }
    }

    func _ResolvePrefabId(key string) PrefabID {
        if key == "seed_needwatering" { return EResPrefab.seed_needwatering }
        if key == "seed_model" { return EResPrefab.seed_model }
        if key == "seed_growed" { return EResPrefab.seed_growed }
        if key == "seed_apple" { return EResPrefab.seed_apple }
        if key == "seed_carrot" { return EResPrefab.seed_carrot }
        if key == "seed_tomato" { return EResPrefab.seed_tomato }
        if key == "apple_stem" { return EResPrefab.apple_stem }
        if key == "carrot_stem" { return EResPrefab.carrot_stem }
        if key == "crop_apple" { return EResPrefab.crop_apple }
        if key == "crop_carrot" { return EResPrefab.crop_carrot }
        if key == "crop_tomato" { return EResPrefab.crop_tomato }
        if key == "mutation_seed_growed" { return EResPrefab.mutation_seed_growed }
        if key == "crop_mutation_apple" { return EResPrefab.crop_mutation_apple }
        return EResPrefab.seed_model
    }
}
