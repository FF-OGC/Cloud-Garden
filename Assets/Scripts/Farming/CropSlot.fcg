import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen

import "../Config/DebugConfig.fcg" as debugCfg

// Runtime state for a single crop slot (one garden has 6). Visual spawn position: VisualAnchor.
// Editor: Custom Component CropSlot — set VisualAnchor (Transform). Serialized on CC, not graph fields;
// HydrateRefsFromCustomComponent copies into VisualAnchor at runtime (same idea as GardenData / CropSlotTrigger).
[platform_server]
graph CropSlot {
    VisualAnchor entity<Transform>

    CellState int
    PotTier int
    PotSkinTier int
    PlantedSeed string
    HarvestTime float
    GrowthStartTime float
    CropPosition Vector3

    PotVisual entity<Entity>
    PlantVisual entity<Entity>
    PlantPrefabKey string

    MutationResult string
    IsLuckyPot bool

    FertilizerLuckBonus int
    FertilizerGrowthReduction float

    func HydrateRefsFromCustomComponent() {
        var ser = thisEntity as entity<gen.CropSlot>
        if ser == nil { return }
        var va = ser<gen.CropSlot>.VisualAnchor
        if va != nil {
            VisualAnchor = va as entity<Transform>
        }
        if debugCfg.Farming() {
            if VisualAnchor != nil {
                LogInfo("[CropSlot] Hydrate: VisualAnchor OK '" + thisEntity<Entity>.Name + "'")
            } else {
                LogWarning("[CropSlot] Hydrate: Custom Component VisualAnchor nil — assign on slot entity '" +
                    thisEntity<Entity>.Name + "'")
            }
        }
    }

    event OnAwake() {
        HydrateRefsFromCustomComponent()
    }

    func InitSlotDefaults() {
        CellState = EFarmSlotState.Cloud as int
        PotTier = 1
        PotSkinTier = 1
        PlantedSeed = ""
        HarvestTime = 0.0
        GrowthStartTime = 0.0
        CropPosition = Vector3{0.0, 0.0, 0.0}
        PotVisual = nil
        PlantVisual = nil
        PlantPrefabKey = ""
        MutationResult = ""
        IsLuckyPot = false
        FertilizerLuckBonus = 0
        FertilizerGrowthReduction = 0.0
    }

    func GetSpawnWorldPosition(gardenEntity entity<Entity>) Vector3 {
        if VisualAnchor != nil { return VisualAnchor<Transform>.Position }
        if debugCfg.Farming() {
            LogWarning("[CropSlot] VisualAnchor NIL on slot='" + thisEntity<Entity>.Name + "' garden='" +
                gardenEntity<Entity>.Name + "' → spawn uses GARDEN pivot (center)")
        }
        return gardenEntity<Transform>.Position
    }
}
