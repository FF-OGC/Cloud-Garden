import "StdLibrary.fcc" as std
import "Map.fcc" as map
import "Convert.fcc" as convert
import "Math.fcc" as math
import "List.fcc" as list
import "EditorGenLib.fcc" as gen

//Graphs
import "../Grid/FloorGridData.fcg" as floorData
import "../Core/GameManager.fcg" as gameMgr
import "../Config/DebugConfig.fcg" as debugCfg
import "../Farming/PlayerFarmingData.fcg" as playerFarmingData
import "../Backpack/BackpackData.fcg" as backpackData
import "../Backpack/BackpackManager.fcg" as backpackMgr 

//Configs
import "../Config/ItemConfig.fcg" as itemCfg

//Gacha
import "../Gacha/GachaManager.fcg" as gachaManager
import "../Gacha/GachaData.fcg" as gachaData

//Services
import "../Services/Utils/GridUtil.fcg" as gridUtil

[platform_server]
static graph FarmingManager {
    
    event OnExecuteFarmAction(player entity<Entity>) {
        if debugCfg.Farming() { LogInfo("[FarmingMgr] >>> OnExecuteFarmAction FIRED") }

        if player == nil || player<playerFarmingData>.CurrentFloor == nil {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: player is nil or CurrentFloor is nil") }
            return
        }

        var gridPos = player<playerFarmingData>.CurrentGridPos
        var key = gridUtil.GetKeyFromPos(gridPos)
        
        var floorObj = player<playerFarmingData>.CurrentFloor
        var cellStates = floorObj<floorData>.CellStates

        if debugCfg.Farming() { LogInfo("[FarmingMgr] gridPos=" + gridPos + " key=" + key) }

        if !floorObj<floorData>.IsOwner(player) {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: floor ownership validation failed (Owner=" + floorObj<floorData>.Owner + " player=" + player + ")") }
            return
        }

        if map.ContainKey(cellStates, key) {
            var intentState = cellStates[key] as int
            if debugCfg.Farming() { LogInfo("[FarmingMgr] intentState=" + intentState) }
            
            var targetPositions = List<Vector3>{}
            list.Append(targetPositions, gridPos)

            var validPositions = List<Vector3>{}
            var validKeys = List<string>{}

            for i = 0, list.Length(targetPositions), 1 {
                var pos = targetPositions[i]
                var k = gridUtil.GetKeyFromPos(pos)
                if map.ContainKey(cellStates, k) {
                    var state = cellStates[k] as int
                    if state == intentState {
                        list.Append(validPositions, pos)
                        list.Append(validKeys, k)
                    }
                }
            }

            var validCount = list.Length(validKeys)
            if validCount == 0 {
                if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: validCount=0") }
                return
            }

            // ==========================================
            // STEP 1: GRASS -> TILLED DIRT
            // ==========================================
            if intentState == gen.EFarmSlotState.Grass {
                if debugCfg.Farming() { LogInfo("[FarmingMgr] STEP1: Grass->Tilled, count=" + validCount) }
                var digActionIndex = gachaData.IncrementLuckyDirtDigAction(player)
                var forceLuckyDirt = gachaData.ShouldForceTutorialLuckyDirtOnce(digActionIndex)
                for i = 0, validCount, 1 {
                    var k = validKeys[i]
                    var p = validPositions[i]
                    
                    if !floorObj<floorData>.TryModifyCell(k, gen.EFarmSlotState.Tilled, player) { continue }
                    floorObj<floorData>.TrySetSoilTier(k, 1, player)

                    if forceLuckyDirt {
                        gachaData.MarkNextLuckyDirtRollGuaranteed(player)
                    }
                    var isLucky = gachaManager.RollForLuckyDirt(player)
                    if isLucky {
                        floorObj<floorData>.TrySetLuckyDirt(k, true)
                        if debugCfg.Farming() { LogInfo("[FarmingMgr] LUCKY DIRT at key=" + k) }
                    }

                    DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floorObj, p, gen.EFarmSlotState.Tilled})
                    DispatchEventToEntity(gen.OnFarmCellStateChanged, player, PlatformType.Server, List<object>{floorObj, p, gen.EFarmSlotState.Tilled})
                }
            
            // ==========================================
            // STEP 2: TILLED DIRT (Re-hoe or Fertilize only)
            // ==========================================
            } else if intentState == gen.EFarmSlotState.Tilled {
                var hasPotion = false

                if player<backpackData> != nil {
                    var activeSlot = player<backpackData>._ActiveQuickbarSlot
                    var handle = player<backpackData>._QuickSlotRefs[activeSlot]
                    if handle != -1 && map.ContainKey(player<backpackData>._ItemIDs, handle) {
                        var holdItemId = player<backpackData>._ItemIDs[handle] as string
                        if itemCfg.GetType(holdItemId) == 4 { hasPotion = true }
                    }
                }

                if hasPotion {
                    // ---- FERTILIZE: apply potion to tilled dirt ----
                    if floorObj<floorData>.IsFertilized(key) {
                        if debugCfg.Farming() { LogInfo("[FarmingMgr] STEP2-FERTILIZE ABORT: cell already fertilized, key=" + key) }
                        DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_ALREADY_FERTILIZED"})
                        return
                    }

                    if debugCfg.Farming() { LogInfo("[FarmingMgr] STEP2-FERTILIZE: Applying potion, count=" + validCount) }
                    
                    var activeSlot = player<backpackData>._ActiveQuickbarSlot
                    var handle = player<backpackData>._QuickSlotRefs[activeSlot]
                    var availableAmt = player<backpackData>._ItemAmounts[handle] as int
                    var amountToUse = validCount
                    if availableAmt < validCount { amountToUse = availableAmt }

                    var isConsumed = backpackMgr.ConsumeActiveItem(player, amountToUse)
                    if isConsumed {
                        var luckBonus = itemCfg.GetPotionLuckBonus()
                        var growthReduction = itemCfg.GetPotionGrowthReduction()

                        for i = 0, amountToUse, 1 {
                            var k = validKeys[i]
                            floorObj<floorData>.TrySetFertilized(k, luckBonus, growthReduction, player)

                            if map.ContainKey(floorObj<floorData>.SoilVisuals, k) {
                                var soilEntity = floorObj<floorData>.SoilVisuals[k] as entity
                                if soilEntity != nil {
                                    var vfx = GetChildByName(soilEntity, "Visual effects")
                                    if vfx != nil { vfx<Entity>.ActiveSelf = true }
                                }
                            }
                            if debugCfg.Farming() { LogInfo("[FarmingMgr] Potion applied at key=" + k + " | Growth speed +" + convert.ToString(growthReduction * 100.0) + "% faster | Luck +" + convert.ToString(luckBonus) + "%") }
                        }
                    }
                } else {
                    // ---- RE-HOE: re-roll lucky dirt ----
                    if debugCfg.Farming() { LogInfo("[FarmingMgr] STEP2-REHOE: Re-rolling lucky dirt, count=" + validCount) }
                    var digActionIndex = gachaData.IncrementLuckyDirtDigAction(player)
                    var forceLuckyDirt = gachaData.ShouldForceTutorialLuckyDirtOnce(digActionIndex)
                    for i = 0, validCount, 1 {
                        var k = validKeys[i]
                        var p = validPositions[i]

                        floorObj<floorData>.TryClearSoilVisual(k)

                        if forceLuckyDirt {
                            gachaData.MarkNextLuckyDirtRollGuaranteed(player)
                        }
                        var isLucky = gachaManager.RollForLuckyDirt(player)
                        if isLucky {
                            floorObj<floorData>.TrySetLuckyDirt(k, true)
                            if debugCfg.Farming() { LogInfo("[FarmingMgr] RE-HOE LUCKY DIRT at key=" + k) }
                        }

                        DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floorObj, p, gen.EFarmSlotState.Tilled})
                        DispatchEventToEntity(gen.OnFarmCellStateChanged, player, PlatformType.Server, List<object>{floorObj, p, gen.EFarmSlotState.Tilled})
                    }
                }

            // ==========================================
            // STEP 3: NEED WATERING -> GROWING
            // ==========================================
            } else if intentState == gen.EFarmSlotState.NeedWatering {
                if debugCfg.Farming() { LogInfo("[FarmingMgr] STEP3: NeedWatering->Growing, count=" + validCount) }
                for i = 0, validCount, 1 {
                    var k = validKeys[i]
                    var p = validPositions[i]

                    if !floorObj<floorData>.TryModifyCell(k, gen.EFarmSlotState.Growing, player) { continue }
                    
                    if map.ContainKey(floorObj<floorData>.HarvestTimes, k) {
                        var oldTargetTime = floorObj<floorData>.HarvestTimes[k] as float
                        var currentTime = gameMgr.GetGameTime()
                        var timeLeft = oldTargetTime - currentTime
                        
                        if timeLeft > 0.0 {
                            var newTargetTime = currentTime + (timeLeft / 2.0)
                            floorObj<floorData>.TryUpdateHarvestTime(k, newTargetTime, player)
                            if debugCfg.Farming() { LogInfo("[FarmingMgr] Watered: timeLeft=" + timeLeft + " newTarget=" + newTargetTime) }
                        }
                    }
                    DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floorObj, p, gen.EFarmSlotState.Growing})
                    DispatchEventToEntity(gen.OnFarmCellStateChanged, player, PlatformType.Server, List<object>{floorObj, p, gen.EFarmSlotState.Growing})
                }
            
            // ==========================================
            // STEP 4: GROWING (Idle)
            // ==========================================
            } else if intentState == gen.EFarmSlotState.Growing {
                if debugCfg.Farming() { LogInfo("[FarmingMgr] STEP4: Growing (idle, no action)") }
            
            // ==========================================
            // STEP 5: READY TO HARVEST -> TILLED DIRT
            // ==========================================
            } else if intentState == gen.EFarmSlotState.ReadyToHarvest { 
                if debugCfg.Farming() { LogInfo("[FarmingMgr] STEP5: ReadyToHarvest->Tilled") }
                
                if !map.ContainKey(floorObj<floorData>.PlantedSeeds, key) {
                    if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: no PlantedSeeds for key=" + key) }
                    return
                }
                var anchorSeedId = floorObj<floorData>.PlantedSeeds[key] as string
                var normalCropId = itemCfg.GetHarvestYield(anchorSeedId)

                if debugCfg.Farming() { LogInfo("[FarmingMgr] anchorSeed=" + anchorSeedId + " normalCrop=" + normalCropId) }

                var finalHarvestKeys = List<string>{}
                var finalHarvestPos = List<Vector3>{}

                for i = 0, validCount, 1 {
                    var k = validKeys[i]
                    if map.ContainKey(floorObj<floorData>.PlantedSeeds, k) {
                        var seedId = floorObj<floorData>.PlantedSeeds[k] as string
                        if seedId == anchorSeedId {
                            list.Append(finalHarvestKeys, k)
                            list.Append(finalHarvestPos, validPositions[i])
                        }
                    }
                }

                var harvestCount = list.Length(finalHarvestKeys)
                if harvestCount == 0 {
                    if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: harvestCount=0") }
                    return
                }

                // Collect unique (cropId, mutStr) groups for batched add
                var groupCropIds = List<string>{}
                var groupMutStrs = List<string>{}
                var groupCounts = List<int>{}

                for i = 0, harvestCount, 1 {
                    var k = finalHarvestKeys[i]
                    var cellCropId = normalCropId
                    var cellMutStr = ""
                    if map.ContainKey(floorObj<floorData>.MutationResults, k) {
                        cellMutStr = floorObj<floorData>.MutationResults[k] as string
                    }

                    var foundGroup = false
                    var gLen = list.Length(groupCropIds)
                    for g = 0, gLen, 1 {
                        if groupCropIds[g] as string == cellCropId && groupMutStrs[g] as string == cellMutStr {
                            groupCounts[g] = (groupCounts[g] as int) + 1
                            foundGroup = true
                            break
                        }
                    }
                    if !foundGroup {
                        list.Append(groupCropIds, cellCropId)
                        list.Append(groupMutStrs, cellMutStr)
                        list.Append(groupCounts, 1)
                    }
                }

                var isAdded = true
                var groupTotal = list.Length(groupCropIds)
                for g = 0, groupTotal, 1 {
                    var gCrop = groupCropIds[g] as string
                    var gMut = groupMutStrs[g] as string
                    var gCount = groupCounts[g] as int
                    var gResult = backpackMgr.AddItemWithMutation(player, gCrop, gCount, gMut)
                    if debugCfg.Farming() { LogInfo("[FarmingMgr] AddItemWithMutation | " + convert.ToString(gCount) + "x " + gCrop + " mut=" + gMut + " result=" + gResult) }
                    if debugCfg.Mutation() && gMut != "" { LogInfo("[MUTATION-HARVEST] " + convert.ToString(gCount) + "x " + gCrop + " | mutation=" + gMut + " | prefix=" + itemCfg.GetPrefixText(gMut) + " suffix=" + itemCfg.GetSuffixText(gMut) + " | sellPrice=" + convert.ToString(itemCfg.GetMutationSellPrice(gCrop, gMut))) }
                    if !gResult { isAdded = false }
                }

                if isAdded {
                    for i = 0, harvestCount, 1 {
                        var k = finalHarvestKeys[i]
                        var p = finalHarvestPos[i]

                        if map.ContainKey(floorObj<floorData>.SoilVisuals, k) {
                            var soilEntity = floorObj<floorData>.SoilVisuals[k]
                            if soilEntity != nil {
                                var vfx = GetChildByName(soilEntity, "Visual effects")
                                if vfx != nil { vfx<Entity>.ActiveSelf = false }
                            }
                        }

                        if !floorObj<floorData>.TryModifyCell(k, gen.EFarmSlotState.Tilled, player) { continue }
                        DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floorObj, p, gen.EFarmSlotState.Tilled})
                        DispatchEventToEntity(gen.OnFarmCellStateChanged, player, PlatformType.Server, List<object>{floorObj, p, gen.EFarmSlotState.Tilled})
                        
                        floorObj<floorData>.TryClearCrop(k, player)
                    }
                    if debugCfg.Farming() { LogInfo("[FarmingMgr] Harvest complete, cleared " + harvestCount + " cells") }
                }
            }
        } else {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: key=" + key + " not found in cellStates") }
        }
    }

    // ==========================================
    // PLANT ACTION (separate from harvest/hoe)
    // ==========================================

    event OnExecutePlantAction(player entity<Player>) {
        if debugCfg.Farming() { LogInfo("[FarmingMgr] >>> OnExecutePlantAction FIRED") }

        if player == nil || player<playerFarmingData>.CurrentFloor == nil {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: player is nil or CurrentFloor is nil") }
            return
        }

        var gridPos = player<playerFarmingData>.CurrentGridPos
        var key = gridUtil.GetKeyFromPos(gridPos)
        var floorObj = player<playerFarmingData>.CurrentFloor
        var cellStates = floorObj<floorData>.CellStates

        if !floorObj<floorData>.IsOwner(player) {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: not owner") }
            return
        }

        if !map.ContainKey(cellStates, key) {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: key not found=" + key) }
            return
        }

        var state = cellStates[key] as int
        if state != gen.EFarmSlotState.Tilled {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: not Tilled, state=" + state) }
            return
        }

        var holdItemId = ""
        if player<backpackData> != nil {
            var activeSlot = player<backpackData>._ActiveQuickbarSlot
            var handle = player<backpackData>._QuickSlotRefs[activeSlot]
            if handle != -1 && map.ContainKey(player<backpackData>._ItemIDs, handle) {
                holdItemId = player<backpackData>._ItemIDs[handle] as string
            }
        }

        if holdItemId == "" || itemCfg.GetType(holdItemId) != 1 {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: not holding seed") }
            return
        }

        if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT: Tilled->NeedWatering, seed=" + holdItemId) }

        var activeSlot = player<backpackData>._ActiveQuickbarSlot
        var handle = player<backpackData>._QuickSlotRefs[activeSlot]
        var isRemoved = backpackMgr.ConsumeActiveItem(player, 1)
        if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ConsumeActiveItem result=" + isRemoved) }

        if isRemoved {
            var growthTime = itemCfg.GetGrowthTime(holdItemId)
            if floorObj<floorData>.IsFertilized(key) {
                var reduction = floorObj<floorData>.FertilizerGrowthReduction[key] as float
                growthTime = growthTime * (1.0 - reduction)
                if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT Fertilized cell reduction applied, growthTime=" + growthTime) }
            }
            var harvestTime = gameMgr.GetGameTime() + growthTime

            if floorObj<floorData>.TryModifyCell(key, gen.EFarmSlotState.NeedWatering, player) {
                floorObj<floorData>.TryPlantCrop(key, holdItemId, harvestTime, gridPos, player)

                DispatchEventToEntity(gen.OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{floorObj, gridPos, gen.EFarmSlotState.NeedWatering})
                DispatchEventToEntity(gen.OnFarmCellStateChanged, player, PlatformType.Server, List<object>{floorObj, gridPos, gen.EFarmSlotState.NeedWatering})

                if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT: seed planted successfully") }
            }
        }
    }
}