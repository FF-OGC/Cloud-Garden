import "StdLibrary.fcc" as std
import "Map.fcc" as map
import "List.fcc" as list
import "Convert.fcc" as convert
import "EditorGenLib.fcc" as gen

import "./GardenData.fcg" as gardenData
import "./CropSlot.fcg" as cropSlot
import "../Core/GameManager.fcg" as gameMgr
import "../Config/DebugConfig.fcg" as debugCfg
import "./PlayerCropData.fcg" as playerCropData
import "../Backpack/BackpackData.fcg" as backpackData
import "../Backpack/BackpackManager.fcg" as backpackMgr
import "../Config/ItemConfig.fcg" as itemCfg
import "../Currency/CurrencyManager.fcg" as currencyMgr

import "../Gacha/GachaManager.fcg" as gachaManager
import "../Gacha/GachaData.fcg" as gachaData

[platform_server]
static graph FarmingManager {

    func _FindPotLuckVfxChild(potEntity entity<Entity>) entity<Entity> {
        var n = itemCfg.GetPotLuckPotionVfxChildName()
        var v = GetChildByName(potEntity, n)
        if v != nil { return v }
        return GetChildByName(potEntity, n + " ")
    }

    // Matches potion buffs on slot: grow VFX when growth pot applied, luck VFX when luck pot applied.
    func SyncPotPotionVfxOnPot(gardenEnt entity<Entity>, key string) {
        if gardenEnt == nil || gardenEnt<gardenData> == nil { return }
        var cs = gardenEnt<gardenData>.GetCropSlotByKey(key)
        if cs == nil || cs<cropSlot>.PotVisual == nil { return }
        var potEntity = cs<cropSlot>.PotVisual as entity
        if potEntity == nil { return }

        var growVfx = GetChildByName(potEntity, itemCfg.GetPotGrowPotionVfxChildName())
        var luckVfx = _FindPotLuckVfxChild(potEntity)

        var spawnPos = gardenEnt<gardenData>.GetSpawnWorldPositionForSlotKey(key)
        var py = spawnPos.Y + itemCfg.GetFarmLiftPlantY()
        var worldPos = Vector3{spawnPos.X, py, spawnPos.Z}

        var hasL = gardenEnt<gardenData>.HasLuckFertilizer(key)
        var hasG = gardenEnt<gardenData>.HasGrowthFertilizer(key)

        if growVfx != nil {
            if hasG {
                growVfx<Transform>.Position = worldPos
                growVfx<Entity>.ActiveSelf = true
            } else {
                growVfx<Transform>.LocalPosition = Vector3{0.0, 0.0, 0.0}
                growVfx<Entity>.ActiveSelf = false
            }
        }
        if luckVfx != nil {
            if hasL {
                luckVfx<Transform>.Position = worldPos
                luckVfx<Entity>.ActiveSelf = true
            } else {
                luckVfx<Transform>.LocalPosition = Vector3{0.0, 0.0, 0.0}
                luckVfx<Entity>.ActiveSelf = false
            }
        }
    }

    event OnExecuteFarmAction(player entity<Entity>) {
        if debugCfg.Farming() { LogInfo("[FarmingMgr] >>> OnExecuteFarmAction FIRED") }

        if player == nil || player<playerCropData>.CurrentGarden == nil {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: player is nil or CurrentGarden is nil") }
            return
        }

        if !player<playerCropData>.InFarmPotTrigger || player<playerCropData>.CurrentFarmSlotIndex < 0 {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: not in crop slot trigger") }
            return
        }

        var gardenEnt = player<playerCropData>.CurrentGarden
        if gardenEnt<gardenData> == nil {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: garden has no GardenData") }
            return
        }

        var key = gardenEnt<gardenData>.SlotKeyFromIndex(player<playerCropData>.CurrentFarmSlotIndex)
        if debugCfg.Farming() { LogInfo("[FarmingMgr] key=" + key) }

        if !gardenEnt<gardenData>.IsOwner(player) {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: ownership validation failed") }
            return
        }

        var cs = gardenEnt<gardenData>.GetCropSlotByKey(key)
        if cs == nil {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: no CropSlot for key") }
            return
        }

        var intentState = cs<cropSlot>.CellState
        if debugCfg.Farming() { LogInfo("[FarmingMgr] intentState=" + intentState) }

        if intentState == EFarmSlotState.Cloud {
            ProcessPaidPotGacha(player, gardenEnt, key, false)
            return
        }

        if intentState == EFarmSlotState.PotReady {
            ProcessPaidPotGacha(player, gardenEnt, key, true)
            return
        }

        if intentState == EFarmSlotState.CropGrowing {
            ProcessFertilize(player, gardenEnt, key)
            return
        }

        if intentState == EFarmSlotState.CropReady {
            ProcessHarvest(player, gardenEnt, key)
        }
    }

    // isChangePot: true = reroll skin on existing empty pot (same cost/gacha as buy); clears pot visual first so prefab refreshes.
    func ProcessPaidPotGacha(player entity<Entity>, gardenEnt entity<Entity>, key string, isChangePot bool) {
        var potItemId = itemCfg.GetPotPurchaseItemId()
        if !currencyMgr.CanAffordItem(player as entity<Player>, potItemId, 1) {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NO_GOLD_POT"})
            return
        }

        var modeStr = "buy"
        if isChangePot { modeStr = "change" }
        if debugCfg.Farming() || debugCfg.Gacha() {
            LogInfo("[POT_SHOP] [FarmingMgr] ProcessPaidPotGacha mode=" + modeStr + " key=" + key + " (Cloud=buy PotReady=change)")
        }

        if !currencyMgr.ProcessItemPurchase(player as entity<Player>, potItemId, 1) {
            if debugCfg.Farming() || debugCfg.Gacha() { LogInfo("[POT_SHOP] [FarmingMgr] ProcessPaidPotGacha aborted: payment failed key=" + key) }
            return
        }

        var n = gachaData.IncrementPotPurchaseAction(player)
        if gachaData.ShouldForceTutorialPotSkinOnce(n) {
            gachaData.MarkNextPotSkinGuaranteed(player)
        }

        if isChangePot {
            gardenEnt<gardenData>.TryClearPotVisual(key)
            if debugCfg.Farming() || debugCfg.Gacha() { LogInfo("[POT_SHOP] [FarmingMgr] change: cleared pot visual key=" + key) }
        }

        var skinTier = gachaManager.RollPotSkinTier(player)
        if debugCfg.Farming() || debugCfg.Gacha() {
            LogInfo("[POT_SHOP] [FarmingMgr] pot skin roll tier=" + convert.ToString(skinTier) + " key=" + key + " mode=" + modeStr)
        }

        gardenEnt<gardenData>.TrySetPotSkinTier(key, skinTier, player)
        gardenEnt<gardenData>.TrySetLuckyPot(key, skinTier >= 2)
        gardenEnt<gardenData>.TrySetPotTier(key, 1, player)

        if !gardenEnt<gardenData>.TryModifyCell(key, EFarmSlotState.PotReady, player) { return }

        DispatchEventToEntity(OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.PotReady})
        DispatchEventToEntity(OnFarmCellStateChanged, player, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.PotReady})
    }

    // potion_luck: mutation chance only. potion_grow: remaining time only. Each can be used once per crop.
    func ProcessFertilize(player entity<Entity>, gardenEnt entity<Entity>, key string) {
        var holdItemId = ""
        if player<backpackData> != nil {
            var activeSlot = player<backpackData>._ActiveQuickbarSlot
            var handle = player<backpackData>._QuickSlotRefs[activeSlot]
            if handle != -1 && map.ContainKey(player<backpackData>._ItemIDs, handle) {
                holdItemId = player<backpackData>._ItemIDs[handle] as string
            }
        }

        if holdItemId == "" || !itemCfg.IsFarmGrowConsumable(holdItemId) {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] CropGrowing: no luck/grow potion in hand") }
            return
        }

        if itemCfg.IsPotionLuckItem(holdItemId) {
            if gardenEnt<gardenData>.HasLuckFertilizer(key) {
                if debugCfg.Farming() { LogInfo("[FarmingMgr] FERTILIZE ABORT: luck potion already used key=" + key) }
                DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_ALREADY_LUCK_POTION"})
                return
            }
        } else if itemCfg.IsPotionGrowItem(holdItemId) {
            if gardenEnt<gardenData>.HasGrowthFertilizer(key) {
                if debugCfg.Farming() { LogInfo("[FarmingMgr] FERTILIZE ABORT: growth potion already used key=" + key) }
                DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_ALREADY_GROWTH_POTION"})
                return
            }
        }

        if debugCfg.Farming() { LogInfo("[FarmingMgr] FERTILIZE growing crop item=" + holdItemId) }

        var activeSlot2 = player<backpackData>._ActiveQuickbarSlot
        var handle2 = player<backpackData>._QuickSlotRefs[activeSlot2]
        var availableAmt = player<backpackData>._ItemAmounts[handle2] as int
        if availableAmt < 1 { return }

        var isConsumed = backpackMgr.ConsumeActiveItem(player, 1)
        if !isConsumed { return }

        if itemCfg.IsPotionLuckItem(holdItemId) {
            if !gardenEnt<gardenData>.TryApplyLuckFertilizer(key, itemCfg.GetPotionLuckMutationBonusPercent(), player) { return }
        } else {
            var growCut = itemCfg.GetPotionGrowTimeReduction()
            if !gardenEnt<gardenData>.TryApplyGrowthFertilizer(key, growCut, player) { return }

            var csGrow = gardenEnt<gardenData>.GetCropSlotByKey(key)
            if csGrow != nil {
                var now = gameMgr.GetGameTime()
                var target = csGrow<cropSlot>.HarvestTime
                if target > now {
                    var remaining = target - now
                    var newRemaining = remaining * (1.0 - growCut)
                    if newRemaining < 0.0 { newRemaining = 0.0 }
                    gardenEnt<gardenData>.TryUpdateHarvestTime(key, now + newRemaining, player)
                    if debugCfg.Farming() { LogInfo("[FarmingMgr] Growth time reduced, new target=" + convert.ToString(now + newRemaining)) }
                }

                var plantedF = csGrow<cropSlot>.PlantedSeed
                var tEnd = csGrow<cropSlot>.HarvestTime
                var tStart = csGrow<cropSlot>.GrowthStartTime
                if plantedF != "" && tEnd > now {
                    var wantKey = itemCfg.GetGrowingPlantPrefabKey(plantedF, now, tStart, tEnd)
                    var seedKeyOnly = itemCfg.GetGrowingSeedPrefabKey(plantedF)
                    if wantKey != seedKeyOnly && csGrow<cropSlot>.PlantPrefabKey == seedKeyOnly {
                        DispatchEventToEntity(OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.CropGrowing})
                        DispatchEventToEntity(OnFarmCellStateChanged, player, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.CropGrowing})
                    }
                }
            }
        }

        SyncPotPotionVfxOnPot(gardenEnt, key)
        if debugCfg.Farming() { LogInfo("[FarmingMgr] Potion applied at key=" + key) }
    }

    func ProcessHarvest(player entity<Entity>, gardenEnt entity<Entity>, key string) {
        if debugCfg.Farming() { LogInfo("[FarmingMgr] Harvest CropReady->PotReady") }

        var planted = gardenEnt<gardenData>.GetPlantedSeed(key)
        if planted == "" {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] ABORT: no PlantedSeed for key=" + key) }
            return
        }

        var normalCropId = itemCfg.GetHarvestYield(planted)
        if debugCfg.Farming() { LogInfo("[FarmingMgr] anchorSeed=" + planted + " normalCrop=" + normalCropId) }

        var cellMutStr = gardenEnt<gardenData>.GetMutationResult(key)

        var isAdded = backpackMgr.AddItemWithMutation(player, normalCropId, 1, cellMutStr)
        if debugCfg.Farming() { LogInfo("[FarmingMgr] AddItemWithMutation | result=" + isAdded) }
        if !isAdded { return }

        if !gardenEnt<gardenData>.TryModifyCell(key, EFarmSlotState.PotReady, player) { return }
        DispatchEventToEntity(OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.PotReady})
        DispatchEventToEntity(OnFarmCellStateChanged, player, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.PotReady})

        gardenEnt<gardenData>.TryClearCrop(key, player)
        SyncPotPotionVfxOnPot(gardenEnt, key)
        if debugCfg.Farming() { LogInfo("[FarmingMgr] Harvest complete") }
    }

    event OnExecutePlantAction(player entity<Player>) {
        if debugCfg.Farming() { LogInfo("[FarmingMgr] >>> OnExecutePlantAction FIRED") }

        if player == nil || player<playerCropData>.CurrentGarden == nil {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: player is nil or CurrentGarden is nil") }
            return
        }

        if !player<playerCropData>.InFarmPotTrigger || player<playerCropData>.CurrentFarmSlotIndex < 0 {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: not in slot") }
            return
        }

        var gardenEnt = player<playerCropData>.CurrentGarden
        if gardenEnt<gardenData> == nil {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: no GardenData") }
            return
        }

        var key = gardenEnt<gardenData>.SlotKeyFromIndex(player<playerCropData>.CurrentFarmSlotIndex)

        if !gardenEnt<gardenData>.IsOwner(player) {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: not owner") }
            return
        }

        var state = gardenEnt<gardenData>.GetCellState(key)
        if state != EFarmSlotState.PotReady {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: not PotReady, state=" + state) }
            return
        }

        var holdItemId = ""
        if player<backpackData> != nil {
            var activeSlot = player<backpackData>._ActiveQuickbarSlot
            var handle = player<backpackData>._QuickSlotRefs[activeSlot]
            if handle != -1 && map.ContainKey(player<backpackData>._ItemIDs, handle) {
                holdItemId = player<backpackData>._ItemIDs[handle] as string
            }
        }

        if holdItemId == "" || itemCfg.GetType(holdItemId) != 1 {
            if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ABORT: not holding seed") }
            return
        }

        if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT: PotReady->CropGrowing, seed=" + holdItemId) }

        var isRemoved = backpackMgr.ConsumeActiveItem(player, 1)
        if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT ConsumeActiveItem result=" + isRemoved) }

        if isRemoved {
            var growthTime = itemCfg.GetGrowthTime(holdItemId)
            var harvestTime = gameMgr.GetGameTime() + growthTime
            var plantPos = gardenEnt<gardenData>.GetSpawnWorldPositionForSlotKey(key)

            if gardenEnt<gardenData>.TryModifyCell(key, EFarmSlotState.CropGrowing, player) {
                gardenEnt<gardenData>.TryPlantCrop(key, holdItemId, harvestTime, plantPos, gameMgr.GetGameTime(), player)

                DispatchEventToEntity(OnFarmCellStateChanged, globalEntity, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.CropGrowing})
                DispatchEventToEntity(OnFarmCellStateChanged, player, PlatformType.Server, List<object>{gardenEnt, key, EFarmSlotState.CropGrowing})

                if debugCfg.Farming() { LogInfo("[FarmingMgr] PLANT: seed planted successfully") }
            }
        }
    }
}
