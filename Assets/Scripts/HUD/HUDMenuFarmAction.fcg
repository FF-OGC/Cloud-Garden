import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen
import "Hud.fcc" as hud
import "Map.fcc" as map
import "Convert.fcc" as convert

import "../Farming/PlayerCropData.fcg" as playerCropData
import "../Farming/GardenData.fcg" as gardenData
import "../Backpack/BackpackData.fcg" as backpackData
import "../Config/ItemConfig.fcg" as itemCfg
import "../Config/DebugConfig.fcg" as debugCfg
import "../Currency/HUDCurrency.fcg" as hudCurrency

[platform_server]
graph HUDMenuFarmAction {

    _MenuUI entity<CustomUI> = nil
    _HarvestBtn entity<UIWidget> = nil
    _HarvestText entity<UIWidget> = nil
    _PotBtn entity<UIWidget> = nil
    _PotText entity<UIWidget> = nil
    _ConsumableBtn entity<UIWidget> = nil
    _ConsumableText entity<UIWidget> = nil
    _ConsumableRoot entity<UIWidget> = nil

    _IsOnFloor bool = false
    _IsTickRunning bool = false

    COLOR_ACTIVE Color = #FFFFFF
    COLOR_INACTIVE Color = #484848

    event OnAwake() {
        if debugCfg.Farming() { LogInfo("[HUDFarmAction] OnAwake") }
        start InitWidgets()
    }

    async func InitWidgets() {
        while thisEntity<hudCurrency>._MenuUI == nil {
            WaitForMillisecond(50)
        }
        _MenuUI = thisEntity<hudCurrency>._MenuUI

        _HarvestBtn = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/harvest_btn/btn")
        _HarvestText = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/harvest_btn/text")
        _PotBtn = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/pot_btn/btn")
        _PotText = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/pot_btn/text")
        _ConsumableRoot = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/consumable_btn")
        _ConsumableBtn = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/consumable_btn/btn")
        _ConsumableText = GetWidgetByPath(thisEntity<Player>, _MenuUI, "/consumable_btn/text")

        SetConsumableBarVisible(false)

        if debugCfg.Farming() { LogInfo("[HUDFarmAction] InitWidgets OK") }

        SyncFloorState()
        UpdateHarvestBtn()
        UpdatePotBtn()
        UpdateConsumableBtn()

        if _IsOnFloor && !_IsTickRunning {
            start StartFarmingTick()
        }
    }

    func SyncFloorState() {
        var wasOnFloor = _IsOnFloor
        if thisEntity<playerCropData> == nil {
            _IsOnFloor = false
        } else {
            var floor = thisEntity<playerCropData>.CurrentGarden
            _IsOnFloor = floor != nil && floor<gardenData> != nil
        }
        if debugCfg.Farming() && wasOnFloor != _IsOnFloor {
            LogInfo("[HUDFarmAction] SyncFloorState CHANGED | " + convert.ToString(wasOnFloor) + " -> " + convert.ToString(_IsOnFloor))
        }
    }

    event OnPlayerTapButton(button entity<UIWidgetButton>, player entity<Player>) {
        if player == nil || button == nil { return }
        if !HasComponent(button, typeof(MyButton)) { return }

        var btnType = button<MyButton>.Type

        if btnType == "harvest_btn" {
            if debugCfg.Farming() { LogInfo("[HUDFarmAction] TAP harvest_btn") }
            HandleHarvestTap(player)
        } else if btnType == "pot_btn" {
            if debugCfg.Farming() { LogInfo("[HUDFarmAction] TAP pot_btn") }
            HandlePotTap(player)
        } else if btnType == "consumable_btn" {
            if debugCfg.Farming() { LogInfo("[HUDFarmAction] TAP consumable_btn") }
            HandleConsumableTap(player)
        }
    }

    func HandlePotTap(player entity<Player>) {
        SyncFloorState()
        if !_IsOnFloor {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NOT_ON_FLOOR"})
            return
        }
        var floor = player<playerCropData>.CurrentGarden
        if floor == nil || floor<gardenData> == nil {
            return
        }
        if !player<playerCropData>.InFarmPotTrigger || player<playerCropData>.CurrentFarmSlotIndex < 0 {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NOT_ON_FLOOR"})
            return
        }
        if !floor<gardenData>.IsOwner(player as entity<Entity>) {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_OTHER_PLAYER_GARDEN"})
            return
        }
        player<playerCropData>._PotShopFromConsumableBtn = false
        DispatchEventToEntity(OnPlayerPotShopAction, globalEntity, PlatformType.Server, List<object>{player as entity<Entity>})
    }

    func HandleConsumableTap(player entity<Player>) {
        SyncFloorState()
        if !IsHoldingConsumable(player) {
            return
        }
        if !_IsOnFloor {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NOT_ON_FLOOR_ITEM"})
            return
        }

        var floor = player<playerCropData>.CurrentGarden
        if floor == nil || floor<gardenData> == nil {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NOT_ON_FLOOR_ITEM"})
            return
        }

        if !player<playerCropData>.InFarmPotTrigger || player<playerCropData>.CurrentFarmSlotIndex < 0 {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NOT_ON_FLOOR_ITEM"})
            return
        }

        if !floor<gardenData>.IsOwner(player as entity<Entity>) {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_OTHER_PLAYER_GARDEN"})
            return
        }

        var key = floor<gardenData>.SlotKeyFromIndex(player<playerCropData>.CurrentFarmSlotIndex)
        var state = floor<gardenData>.GetCellState(key)
        if state != EFarmSlotState.CropGrowing {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_ITEM_WRONG"})
            return
        }

        player<playerCropData>._PotShopFromConsumableBtn = true
        DispatchEventToEntity(OnPlayerPotShopAction, globalEntity, PlatformType.Server, List<object>{player as entity<Entity>})
    }

    func HandleHarvestTap(player entity<Player>) {
        SyncFloorState()

        if !_IsOnFloor {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NOT_ON_FLOOR"})
            return
        }

        var floor = player<playerCropData>.CurrentGarden
        if floor == nil || floor<gardenData> == nil {
            _IsOnFloor = false
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NOT_ON_FLOOR"})
            return
        }

        if !player<playerCropData>.InFarmPotTrigger || player<playerCropData>.CurrentFarmSlotIndex < 0 {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NOT_ON_FLOOR"})
            return
        }

        if !floor<gardenData>.IsOwner(player as entity<Entity>) {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_OTHER_PLAYER_GARDEN"})
            return
        }

        var key = floor<gardenData>.SlotKeyFromIndex(player<playerCropData>.CurrentFarmSlotIndex)
        var state = floor<gardenData>.GetCellState(key)

        if state == EFarmSlotState.CropGrowing {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_STILL_GROWING"})
            return
        }

        if state == EFarmSlotState.PotReady && IsHoldingSeed(player) {
            DispatchEventToEntity(OnPlayerPlantAction, globalEntity, PlatformType.Server, List<object>{player})
            return
        }

        if state == EFarmSlotState.CropReady {
            DispatchEventToEntity(OnExecuteFarmAction, globalEntity, PlatformType.Server, List<object>{player as entity<Entity>})
            return
        }

        if state == EFarmSlotState.Cloud {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NEED_PREPARE_FIRST"})
            return
        }

        if state == EFarmSlotState.PotReady {
            DispatchEventToEntity(OnShowPrompt, player, PlatformType.Server, List<object>{"PROMPT_NO_EQUIP"})
            return
        }
    }

    event OnPlayerEnterFloor(player entity<Player>, floor entity<Entity>) {
        if player != thisEntity<Player> { return }
        if debugCfg.Farming() { LogInfo("[HUDFarmAction] OnPlayerEnterFloor") }
        SyncFloorState()
        UpdateHarvestBtn()
        UpdatePotBtn()
        UpdateConsumableBtn()
        if _IsOnFloor && !_IsTickRunning {
            start StartFarmingTick()
        }
    }

    event OnPlayerLeaveFloor(player entity<Player>) {
        if player != thisEntity<Player> { return }
        if debugCfg.Farming() { LogInfo("[HUDFarmAction] OnPlayerLeaveFloor") }
        SyncFloorState()
        UpdateHarvestBtn()
        UpdatePotBtn()
        UpdateConsumableBtn()
    }

    event OnBackpackDataChanged(owner entity<Entity>) {
        if owner != thisEntity<Entity> { return }
        UpdateHarvestBtn()
        UpdatePotBtn()
        UpdateConsumableBtn()
    }

    event OnFarmCellStateChanged(floor entity<Entity>, slotKey string, newState int) {
        if !_IsOnFloor { return }
        if debugCfg.Farming() { LogInfo("[HUDFarmAction] OnFarmCellStateChanged | newState=" + newState) }
        UpdateHarvestBtn()
        UpdatePotBtn()
        UpdateConsumableBtn()
    }

    async func StartFarmingTick() {
        _IsTickRunning = true
        if debugCfg.Farming() { LogInfo("[HUDFarmAction] StartFarmingTick BEGIN") }
        while _IsOnFloor {
            WaitForMillisecond(100)
            SyncFloorState()
            if !_IsOnFloor { break }
            UpdateHarvestBtn()
            UpdatePotBtn()
            UpdateConsumableBtn()
        }
        if debugCfg.Farming() { LogInfo("[HUDFarmAction] StartFarmingTick END") }
        _IsTickRunning = false
    }

    func UpdateHarvestBtn() {
        if _HarvestBtn == nil || _HarvestText == nil { return }

        if !_IsOnFloor {
            SetHarvestBtnState(COLOR_INACTIVE, "Plant", EResSprite.icon_plan)
            return
        }

        if thisEntity<playerCropData> == nil { return }
        var floor = thisEntity<playerCropData>.CurrentGarden
        if floor == nil || floor<gardenData> == nil {
            SetHarvestBtnState(COLOR_INACTIVE, "Plant", EResSprite.icon_plan)
            return
        }

        if !thisEntity<playerCropData>.InFarmPotTrigger || thisEntity<playerCropData>.CurrentFarmSlotIndex < 0 {
            SetHarvestBtnState(COLOR_INACTIVE, "Plant", EResSprite.icon_plan)
            return
        }

        var key = floor<gardenData>.SlotKeyFromIndex(thisEntity<playerCropData>.CurrentFarmSlotIndex)
        var state = floor<gardenData>.GetCellState(key)
        var isOwnerGarden = floor<gardenData>.IsOwner(thisEntity as entity<Entity>)

        if state == EFarmSlotState.Cloud {
            SetHarvestBtnState(COLOR_INACTIVE, "Plant", EResSprite.icon_plan)
        } else if state == EFarmSlotState.PotReady {
            if isOwnerGarden && IsHoldingSeed(thisEntity) {
                SetHarvestBtnState(COLOR_ACTIVE, "Plant", EResSprite.icon_plan)
            } else {
                SetHarvestBtnState(COLOR_INACTIVE, "Plant", EResSprite.icon_plan)
            }
        } else if state == EFarmSlotState.CropGrowing {
            SetHarvestBtnState(COLOR_INACTIVE, "Growing", EResSprite.icon_plan)
        } else if state == EFarmSlotState.CropReady {
            if isOwnerGarden {
                SetHarvestBtnState(COLOR_ACTIVE, "Harvest", EResSprite.icon_harvest)
            } else {
                SetHarvestBtnState(COLOR_INACTIVE, "Harvest", EResSprite.icon_harvest)
            }
        } else {
            SetHarvestBtnState(COLOR_INACTIVE, "Plant", EResSprite.icon_plan)
        }
    }

    func UpdatePotBtn() {
        if _PotBtn == nil { return }
        if _PotText == nil { return }

        _PotBtn<UIWidgetButton>.SpriteResource = EResSprite.icon_pot

        if !_IsOnFloor || thisEntity<playerCropData> == nil {
            _PotBtn<UIWidgetButton>.Color = COLOR_INACTIVE
            _PotText<UIWidgetLabel>.Content = "Pot"
            return
        }

        var floor = thisEntity<playerCropData>.CurrentGarden
        if floor == nil || floor<gardenData> == nil {
            _PotBtn<UIWidgetButton>.Color = COLOR_INACTIVE
            _PotText<UIWidgetLabel>.Content = "Pot"
            return
        }

        if !thisEntity<playerCropData>.InFarmPotTrigger || thisEntity<playerCropData>.CurrentFarmSlotIndex < 0 {
            _PotBtn<UIWidgetButton>.Color = COLOR_INACTIVE
            _PotText<UIWidgetLabel>.Content = "Pot"
            return
        }

        var key = floor<gardenData>.SlotKeyFromIndex(thisEntity<playerCropData>.CurrentFarmSlotIndex)
        var state = floor<gardenData>.GetCellState(key)
        var isOwnerGarden = floor<gardenData>.IsOwner(thisEntity as entity<Entity>)

        if state == EFarmSlotState.Cloud {
            if isOwnerGarden {
                _PotBtn<UIWidgetButton>.Color = COLOR_ACTIVE
                _PotText<UIWidgetLabel>.Content = "Buy"
            } else {
                _PotBtn<UIWidgetButton>.Color = COLOR_INACTIVE
                _PotText<UIWidgetLabel>.Content = "Pot"
            }
        } else if state == EFarmSlotState.PotReady {
            if isOwnerGarden {
                _PotBtn<UIWidgetButton>.Color = COLOR_ACTIVE
                _PotText<UIWidgetLabel>.Content = "Change"
            } else {
                _PotBtn<UIWidgetButton>.Color = COLOR_INACTIVE
                _PotText<UIWidgetLabel>.Content = "Pot"
            }
        } else {
            _PotBtn<UIWidgetButton>.Color = COLOR_INACTIVE
            _PotText<UIWidgetLabel>.Content = "Pot"
        }
    }

    // Consumable bar: only visible when the *active* quick_slot holds a consumable (hand). Otherwise hidden entirely.
    func SetConsumableBarVisible(visible bool) {
        if _ConsumableRoot != nil {
            _ConsumableRoot<Entity>.ActiveSelf = visible
        }
        if _ConsumableBtn != nil {
            _ConsumableBtn<Entity>.ActiveSelf = visible
        }
        if _ConsumableText != nil {
            _ConsumableText<Entity>.ActiveSelf = visible
        }
    }

    func UpdateConsumableBtn() {
        if _ConsumableBtn == nil { return }
        if _ConsumableText == nil { return }

        if !IsHoldingConsumable(thisEntity) {
            SetConsumableBarVisible(false)
            return
        }

        SetConsumableBarVisible(true)

        _ConsumableBtn<UIWidgetButton>.SpriteResource = EResSprite.icon_useItem
        _ConsumableText<UIWidgetLabel>.Content = "Use"

        if !_IsOnFloor || thisEntity<playerCropData> == nil {
            _ConsumableBtn<UIWidgetButton>.Color = COLOR_INACTIVE
            return
        }

        var floor = thisEntity<playerCropData>.CurrentGarden
        if floor == nil || floor<gardenData> == nil || !thisEntity<playerCropData>.InFarmPotTrigger || thisEntity<playerCropData>.CurrentFarmSlotIndex < 0 {
            _ConsumableBtn<UIWidgetButton>.Color = COLOR_INACTIVE
            return
        }

        var key = floor<gardenData>.SlotKeyFromIndex(thisEntity<playerCropData>.CurrentFarmSlotIndex)
        var state = floor<gardenData>.GetCellState(key)

        var heldConsumable = ""
        if thisEntity<backpackData> != nil {
            var h = thisEntity<backpackData>._QuickSlotRefs[thisEntity<backpackData>._ActiveQuickbarSlot]
            if h != -1 && map.ContainKey(thisEntity<backpackData>._ItemIDs, h) {
                heldConsumable = thisEntity<backpackData>._ItemIDs[h] as string
            }
        }

        var isOwnerGarden = floor<gardenData>.IsOwner(thisEntity as entity<Entity>)

        if state == EFarmSlotState.CropGrowing && isOwnerGarden {
            var canUse = false
            if itemCfg.IsPotionLuckItem(heldConsumable) && !floor<gardenData>.HasLuckFertilizer(key) { canUse = true }
            if itemCfg.IsPotionGrowItem(heldConsumable) && !floor<gardenData>.HasGrowthFertilizer(key) { canUse = true }
            if canUse {
                _ConsumableBtn<UIWidgetButton>.Color = COLOR_ACTIVE
            } else {
                _ConsumableBtn<UIWidgetButton>.Color = COLOR_INACTIVE
            }
        } else {
            _ConsumableBtn<UIWidgetButton>.Color = COLOR_INACTIVE
        }
    }

    func SetHarvestBtnState(color Color, text string, icon SpriteID) {
        if _HarvestBtn != nil {
            _HarvestBtn<UIWidgetButton>.Color = color
            _HarvestBtn<UIWidgetButton>.SpriteResource = icon
        }
        if _HarvestText != nil {
            _HarvestText<UIWidgetLabel>.Content = text
        }
    }

    func IsHoldingSeed(player entity<Entity>) bool {
        if player<backpackData> == nil { return false }
        var activeSlot = player<backpackData>._ActiveQuickbarSlot
        var handle = player<backpackData>._QuickSlotRefs[activeSlot]
        if handle == -1 { return false }
        if !map.ContainKey(player<backpackData>._ItemIDs, handle) { return false }
        var heldId = player<backpackData>._ItemIDs[handle] as string
        return itemCfg.GetType(heldId) == 1
    }

    // True only if the *selected* quick bar slot (hand) has a consumable equipped.
    func IsHoldingConsumable(player entity<Entity>) bool {
        if player<backpackData> == nil { return false }
        var activeSlot = player<backpackData>._ActiveQuickbarSlot
        var handle = player<backpackData>._QuickSlotRefs[activeSlot]
        if handle == -1 { return false }
        if !map.ContainKey(player<backpackData>._ItemIDs, handle) { return false }
        var heldId = player<backpackData>._ItemIDs[handle] as string
        return itemCfg.IsFarmGrowConsumable(heldId)
    }
}
