import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as gen
import "Hud.fcc" as Hud
import "Map.fcc" as Map
import "Convert.fcc" as convert

import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
graph HudPrompt {

    PROMPT_DURATION = 3000

    PROMPT_MESSAGES Map<string, string> = Map<string, string>{
        "PROMPT_ITEM_WRONG": "Use consumables on an empty pot (ready to plant)!",
        "PROMPT_NOT_ON_FLOOR": "Go to your garden to start farming!",
        "PROMPT_NOT_ON_FLOOR_PLANT": "Go to your garden to plant seeds!",
        "PROMPT_NO_EQUIP": "Equip a seed from your backpack to plant!",
        "PROMPT_NEED_PREPARE_FIRST": "Buy a pot on the edge columns before planting!",
        "PROMPT_STILL_GROWING": "Your crops are still growing!",
        "PROMPT_NOT_ON_FLOOR_ITEM": "Go to your garden to use this item!",
        "PROMPT_MARKET_NO_CROP": "Switch to a crop in your quickbar to sell!",
        "PROMPT_MARKET_EMPTY_HAND": "Equip a crop from your backpack to sell!",
        "PROMPT_ALREADY_FERTILIZED": "This pot is already fertilized!",
        "PROMPT_WALKWAY_NO_POT": "Walkway — buy pots on the left or right columns only!",
        "PROMPT_NO_GOLD_POT": "Not enough gold to buy a pot!",
    }

    PROMPT_COLORS Map<string, Color> = Map<string, Color>{
        "PROMPT_ITEM_WRONG": #FABF00,
        "PROMPT_NOT_ON_FLOOR": #FABF00,
        "PROMPT_NOT_ON_FLOOR_PLANT": #FABF00,
        "PROMPT_NO_EQUIP": #FABF00,
        "PROMPT_NEED_PREPARE_FIRST": #FABF00,
        "PROMPT_STILL_GROWING": #FABF00,
        "PROMPT_NOT_ON_FLOOR_ITEM": #FABF00,
        "PROMPT_MARKET_NO_CROP": #FABF00,
        "PROMPT_MARKET_EMPTY_HAND": #FABF00,
        "PROMPT_ALREADY_FERTILIZED": #FABF00,
        "PROMPT_WALKWAY_NO_POT": #FABF00,
        "PROMPT_NO_GOLD_POT": #FABF00,
    }

    _PromptHUD entity<CustomUI>
    _BgLeftImg entity<UIWidgetImage>
    _BgRightImg entity<UIWidgetImage>
    _IconLeftImg entity<UIWidgetImage>
    _IconRightImg entity<UIWidgetImage>
    _ContentLabel entity<UIWidgetLabel>
    _CountPrompt int

    event OnAwake() {
        _CountPrompt = 0

        CreateCustomUI(out var promptHud, thisEntity<Player>, EResUI.prompt)
        if promptHud != nil {
            _PromptHUD = promptHud
            _PromptHUD<CustomUI>.Depth = 200

            var container entity<UIWidget> = GetChildByIndex(_PromptHUD, 0) as entity<UIWidget>
            if container != nil {
                _BgLeftImg = GetChildByIndex(container, 0) as entity<UIWidgetImage>
                _BgRightImg = GetChildByIndex(container, 1) as entity<UIWidgetImage>
                _IconLeftImg = GetChildByIndex(container, 2) as entity<UIWidgetImage>
                _IconRightImg = GetChildByIndex(container, 3) as entity<UIWidgetImage>
                _ContentLabel = GetChildByIndex(container, 4) as entity<UIWidgetLabel>
            }

            HidePromptHUD()
            if debugCfg.Prompt() { LogInfo("[HudPrompt] OnAwake OK | label=" + convert.ToString(_ContentLabel != nil)) }
        } else {
            if debugCfg.Prompt() { LogWarning("[HudPrompt] OnAwake FAILED | CreateCustomUI returned nil") }
        }
    }

    event OnShowPrompt(prompt string) {
        if debugCfg.Prompt() { LogInfo("[HudPrompt] OnShowPrompt | prompt=" + prompt + " ready=" + convert.ToString(_PromptHUD != nil)) }
        if _PromptHUD == nil { return }
        start ShowPromptHUD(prompt)
    }

    async func ShowPromptHUD(prompt string) {
        if _PromptHUD == nil { return }

        if debugCfg.Prompt() { LogInfo("[HudPrompt] ShowPromptHUD | showing prompt=" + prompt) }

        UpdatePromptHUD(prompt)
        _PromptHUD<CustomUI>.IsVisible = true

        _CountPrompt += 1

        WaitForMillisecond(PROMPT_DURATION)
        if _CountPrompt > 0 {
            _CountPrompt -= 1
        }

        if _CountPrompt <= 0 {
            HidePromptHUD()
            if debugCfg.Prompt() { LogInfo("[HudPrompt] ShowPromptHUD | auto-hide") }
        }
    }

    func HidePromptHUD() {
        if _PromptHUD == nil { return }
        _PromptHUD<CustomUI>.IsVisible = false
    }

    func UpdatePromptHUD(prompt string) {
        if _ContentLabel == nil { return }

        var color = #FABF00
        if Map.ContainKey(PROMPT_COLORS, prompt) {
            color = PROMPT_COLORS[prompt]
        }

        if _BgLeftImg != nil { _BgLeftImg<UIWidgetImage>.Color = color }
        if _BgRightImg != nil { _BgRightImg<UIWidgetImage>.Color = color }
        if _IconLeftImg != nil { _IconLeftImg<UIWidgetImage>.Color = color }
        if _IconRightImg != nil { _IconRightImg<UIWidgetImage>.Color = color }

        if Map.ContainKey(PROMPT_MESSAGES, prompt) {
            _ContentLabel<UIWidgetLabel>.Content = PROMPT_MESSAGES[prompt]
        } else {
            _ContentLabel<UIWidgetLabel>.Content = prompt
        }
    }
}
