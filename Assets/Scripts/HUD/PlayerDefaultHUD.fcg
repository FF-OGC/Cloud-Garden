import "StdLibrary.fcc" as StdLib
import "EditorGenLib.fcc" as gen
import "Player.fcc" as Player

[platform_server]
graph PlayerDefaultHUD {

    event OnAwake() {
        TurnOffDefaultPlayerHUD();
    }

    func TurnOffDefaultPlayerHUD() {
        // Turn off all HUD Default UI, Just remain Joystick and Jump
        // SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Sprint, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Attack, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.KillingTips, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.WeaponSlot, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.MiniMap, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Bag, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.MedicalProps, ThreeStatusSwitch.Close);
        // SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Crouch, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Prone, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.TeammatesInfo, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.AttackGrenade, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.DefenceGrenade, ThreeStatusSwitch.Close);
        // SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Emote, ThreeStatusSwitch.Close);
        // SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.QuickChat, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Pickups, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.QuickChatShow, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.HP, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.EP, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Armor, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Reload, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.SweapWeaponQuick, ThreeStatusSwitch.Close);
        // SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Speaker, ThreeStatusSwitch.Close);
        // SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.MicroPhone, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Mark, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Signal, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.ActiveSkill, ThreeStatusSwitch.Close);
        // SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Crosshairs, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.PassiveSkill, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.FPPInspectionHUD, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.RequestHelp, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.HelpUpOthers, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.Attack2HUD, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.CombineWeaponHUD, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.SwimmingSurfHUD, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.ActionHud, ThreeStatusSwitch.Close);
        SetDefaultUIStatus(thisEntity<Player>, DefaultUIType.TakePhotoHud, ThreeStatusSwitch.Close);
    }
}
