import "StdLibrary.fcc" as std
import "EditorGenLib.fcc" as gen
import "List.fcc" as list
import "Map.fcc" as map
import "Convert.fcc" as convert
import "Hud.fcc" as hud

import "./BackpackData.fcg" as backpackData
import "../Services/Utils/UIUtil.fcg" as uiUtil
import "../Config/ItemConfig.fcg" as itemCfg
import "../Config/MutationConfig.fcg" as mutCfg
import "../Services/BackpackService.fcg" as backpackService
import "../Core/GameManager.fcg" as gameManager
import "../Config/DebugConfig.fcg" as debugCfg

[platform_server]
graph PlayerBackpackVisual {
    
    _BackpackUI entity<CustomUI>
    _MainPanel entity<UIWidget>
    _QuickSlotPanel entity<UIWidget>
    _ToggleBtn entity<UIWidget>

    _IsOpen bool = false
    _SelectedSlotIndex int = -1
    
    event OnAwake() {
        CreateCustomUI(out var uiInstance, thisEntity<Player>, EResUI.backpack)
        if uiInstance != nil {
            _BackpackUI = uiInstance
            _MainPanel = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root")
            _QuickSlotPanel = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/quick_slot")
            _ToggleBtn = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/backpack")

            // Pre-assign Arg0 to pass index when UI is clicked
            // Quick slot: entity "0","1",... IS the button itself (no "/btn" sub-child)
            for i = 0, 5, 1 {
                var qBtn = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/quick_slot/" + convert.ToString(i))
                if qBtn != nil { qBtn<MyButton>.Arg0 = i }
            }
            for i = 0, 40, 1 {
                var btn = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/scroll/layout/slot (" + convert.ToString(i) + ")/btn")
                if btn != nil { btn<MyButton>.Arg0 = i }
            }

            _IsOpen = false
            if _MainPanel != nil { _MainPanel<UIWidget>.IsVisible = false }
        }
    }

    event OnBackpackDataChanged(owner entity<Entity>) {
        if debugCfg.Backpack() { LogInfo("[PlayerBackpackVisual] OnBackpackDataChanged received | ownerMatch=" + convert.ToString(owner == thisEntity<Entity>)) }
        if owner == thisEntity<Entity> { RefreshVisuals() }
    }

    func ToggleBackpack() {
        if _MainPanel == nil { return }
        _IsOpen = !_IsOpen
        _MainPanel<UIWidget>.IsVisible = _IsOpen
        if !_IsOpen { _HideInspector() }
    }

    func RefreshVisuals() {
        if debugCfg.Backpack() { LogInfo("[PlayerBackpackVisual] RefreshVisuals called | backpackData=" + convert.ToString(thisEntity<backpackData> != nil)) }
        if thisEntity<backpackData> == nil { return }

        // 1. Render Quick Slots
        for i = 0, 5, 1 {
            var handle = thisEntity<backpackData>._QuickSlotRefs[i]
            var path = "/quick_slot/" + convert.ToString(i)
            
            if debugCfg.Backpack() { 
                var dbgItemId = ""
                var dbgAmount = 0
                if handle != -1 && map.ContainKey(thisEntity<backpackData>._ItemIDs, handle) {
                    dbgItemId = thisEntity<backpackData>._ItemIDs[handle] as string
                    dbgAmount = thisEntity<backpackData>._ItemAmounts[handle] as int
                }
                LogInfo("[PlayerBackpackVisual] QuickSlot[" + convert.ToString(i) + "] handle=" + convert.ToString(handle) + " itemId=" + dbgItemId + " amount=" + convert.ToString(dbgAmount) + " activeSlot=" + convert.ToString(thisEntity<backpackData>._ActiveQuickbarSlot))
            }

            if handle != -1 && map.ContainKey(thisEntity<backpackData>._ItemIDs, handle) {
                var itemId = thisEntity<backpackData>._ItemIDs[handle] as string
                var amount = thisEntity<backpackData>._ItemAmounts[handle] as int
                var mutStr = ""
                if map.ContainKey(thisEntity<backpackData>._ItemMutations, handle) {
                    mutStr = thisEntity<backpackData>._ItemMutations[handle] as string
                }
                _SetSlotVisualWithMutation(path, itemId, amount, mutStr)
            } else {
                _ClearSlotVisual(path)
            }
            
            // Highlight active QuickSlot
            var highlight = GetWidgetByPath(thisEntity<Player>, _BackpackUI, path + "/highlight")
            if highlight != nil {
                if i == thisEntity<backpackData>._ActiveQuickbarSlot { 
                    highlight<UIWidgetImage>.Alpha = 1.0 
                } else { highlight<UIWidgetImage>.Alpha = 0.0 }
            } else {
                if debugCfg.Backpack() { LogInfo("[PlayerBackpackVisual] highlight NOT FOUND at: " + path + "/highlight") }
            }
        }

        // 2. Render Backpack Slots
        for i = 0, thisEntity<backpackData>._MaxCapacity, 1 {
            var handle = thisEntity<backpackData>._BackpackRefs[i]
            var path = "/root/scroll/layout/slot (" + convert.ToString(i) + ")"
            
            if debugCfg.Backpack() && handle != -1 { LogInfo("[PlayerBackpackVisual] BackpackSlot[" + convert.ToString(i) + "] handle=" + convert.ToString(handle)) }

            if handle != -1 && map.ContainKey(thisEntity<backpackData>._ItemIDs, handle) {
                var itemId = thisEntity<backpackData>._ItemIDs[handle] as string
                var amount = thisEntity<backpackData>._ItemAmounts[handle] as int
                var mutStr = ""
                if map.ContainKey(thisEntity<backpackData>._ItemMutations, handle) {
                    mutStr = thisEntity<backpackData>._ItemMutations[handle] as string
                }
                if(debugCfg.Backpack()) {
                    LogInfo("[PlayerBackpackVisual] Path" + path)
                }
                _SetSlotVisualWithMutation(path, itemId, amount, mutStr)
            } else {
                _ClearSlotVisual(path)
            }
        }
    }

    func HandleSlotPressed(btnType string, slotIndex int) {
        if btnType == "backpack_slot" {
            if !_IsOpen { return }
            backpackService.ToggleEquipItem(thisEntity<Entity>, slotIndex)
            _ShowInspector(slotIndex)

        } else if btnType == "backpack_interact" {
            if _SelectedSlotIndex < 0 { return }
            backpackService.ToggleEquipItem(thisEntity<Entity>, _SelectedSlotIndex)

        } else if btnType == "backpack_lock" {
            if _SelectedSlotIndex < 0 { return }

        } else if btnType == "backpack_close" {
            _HideInspector()

        } else if btnType == "quick_slot" {
            backpackService.SetActiveQuickSlot(thisEntity<Entity>, slotIndex)
        }
    }

// --- UI HELPER FUNCTIONS ---

    func _SetSlotVisual(slotPath string, itemId string, amount int) {
        _SetSlotVisualWithMutation(slotPath, itemId, amount, "")
    }

    func _SetSlotVisualWithMutation(slotPath string, itemId string, amount int, mutStr string) {
        // Quick slot path: /quick_slot/0..4  |  Backpack slot path: /root/scroll/layout/slot (N)
        var isQuickSlot = slotPath == "/quick_slot/0" || slotPath == "/quick_slot/1" || slotPath == "/quick_slot/2" || slotPath == "/quick_slot/3" || slotPath == "/quick_slot/4"

        var iconObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/rarity/item_icon")
        if iconObj == nil { 
            iconObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/icon") 
        }
        if iconObj != nil {
            iconObj<UIWidgetImage>.Alpha = 1.0
            iconObj<UIWidgetImage>.SpriteName = itemCfg.GetIconKey(itemId)
        }

        var isCrop = itemCfg.GetType(itemId) == 2
        var hasMutation = mutStr != ""

        if isQuickSlot {
            var numObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/num")
            var textObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/text")

            if textObj != nil {
                textObj<UIWidgetLabel>.Alpha = 1.0
                textObj<UIWidgetLabel>.Content = itemCfg.GetItemName(itemId)
            }
            if numObj != nil {
                numObj<UIWidgetLabel>.Alpha = 1.0
                numObj<UIWidgetLabel>.Content = convert.ToString(amount)
            }
        } else {
            var nameObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/item_name")
            if nameObj != nil {
                nameObj<UIWidgetLabel>.Alpha = 0.0
            }

            var itemPrefixObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/item_prefix")
            if itemPrefixObj != nil {
                if isCrop {
                    var prefixId = itemCfg.ParseMutationPrefix(mutStr)
                    itemPrefixObj<UIWidgetLabel>.Alpha = 1.0
                    itemPrefixObj<UIWidgetLabel>.Content = itemCfg.GetPrefixText(mutStr)
                    itemPrefixObj<UIWidgetLabel>.Color = mutCfg.GetPrefixColor(prefixId)
                } else {
                    itemPrefixObj<UIWidgetLabel>.Alpha = 0.0
                }
            }

            var itemSuffixObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/item_suffix")
            if itemSuffixObj != nil {
                if isCrop {
                    itemSuffixObj<UIWidgetLabel>.Alpha = 1.0
                    itemSuffixObj<UIWidgetLabel>.Content = itemCfg.GetSuffixText(mutStr)
                } else {
                    itemSuffixObj<UIWidgetLabel>.Alpha = 0.0
                }
            }

            var amountObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/item_amount")
            if amountObj != nil {
                if isCrop {
                    amountObj<UIWidgetLabel>.Alpha = 0.0
                } else {
                    amountObj<UIWidgetLabel>.Alpha = 1.0
                    amountObj<UIWidgetLabel>.Content = convert.ToString(amount)
                }
            }
        }
    }

    func _ClearSlotVisual(slotPath string) {
        var isQuickSlot = slotPath == "/quick_slot/0" || slotPath == "/quick_slot/1" || slotPath == "/quick_slot/2" || slotPath == "/quick_slot/3" || slotPath == "/quick_slot/4"

        var iconObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/rarity/item_icon")
        if iconObj == nil { 
            iconObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/icon") 
        }
        if iconObj != nil { iconObj<UIWidgetImage>.Alpha = 0.0 }

        if isQuickSlot {
            var numObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/num")
            if numObj != nil { numObj<UIWidgetLabel>.Alpha = 0.0 }
            var textObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/text")
            if textObj != nil { textObj<UIWidgetLabel>.Alpha = 0.0 }
        } else {
            var nameObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/item_name")
            if nameObj != nil { nameObj<UIWidgetLabel>.Alpha = 0.0 }
            var itemPrefixObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/item_prefix")
            if itemPrefixObj != nil { itemPrefixObj<UIWidgetLabel>.Alpha = 0.0 }
            var itemSuffixObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/item_suffix")
            if itemSuffixObj != nil { itemSuffixObj<UIWidgetLabel>.Alpha = 0.0 }
            var amountObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, slotPath + "/item_amount")
            if amountObj != nil { amountObj<UIWidgetLabel>.Alpha = 0.0 }
        }
    }

// --- INSPECTOR PANEL ---

    func _ShowInspector(slotIndex int) {
        _SelectedSlotIndex = slotIndex
        var handle = thisEntity<backpackData>._BackpackRefs[slotIndex]

        var inspectorBg = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector")
        if inspectorBg != nil { inspectorBg<UIWidget>.IsVisible = true }

        var noneObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/none")
        var type2Obj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2")
        var type1Obj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type1")
        var rarityObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/rarity")

        if handle == -1 || !map.ContainKey(thisEntity<backpackData>._ItemIDs, handle) {
            if noneObj != nil { noneObj<UIWidget>.IsVisible = true }
            if type2Obj != nil { type2Obj<UIWidget>.IsVisible = false }
            if type1Obj != nil { type1Obj<UIWidget>.IsVisible = false }
            if rarityObj != nil { rarityObj<UIWidget>.IsVisible = false }
            return
        }

        var itemId = thisEntity<backpackData>._ItemIDs[handle] as string
        var amount = thisEntity<backpackData>._ItemAmounts[handle] as int
        var mutStr = ""
        if map.ContainKey(thisEntity<backpackData>._ItemMutations, handle) {
            mutStr = thisEntity<backpackData>._ItemMutations[handle] as string
        }

        if noneObj != nil { noneObj<UIWidget>.IsVisible = false }
        if rarityObj != nil { rarityObj<UIWidgetImage>.Alpha = 1.0 }

        var iconObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/rarity/icon")
        if iconObj != nil {
            iconObj<UIWidgetImage>.Alpha = 1.0
            iconObj<UIWidgetImage>.SpriteName = itemCfg.GetIconKey(itemId)
        }

        var isCrop = itemCfg.GetType(itemId) == 2

        if type2Obj != nil { type2Obj<UIWidget>.IsVisible = true }
        if type1Obj != nil { type1Obj<UIWidget>.IsVisible = false }

        var nameObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2/name")
        if nameObj != nil { nameObj<UIWidgetLabel>.Content = itemCfg.GetItemName(itemId) }

        var prefixObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2/Prefix")
        var suffixObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2/Suffix")

        if isCrop {
            if prefixObj != nil {
                var prefixId = itemCfg.ParseMutationPrefix(mutStr)
                prefixObj<UIWidgetLabel>.Alpha = 1.0
                prefixObj<UIWidgetLabel>.Content = itemCfg.GetPrefixText(mutStr)
                prefixObj<UIWidgetLabel>.Color = mutCfg.GetPrefixColor(prefixId)
            }
            if suffixObj != nil {
                suffixObj<UIWidgetLabel>.Alpha = 1.0
                suffixObj<UIWidgetLabel>.Content = itemCfg.GetSuffixText(mutStr)
            }
        } else {
            if prefixObj != nil { prefixObj<UIWidgetLabel>.Alpha = 0.0 }
            if suffixObj != nil { suffixObj<UIWidgetLabel>.Alpha = 0.0 }
        }

        var prePriceObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2/pre_price")
        if prePriceObj != nil { prePriceObj<UIWidgetLabel>.Content = "Sell Price:" }

        var priceObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2/price")
        if priceObj != nil {
            if isCrop {
                priceObj<UIWidgetLabel>.Content = convert.ToString(itemCfg.GetMutationSellPrice(itemId, mutStr))
            } else {
                priceObj<UIWidgetLabel>.Content = convert.ToString(itemCfg.GetBuyPrice(itemId))
            }
        }

        var preWeightObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2/pre_weight")
        if preWeightObj != nil { preWeightObj<UIWidgetLabel>.Content = "Amount:" }

        var weightObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2/weight")
        if weightObj != nil { weightObj<UIWidgetLabel>.Content = convert.ToString(amount) }

        var introObj = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector/selection_info/type2/introduce")
        if introObj != nil { introObj<UIWidgetLabel>.Content = itemCfg.GetItemDescription(itemId) }
    }

    func _HideInspector() {
        _SelectedSlotIndex = -1
        var inspectorBg = GetWidgetByPath(thisEntity<Player>, _BackpackUI, "/root/bg_inspector")
        if inspectorBg != nil { inspectorBg<UIWidget>.IsVisible = false }
    }
}